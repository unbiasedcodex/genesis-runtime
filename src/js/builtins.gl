fn register_errors(interp: &mut Interpreter) {
    // Error
    let error_constructor = interp.create_native_function("Error", |_interp, _this, args| {
        let message = args.get(0).map(|v| v.to_string()).unwrap_or_default();
        let mut obj = JsObject::new();
        obj.internal = ObjectInternal::Error {
            message: message.clone(),
            name: "Error".to_string(),
        };
        obj.set("message".to_string(), JsValue::String(message));
        obj.set("name".to_string(), JsValue::String("Error".to_string()));
        Ok(JsValue::Object(Rc::new(RefCell::new(obj))))
    });
    interp.define_global("Error", error_constructor);

    // TypeError
