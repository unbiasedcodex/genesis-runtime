        Ok(JsValue::Object(Rc::new(RefCell::new(obj))))
    });
    interp.define_global("ReferenceError", reference_error_constructor);

    // SyntaxError
    let syntax_error_constructor = interp.create_native_function("SyntaxError", |_interp, _this, args| {
        let message = args.get(0).map(|v| v.to_string()).unwrap_or_default();
        let mut obj = JsObject::new();
        obj.internal = ObjectInternal::Error {
            message: message.clone(),
            name: "SyntaxError".to_string(),
        };
        obj.set("message".to_string(), JsValue::String(message));
        obj.set("name".to_string(), JsValue::String("SyntaxError".to_string()));
        Ok(JsValue::Object(Rc::new(RefCell::new(obj))))
    });
    interp.define_global("SyntaxError", syntax_error_constructor);

    // RangeError
    let range_error_constructor = interp.create_native_function("RangeError", |_interp, _this, args| {
        let message = args.get(0).map(|v| v.to_string()).unwrap_or_default();
        let mut obj = JsObject::new();
        obj.internal = ObjectInternal::Error {
            message: message.clone(),
            name: "RangeError".to_string(),
        };
        obj.set("message".to_string(), JsValue::String(message));
        obj.set("name".to_string(), JsValue::String("RangeError".to_string()));
        Ok(JsValue::Object(Rc::new(RefCell::new(obj))))
    });
    interp.define_global("RangeError", range_error_constructor);
}

// ============================================================
// Promise Constructor
// ============================================================

fn register_promise(interp: &mut Interpreter) {
    let mut promise_constructor = JsObject::new();

    // Promise.resolve
    promise_constructor.set("resolve".to_string(), interp.create_native_function("resolve", |_interp, _this, args| {
        let value = args.get(0).cloned().unwrap_or(JsValue::Undefined);
        let mut obj = JsObject::new();
        obj.internal = ObjectInternal::Promise {
            state: super::interpreter::PromiseState::Fulfilled,
            result: Some(value),
        };
        Ok(JsValue::Object(Rc::new(RefCell::new(obj))))
    }));

    // Promise.reject
    promise_constructor.set("reject".to_string(), interp.create_native_function("reject", |_interp, _this, args| {
        let reason = args.get(0).cloned().unwrap_or(JsValue::Undefined);
        let mut obj = JsObject::new();
        obj.internal = ObjectInternal::Promise {
            state: super::interpreter::PromiseState::Rejected,
            result: Some(reason),
        };
        Ok(JsValue::Object(Rc::new(RefCell::new(obj))))
    }));

    // Promise.all
    promise_constructor.set("all".to_string(), interp.create_native_function("all", |_interp, _this, args| {
        // Simplified - synchronous execution
        let iterable = args.get(0).cloned().unwrap_or(JsValue::Undefined);
        if let JsValue::Array(arr_ref) = iterable {
            let results: Vec<JsValue> = arr_ref.borrow().clone();
            Ok(JsValue::Array(Rc::new(RefCell::new(results))))
        } else {
            Ok(JsValue::Array(Rc::new(RefCell::new(Vec::new()))))
        }
    }));

    // Promise.race
    promise_constructor.set("race".to_string(), interp.create_native_function("race", |_interp, _this, args| {
        let iterable = args.get(0).cloned().unwrap_or(JsValue::Undefined);
        if let JsValue::Array(arr_ref) = iterable {
            let arr = arr_ref.borrow();
            if let Some(first) = arr.first() {
                return Ok(first.clone());
            }
        }
        Ok(JsValue::Undefined)
    }));

    interp.define_global("Promise", JsValue::Object(Rc::new(RefCell::new(promise_constructor))));
}

// ============================================================
// Map and Set
// ============================================================

fn register_map_set(interp: &mut Interpreter) {
    // Map constructor
    let map_constructor = interp.create_native_function("Map", |_interp, _this, args| {
        let mut obj = JsObject::new();
        obj.internal = ObjectInternal::Map { entries: Vec::new() };

        // Initialize from iterable if provided
        if let Some(JsValue::Array(arr_ref)) = args.get(0) {
            let entries: Vec<(JsValue, JsValue)> = arr_ref.borrow().iter()
                .filter_map(|entry| {
                    if let JsValue::Array(pair) = entry {
                        let pair = pair.borrow();
                        if pair.len() >= 2 {
                            return Some((pair[0].clone(), pair[1].clone()));
                        }
                    }
                    None
                })
                .collect();
            obj.internal = ObjectInternal::Map { entries };
        }

        Ok(JsValue::Object(Rc::new(RefCell::new(obj))))
    });
    interp.define_global("Map", map_constructor);

    // Set constructor
    let set_constructor = interp.create_native_function("Set", |_interp, _this, args| {
        let mut obj = JsObject::new();
        obj.internal = ObjectInternal::Set { values: Vec::new() };

        // Initialize from iterable if provided
        if let Some(JsValue::Array(arr_ref)) = args.get(0) {
            let values: Vec<JsValue> = arr_ref.borrow().clone();
            obj.internal = ObjectInternal::Set { values };
        }

        Ok(JsValue::Object(Rc::new(RefCell::new(obj))))
    });
    interp.define_global("Set", set_constructor);
}

// ============================================================
// Array Prototype Methods
// ============================================================

pub fn get_array_method(interp: &Interpreter, method: &str) -> Option<JsValue> {
    match method {
        "push" => Some(interp.create_native_function("push", |_interp, this, args| {
            if let JsValue::Array(arr_ref) = this {
                let mut arr = arr_ref.borrow_mut();
                for arg in args {
                    arr.push(arg);
                }
                Ok(JsValue::Number(arr.len() as f64))
            } else {
                Err(JsError::type_error("push called on non-array"))
            }
        })),

        "pop" => Some(interp.create_native_function("pop", |_interp, this, _args| {
            if let JsValue::Array(arr_ref) = this {
                Ok(arr_ref.borrow_mut().pop().unwrap_or(JsValue::Undefined))
            } else {
                Err(JsError::type_error("pop called on non-array"))
            }
        })),

        "shift" => Some(interp.create_native_function("shift", |_interp, this, _args| {
            if let JsValue::Array(arr_ref) = this {
                let mut arr = arr_ref.borrow_mut();
                if arr.is_empty() {
                    Ok(JsValue::Undefined)
                } else {
                    Ok(arr.remove(0))
                }
            } else {
                Err(JsError::type_error("shift called on non-array"))
            }
        })),

        "unshift" => Some(interp.create_native_function("unshift", |_interp, this, args| {
            if let JsValue::Array(arr_ref) = this {
                let mut arr = arr_ref.borrow_mut();
                for (i, arg) in args.into_iter().enumerate() {
                    arr.insert(i, arg);
                }
                Ok(JsValue::Number(arr.len() as f64))
            } else {
                Err(JsError::type_error("unshift called on non-array"))
            }
        })),

        "indexOf" => Some(interp.create_native_function("indexOf", |_interp, this, args| {
            if let JsValue::Array(arr_ref) = this {
                let search = args.get(0).cloned().unwrap_or(JsValue::Undefined);
                let arr = arr_ref.borrow();
                for (i, item) in arr.iter().enumerate() {
                    if item.strict_equals(&search) {
                        return Ok(JsValue::Number(i as f64));
                    }
                }
                Ok(JsValue::Number(-1.0))
            } else {
                Err(JsError::type_error("indexOf called on non-array"))
            }
        })),

        "includes" => Some(interp.create_native_function("includes", |_interp, this, args| {
            if let JsValue::Array(arr_ref) = this {
                let search = args.get(0).cloned().unwrap_or(JsValue::Undefined);
                let arr = arr_ref.borrow();
                Ok(JsValue::Boolean(arr.iter().any(|item| item.strict_equals(&search))))
            } else {
                Err(JsError::type_error("includes called on non-array"))
            }
        })),

        "join" => Some(interp.create_native_function("join", |_interp, this, args| {
            if let JsValue::Array(arr_ref) = this {
                let separator = args.get(0).map(|v| v.to_string()).unwrap_or(",".to_string());
                let arr = arr_ref.borrow();
                let result: Vec<String> = arr.iter().map(|v| v.to_string()).collect();
                Ok(JsValue::String(result.join(&separator)))
            } else {
                Err(JsError::type_error("join called on non-array"))
            }
        })),

        "slice" => Some(interp.create_native_function("slice", |_interp, this, args| {
            if let JsValue::Array(arr_ref) = this {
                let arr = arr_ref.borrow();
                let len = arr.len() as i64;

                let start = args.get(0).map(|v| v.to_number() as i64).unwrap_or(0);
                let start = if start < 0 { (len + start).max(0) as usize } else { start.min(len) as usize };

                let end = args.get(1).map(|v| v.to_number() as i64).unwrap_or(len);
                let end = if end < 0 { (len + end).max(0) as usize } else { end.min(len) as usize };

                let slice: Vec<JsValue> = arr[start..end].to_vec();
                Ok(JsValue::Array(Rc::new(RefCell::new(slice))))
            } else {
                Err(JsError::type_error("slice called on non-array"))
            }
        })),

        "concat" => Some(interp.create_native_function("concat", |_interp, this, args| {
            if let JsValue::Array(arr_ref) = this {
                let mut result = arr_ref.borrow().clone();
                for arg in args {
                    if let JsValue::Array(other_ref) = arg {
                        result.extend(other_ref.borrow().iter().cloned());
                    } else {
                        result.push(arg);
                    }
                }
                Ok(JsValue::Array(Rc::new(RefCell::new(result))))
            } else {
                Err(JsError::type_error("concat called on non-array"))
            }
        })),

        "reverse" => Some(interp.create_native_function("reverse", |_interp, this, _args| {
            if let JsValue::Array(arr_ref) = &this {
                arr_ref.borrow_mut().reverse();
                Ok(this)
            } else {
                Err(JsError::type_error("reverse called on non-array"))
            }
        })),

        "fill" => Some(interp.create_native_function("fill", |_interp, this, args| {
            if let JsValue::Array(arr_ref) = &this {
                let value = args.get(0).cloned().unwrap_or(JsValue::Undefined);
                let mut arr = arr_ref.borrow_mut();
                let len = arr.len();

                let start = args.get(1).map(|v| v.to_number() as i64).unwrap_or(0);
                let start = if start < 0 { (len as i64 + start).max(0) as usize } else { start.min(len as i64) as usize };

                let end = args.get(2).map(|v| v.to_number() as i64).unwrap_or(len as i64);
                let end = if end < 0 { (len as i64 + end).max(0) as usize } else { end.min(len as i64) as usize };

                for i in start..end {
                    arr[i] = value.clone();
                }
                Ok(this)
            } else {
                Err(JsError::type_error("fill called on non-array"))
            }
        })),

        _ => None,
    }
}

// ============================================================
// String Prototype Methods
// ============================================================

pub fn get_string_method(interp: &Interpreter, method: &str) -> Option<JsValue> {
    match method {
        "charAt" => Some(interp.create_native_function("charAt", |_interp, this, args| {
            let s = this.to_string();
            let index = args.get(0).map(|v| v.to_number() as usize).unwrap_or(0);
            Ok(s.chars().nth(index)
                .map(|c| JsValue::String(c.to_string()))
                .unwrap_or(JsValue::String(String::new())))
        })),

        "charCodeAt" => Some(interp.create_native_function("charCodeAt", |_interp, this, args| {
            let s = this.to_string();
            let index = args.get(0).map(|v| v.to_number() as usize).unwrap_or(0);
            Ok(s.chars().nth(index)
                .map(|c| JsValue::Number(c as u32 as f64))
                .unwrap_or(JsValue::Number(f64::NAN)))
        })),

        "concat" => Some(interp.create_native_function("concat", |_interp, this, args| {
            let mut s = this.to_string();
            for arg in args {
                s.push_str(&arg.to_string());
            }
            Ok(JsValue::String(s))
        })),

        "includes" => Some(interp.create_native_function("includes", |_interp, this, args| {
            let s = this.to_string();
            let search = args.get(0).map(|v| v.to_string()).unwrap_or_default();
            Ok(JsValue::Boolean(s.contains(&search)))
        })),

        "indexOf" => Some(interp.create_native_function("indexOf", |_interp, this, args| {
            let s = this.to_string();
            let search = args.get(0).map(|v| v.to_string()).unwrap_or_default();
            Ok(s.find(&search)
                .map(|i| JsValue::Number(i as f64))
                .unwrap_or(JsValue::Number(-1.0)))
        })),

        "lastIndexOf" => Some(interp.create_native_function("lastIndexOf", |_interp, this, args| {
            let s = this.to_string();
            let search = args.get(0).map(|v| v.to_string()).unwrap_or_default();
            Ok(s.rfind(&search)
                .map(|i| JsValue::Number(i as f64))
                .unwrap_or(JsValue::Number(-1.0)))
        })),

        "slice" => Some(interp.create_native_function("slice", |_interp, this, args| {
            let s = this.to_string();
            let chars: Vec<char> = s.chars().collect();
            let len = chars.len() as i64;

            let start = args.get(0).map(|v| v.to_number() as i64).unwrap_or(0);
            let start = if start < 0 { (len + start).max(0) as usize } else { start.min(len) as usize };

            let end = args.get(1).map(|v| v.to_number() as i64).unwrap_or(len);
            let end = if end < 0 { (len + end).max(0) as usize } else { end.min(len) as usize };

            let result: String = chars[start..end].iter().collect();
            Ok(JsValue::String(result))
        })),

        "substring" => Some(interp.create_native_function("substring", |_interp, this, args| {
            let s = this.to_string();
            let chars: Vec<char> = s.chars().collect();
            let len = chars.len();

            let mut start = args.get(0).map(|v| v.to_number() as i64).unwrap_or(0);
            let mut end = args.get(1).map(|v| v.to_number() as i64).unwrap_or(len as i64);

            start = start.max(0).min(len as i64);
            end = end.max(0).min(len as i64);

            if start > end {
                std::mem::swap(&mut start, &mut end);
            }

            let result: String = chars[start as usize..end as usize].iter().collect();
            Ok(JsValue::String(result))
        })),

        "toLowerCase" => Some(interp.create_native_function("toLowerCase", |_interp, this, _args| {
            Ok(JsValue::String(this.to_string().to_lowercase()))
        })),

        "toUpperCase" => Some(interp.create_native_function("toUpperCase", |_interp, this, _args| {
            Ok(JsValue::String(this.to_string().to_uppercase()))
        })),

        "trim" => Some(interp.create_native_function("trim", |_interp, this, _args| {
            Ok(JsValue::String(this.to_string().trim().to_string()))
        })),

        "trimStart" | "trimLeft" => Some(interp.create_native_function("trimStart", |_interp, this, _args| {
            Ok(JsValue::String(this.to_string().trim_start().to_string()))
        })),

        "trimEnd" | "trimRight" => Some(interp.create_native_function("trimEnd", |_interp, this, _args| {
            Ok(JsValue::String(this.to_string().trim_end().to_string()))
        })),

        "split" => Some(interp.create_native_function("split", |_interp, this, args| {
            let s = this.to_string();
            let separator = args.get(0).map(|v| v.to_string());
            let limit = args.get(1).map(|v| v.to_number() as usize);

            let parts: Vec<JsValue> = match separator {
                Some(sep) if !sep.is_empty() => {
                    let split: Vec<&str> = if let Some(limit) = limit {
                        s.splitn(limit, &sep).collect()
                    } else {
                        s.split(&sep).collect()
                    };
                    split.into_iter().map(|p| JsValue::String(p.to_string())).collect()
                },
                Some(_) => {
                    // Empty separator - split into characters
                    s.chars().map(|c| JsValue::String(c.to_string())).collect()
                },
                None => vec![JsValue::String(s)],
            };

            Ok(JsValue::Array(Rc::new(RefCell::new(parts))))
        })),

        "replace" => Some(interp.create_native_function("replace", |_interp, this, args| {
            let s = this.to_string();
            let search = args.get(0).map(|v| v.to_string()).unwrap_or_default();
            let replacement = args.get(1).map(|v| v.to_string()).unwrap_or_default();
            Ok(JsValue::String(s.replacen(&search, &replacement, 1)))
        })),

        "replaceAll" => Some(interp.create_native_function("replaceAll", |_interp, this, args| {
            let s = this.to_string();
            let search = args.get(0).map(|v| v.to_string()).unwrap_or_default();
            let replacement = args.get(1).map(|v| v.to_string()).unwrap_or_default();
            Ok(JsValue::String(s.replace(&search, &replacement)))
        })),

        "repeat" => Some(interp.create_native_function("repeat", |_interp, this, args| {
            let s = this.to_string();
            let count = args.get(0).map(|v| v.to_number() as usize).unwrap_or(0);
            Ok(JsValue::String(s.repeat(count)))
        })),

        "startsWith" => Some(interp.create_native_function("startsWith", |_interp, this, args| {
            let s = this.to_string();
            let search = args.get(0).map(|v| v.to_string()).unwrap_or_default();
            Ok(JsValue::Boolean(s.starts_with(&search)))
        })),

        "endsWith" => Some(interp.create_native_function("endsWith", |_interp, this, args| {
            let s = this.to_string();
            let search = args.get(0).map(|v| v.to_string()).unwrap_or_default();
            Ok(JsValue::Boolean(s.ends_with(&search)))
        })),

        "padStart" => Some(interp.create_native_function("padStart", |_interp, this, args| {
            let s = this.to_string();
            let target_len = args.get(0).map(|v| v.to_number() as usize).unwrap_or(0);
            let pad_str = args.get(1).map(|v| v.to_string()).unwrap_or(" ".to_string());

            if s.len() >= target_len || pad_str.is_empty() {
                return Ok(JsValue::String(s));
            }

            let pad_len = target_len - s.len();
            let mut padding = String::new();
            while padding.len() < pad_len {
                padding.push_str(&pad_str);
            }
            padding.truncate(pad_len);

            Ok(JsValue::String(padding + &s))
        })),

        "padEnd" => Some(interp.create_native_function("padEnd", |_interp, this, args| {
            let s = this.to_string();
            let target_len = args.get(0).map(|v| v.to_number() as usize).unwrap_or(0);
            let pad_str = args.get(1).map(|v| v.to_string()).unwrap_or(" ".to_string());

            if s.len() >= target_len || pad_str.is_empty() {
                return Ok(JsValue::String(s));
            }

            let pad_len = target_len - s.len();
            let mut result = s;
            while result.len() < target_len {
                result.push_str(&pad_str);
            }
            result.truncate(target_len);

            Ok(JsValue::String(result))
        })),

        _ => None,
    }
}
