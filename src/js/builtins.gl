fn register_date(interp: &mut Interpreter) {
    let mut date_constructor = JsObject::new();

    // Date.now
    date_constructor.set("now".to_string(), interp.create_native_function("now", |_interp, _this, _args| {
        use std::time::{SystemTime, UNIX_EPOCH};
        let timestamp = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map(|d| d.as_millis() as f64)
            .unwrap_or(0.0);
        Ok(JsValue::Number(timestamp))
    }));

    // Date.parse
    date_constructor.set("parse".to_string(), interp.create_native_function("parse", |_interp, _this, args| {
        // Simplified - would need full date parsing
        let _date_string = args.get(0).map(|v| v.to_string()).unwrap_or_default();
        Ok(JsValue::Number(f64::NAN))
    }));

    // Date.UTC
    date_constructor.set("UTC".to_string(), interp.create_native_function("UTC", |_interp, _this, args| {
        // Simplified
        let _year = args.get(0).map(|v| v.to_number()).unwrap_or(0.0);
        Ok(JsValue::Number(0.0))
    }));

    interp.define_global("Date", JsValue::Object(Rc::new(RefCell::new(date_constructor))));
}

