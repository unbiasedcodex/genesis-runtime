// JavaScript Parser
// Recursive descent parser producing an Abstract Syntax Tree

use super::lexer::{Token, Keyword, Lexer};

// ============================================================
// AST Node Types
// ============================================================

#[derive(Clone, Debug)]
pub enum Expr {
    // Literals
    Literal(Literal),
    Identifier(String),
    This,
    Super,

    // Compound expressions
    Array(Vec<Expr>),
    Object(Vec<Property>),
    Function(FunctionExpr),
    ArrowFunction(ArrowFunction),
    Class(ClassExpr),

    // Operations
    Unary {
        operator: UnaryOp,
        operand: Box<Expr>,
        prefix: bool,
    },
    Binary {
        left: Box<Expr>,
        operator: BinaryOp,
        right: Box<Expr>,
    },
    Logical {
        left: Box<Expr>,
        operator: LogicalOp,
        right: Box<Expr>,
    },
    Assignment {
        target: Box<Expr>,
        operator: AssignOp,
        value: Box<Expr>,
    },
    Conditional {
        test: Box<Expr>,
        consequent: Box<Expr>,
        alternate: Box<Expr>,
    },

    // Member access
    Member {
        object: Box<Expr>,
        property: String,
        computed: bool,
    },
    Index {
        object: Box<Expr>,
        index: Box<Expr>,
    },

    // Calls
    Call {
        callee: Box<Expr>,
        arguments: Vec<Expr>,
    },
    New {
        callee: Box<Expr>,
        arguments: Vec<Expr>,
    },

    // Special
    Sequence(Vec<Expr>),
    Spread(Box<Expr>),
    Yield(Option<Box<Expr>>, bool),  // expr, delegate
    Await(Box<Expr>),
    TemplateLiteral {
        quasis: Vec<String>,
        expressions: Vec<Expr>,
    },
}

#[derive(Clone, Debug)]
pub enum Literal {
    Number(f64),
    String(String),
    Boolean(bool),
    Null,
    Undefined,
    RegExp(String, String),
}

#[derive(Clone, Debug)]
pub struct Property {
    pub key: PropertyKey,
    pub value: Expr,
    pub kind: PropertyKind,
    pub computed: bool,
    pub shorthand: bool,
}

#[derive(Clone, Debug)]
pub enum PropertyKey {
    Identifier(String),
    String(String),
    Number(f64),
    Computed(Box<Expr>),
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum PropertyKind {
    Init,
    Get,
    Set,
    Method,
}

#[derive(Clone, Debug)]
pub struct FunctionExpr {
    pub name: Option<String>,
    pub params: Vec<Pattern>,
    pub body: Vec<Stmt>,
    pub is_async: bool,
    pub is_generator: bool,
}

#[derive(Clone, Debug)]
pub struct ArrowFunction {
    pub params: Vec<Pattern>,
    pub body: ArrowBody,
    pub is_async: bool,
}

#[derive(Clone, Debug)]
pub enum ArrowBody {
    Expr(Box<Expr>),
    Block(Vec<Stmt>),
}

#[derive(Clone, Debug)]
pub struct ClassExpr {
    pub name: Option<String>,
    pub super_class: Option<Box<Expr>>,
    pub body: Vec<ClassMember>,
}

#[derive(Clone, Debug)]
pub struct ClassMember {
    pub kind: ClassMemberKind,
    pub key: PropertyKey,
    pub value: Option<Expr>,
    pub is_static: bool,
    pub computed: bool,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum ClassMemberKind {
    Method,
    Getter,
    Setter,
    Field,
    Constructor,
}

// ============================================================
// Operators
// ============================================================

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum UnaryOp {
    Minus,
    Plus,
    Not,
    BitwiseNot,
    Typeof,
    Void,
    Delete,
    Increment,
    Decrement,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    Pow,
    BitwiseAnd,
    BitwiseOr,
    BitwiseXor,
    LeftShift,
    RightShift,
    UnsignedRightShift,
    Equal,
    NotEqual,
    StrictEqual,
    StrictNotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    Instanceof,
    In,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum LogicalOp {
    And,
    Or,
    NullishCoalescing,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum AssignOp {
    Assign,
    AddAssign,
    SubAssign,
    MulAssign,
    DivAssign,
    ModAssign,
}

// ============================================================
// Patterns (for destructuring)
// ============================================================

#[derive(Clone, Debug)]
pub enum Pattern {
    Identifier(String),
    Array(Vec<Option<ArrayPatternElement>>),
    Object(Vec<ObjectPatternProperty>),
    Assignment {
        pattern: Box<Pattern>,
        default: Expr,
    },
    Rest(Box<Pattern>),
}

#[derive(Clone, Debug)]
pub struct ArrayPatternElement {
    pub pattern: Pattern,
    pub default_value: Option<Expr>,
}

#[derive(Clone, Debug)]
pub struct ObjectPatternProperty {
    pub key: String,
    pub value: Pattern,
    pub computed: bool,
    pub shorthand: bool,
}

// ============================================================
// Statements
// ============================================================

#[derive(Clone, Debug)]
pub enum Stmt {
    // Declarations
    Variable {
        kind: VarKind,
        declarations: Vec<VariableDeclarator>,
    },
    Function(FunctionDecl),
    Class(ClassDecl),

    // Control flow
    If {
        test: Expr,
        consequent: Box<Stmt>,
        alternate: Option<Box<Stmt>>,
    },
    Switch {
        discriminant: Expr,
        cases: Vec<SwitchCase>,
    },
    For {
        init: Option<ForInit>,
        test: Option<Expr>,
        update: Option<Expr>,
        body: Box<Stmt>,
    },
    ForIn {
        left: ForLeft,
        right: Expr,
        body: Box<Stmt>,
    },
    ForOf {
        left: ForLeft,
        right: Expr,
        body: Box<Stmt>,
        is_await: bool,
    },
    While {
        test: Expr,
        body: Box<Stmt>,
    },
    DoWhile {
        body: Box<Stmt>,
        test: Expr,
    },

    // Jumps
    Break(Option<String>),
    Continue(Option<String>),
    Return(Option<Expr>),
    Throw(Expr),

    // Exception handling
    Try {
        block: Vec<Stmt>,
        handler: Option<CatchClause>,
        finalizer: Option<Vec<Stmt>>,
    },

    // Other
    Block(Vec<Stmt>),
    Expression(Expr),
    Labeled {
        label: String,
        body: Box<Stmt>,
    },
    With {
        object: Expr,
        body: Box<Stmt>,
    },
    Debugger,
    Empty,

    // Modules
    Import(ImportDecl),
    Export(ExportDecl),
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum VarKind {
    Var,
    Let,
    Const,
}

#[derive(Clone, Debug)]
pub struct VariableDeclarator {
    pub id: Pattern,
    pub init: Option<Expr>,
}

#[derive(Clone, Debug)]
pub struct FunctionDecl {
    pub name: String,
    pub params: Vec<Pattern>,
    pub body: Vec<Stmt>,
    pub is_async: bool,
    pub is_generator: bool,
}

#[derive(Clone, Debug)]
pub struct ClassDecl {
    pub name: String,
    pub super_class: Option<Expr>,
    pub body: Vec<ClassMember>,
}

#[derive(Clone, Debug)]
pub struct SwitchCase {
    pub test: Option<Expr>,  // None for default
    pub consequent: Vec<Stmt>,
}

#[derive(Clone, Debug)]
pub enum ForInit {
    Variable(VarKind, Vec<VariableDeclarator>),
    Expression(Expr),
}

#[derive(Clone, Debug)]
pub enum ForLeft {
    Variable(VarKind, Pattern),
    Pattern(Pattern),
}

#[derive(Clone, Debug)]
pub struct CatchClause {
    pub param: Option<Pattern>,
    pub body: Vec<Stmt>,
}

#[derive(Clone, Debug)]
pub struct ImportDecl {
    pub specifiers: Vec<ImportSpecifier>,
    pub source: String,
}

#[derive(Clone, Debug)]
pub enum ImportSpecifier {
    Default(String),
    Named { imported: String, local: String },
    Namespace(String),
}

#[derive(Clone, Debug)]
pub enum ExportDecl {
    Named(Vec<ExportSpecifier>, Option<String>),  // specifiers, source
    Default(Expr),
    All(String),  // source
    Declaration(Box<Stmt>),
}

#[derive(Clone, Debug)]
pub struct ExportSpecifier {
    pub local: String,
    pub exported: String,
}

// ============================================================
// Program
// ============================================================

#[derive(Clone, Debug)]
pub struct Program {
    pub body: Vec<Stmt>,
    pub source_type: SourceType,
}

#[derive(Clone, Copy, Debug, PartialEq)]
pub enum SourceType {
    Script,
    Module,
}

// ============================================================
// Parser
// ============================================================

pub struct Parser {
    lexer: Lexer,
    current: Token,
    previous: Token,
    source_type: SourceType,
}

impl Parser {
    pub fn new(source: &str) -> Parser {
        let mut lexer = Lexer::new(source);
        let current = lexer.next_token();
        Parser {
            lexer,
            current,
            previous: Token::EOF,
            source_type: SourceType::Script,
        }
    }

    pub fn parse(&mut self) -> Result<Program, ParseError> {
        self.parse_program()
    }

    pub fn parse_program(&mut self) -> Result<Program, ParseError> {
        let mut body = Vec::new();

        while !self.is_eof() {
            body.push(self.parse_statement()?);
        }

        // Detect module if we see import/export
        let source_type = self.source_type;

        Ok(Program { body, source_type })
    }

    // --------------------------------------------------------
    // Token handling
    // --------------------------------------------------------

    fn advance(&mut self) {
        self.previous = self.current.clone();
        self.current = self.lexer.next_token();
    }

    fn is_eof(&self) -> bool {
        matches!(self.current, Token::EOF)
    }

    fn check(&self, token: &Token) -> bool {
        std::mem::discriminant(&self.current) == std::mem::discriminant(token)
    }

    fn check_keyword(&self, kw: Keyword) -> bool {
        matches!(&self.current, Token::Keyword(k) if *k == kw)
    }

    fn consume(&mut self, expected: Token) -> Result<(), ParseError> {
        if self.check(&expected) {
            self.advance();
            Ok(())
        } else {
            Err(ParseError::UnexpectedToken(format!("{:?}", self.current)))
        }
    }

    fn consume_keyword(&mut self, kw: Keyword) -> Result<(), ParseError> {
        if self.check_keyword(kw) {
            self.advance();
            Ok(())
        } else {
            Err(ParseError::ExpectedKeyword(kw))
        }
    }

    fn consume_identifier(&mut self) -> Result<String, ParseError> {
        if let Token::Identifier(name) = &self.current {
            let name = name.clone();
            self.advance();
            Ok(name)
        } else {
            Err(ParseError::ExpectedIdentifier)
        }
    }

    fn consume_semicolon(&mut self) {
        // JavaScript ASI (Automatic Semicolon Insertion)
        if self.check(&Token::Semicolon) {
            self.advance();
        }
        // Implicit semicolon at line boundary, }, or EOF is acceptable
    }

    // --------------------------------------------------------
    // Statement parsing
    // --------------------------------------------------------

    fn parse_statement(&mut self) -> Result<Stmt, ParseError> {
        match &self.current {
            Token::Keyword(Keyword::Var) => self.parse_variable_declaration(VarKind::Var),
            Token::Keyword(Keyword::Let) => self.parse_variable_declaration(VarKind::Let),
            Token::Keyword(Keyword::Const) => self.parse_variable_declaration(VarKind::Const),
            Token::Keyword(Keyword::Function) => self.parse_function_declaration(),
            Token::Keyword(Keyword::Class) => self.parse_class_declaration(),
            Token::Keyword(Keyword::If) => self.parse_if_statement(),
            Token::Keyword(Keyword::Switch) => self.parse_switch_statement(),
            Token::Keyword(Keyword::For) => self.parse_for_statement(),
            Token::Keyword(Keyword::While) => self.parse_while_statement(),
            Token::Keyword(Keyword::Do) => self.parse_do_while_statement(),
            Token::Keyword(Keyword::Break) => self.parse_break_statement(),
            Token::Keyword(Keyword::Continue) => self.parse_continue_statement(),
            Token::Keyword(Keyword::Return) => self.parse_return_statement(),
            Token::Keyword(Keyword::Throw) => self.parse_throw_statement(),
            Token::Keyword(Keyword::Try) => self.parse_try_statement(),
            Token::Keyword(Keyword::With) => self.parse_with_statement(),
            Token::Keyword(Keyword::Debugger) => {
                self.advance();
                self.consume_semicolon();
                Ok(Stmt::Debugger)
            },
            Token::Keyword(Keyword::Import) => {
                self.source_type = SourceType::Module;
                self.parse_import_declaration()
            },
            Token::Keyword(Keyword::Export) => {
                self.source_type = SourceType::Module;
                self.parse_export_declaration()
            },
            Token::LeftBrace => self.parse_block_statement(),
            Token::Semicolon => {
                self.advance();
                Ok(Stmt::Empty)
            },
            _ => {
                // Check for labeled statement
                if let Token::Identifier(_) = &self.current {
                    // Look ahead for colon
                    // For simplicity, we'll parse as expression
                }
                self.parse_expression_statement()
            }
        }
    }

    fn parse_block_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume(Token::LeftBrace)?;
        let body = self.parse_block_body()?;
        self.consume(Token::RightBrace)?;
        Ok(Stmt::Block(body))
    }

    fn parse_block_body(&mut self) -> Result<Vec<Stmt>, ParseError> {
        let mut body = Vec::new();
        while !self.check(&Token::RightBrace) && !self.is_eof() {
            body.push(self.parse_statement()?);
        }
        Ok(body)
    }

    fn parse_variable_declaration(&mut self, kind: VarKind) -> Result<Stmt, ParseError> {
        self.advance(); // var/let/const

        let mut declarations = Vec::new();

        loop {
            let id = self.parse_pattern()?;

            let init = if self.check(&Token::Equals) {
                self.advance();
                Some(self.parse_assignment_expression()?)
            } else {
                None
            };

            declarations.push(VariableDeclarator { id, init });

            if !self.check(&Token::Comma) {
                break;
            }
            self.advance();
        }

        self.consume_semicolon();
        Ok(Stmt::Variable { kind, declarations })
    }

    fn parse_function_declaration(&mut self) -> Result<Stmt, ParseError> {
        let is_async = self.check_keyword(Keyword::Async);
        if is_async {
            self.advance();
        }

        self.consume_keyword(Keyword::Function)?;

        let is_generator = self.check(&Token::Star);
        if is_generator {
            self.advance();
        }

        let name = self.consume_identifier()?;
        let params = self.parse_function_params()?;
        let body = self.parse_function_body()?;

        Ok(Stmt::Function(FunctionDecl {
            name,
            params,
            body,
            is_async,
            is_generator,
        }))
    }

    fn parse_function_params(&mut self) -> Result<Vec<Pattern>, ParseError> {
        self.consume(Token::LeftParen)?;

        let mut params = Vec::new();

        while !self.check(&Token::RightParen) {
            if self.check(&Token::DotDotDot) {
                self.advance();
                let rest = self.parse_pattern()?;
                params.push(Pattern::Rest(Box::new(rest)));
                break;
            }

            params.push(self.parse_pattern()?);

            // Default value
            if self.check(&Token::Equals) {
                self.advance();
                let default = self.parse_assignment_expression()?;
                if let Some(last) = params.pop() {
                    params.push(Pattern::Assignment {
                        pattern: Box::new(last),
                        default,
                    });
                }
            }

            if !self.check(&Token::Comma) {
                break;
            }
            self.advance();
        }

        self.consume(Token::RightParen)?;
        Ok(params)
    }

    fn parse_function_body(&mut self) -> Result<Vec<Stmt>, ParseError> {
        self.consume(Token::LeftBrace)?;
        let body = self.parse_block_body()?;
        self.consume(Token::RightBrace)?;
        Ok(body)
    }

    fn parse_class_declaration(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Class)?;
        let name = self.consume_identifier()?;

        let super_class = if self.check_keyword(Keyword::Extends) {
            self.advance();
            Some(self.parse_left_hand_side_expression()?)
        } else {
            None
        };

        let body = self.parse_class_body()?;

        Ok(Stmt::Class(ClassDecl { name, super_class, body }))
    }

    fn parse_class_body(&mut self) -> Result<Vec<ClassMember>, ParseError> {
        self.consume(Token::LeftBrace)?;

        let mut members = Vec::new();

        while !self.check(&Token::RightBrace) && !self.is_eof() {
            if self.check(&Token::Semicolon) {
                self.advance();
                continue;
            }

            let is_static = self.check_keyword(Keyword::Static);
            if is_static {
                self.advance();
            }

            let kind = if self.check_keyword(Keyword::Get) {
                self.advance();
                ClassMemberKind::Getter
            } else if self.check_keyword(Keyword::Set) {
                self.advance();
                ClassMemberKind::Setter
            } else {
                ClassMemberKind::Method
            };

            let computed = self.check(&Token::LeftBracket);
            let key = self.parse_property_key()?;

            // Check if it's a constructor
            let kind = if let PropertyKey::Identifier(ref name) = key {
                if name == "constructor" {
                    ClassMemberKind::Constructor
                } else {
                    kind
                }
            } else {
                kind
            };

            // Check for field vs method
            let value = if self.check(&Token::LeftParen) {
                let params = self.parse_function_params()?;
                let body = self.parse_function_body()?;
                Some(Expr::Function(FunctionExpr {
                    name: None,
                    params,
                    body,
                    is_async: false,
                    is_generator: false,
                }))
            } else if self.check(&Token::Equals) {
                self.advance();
                let value = self.parse_assignment_expression()?;
                self.consume_semicolon();
                Some(value)
            } else {
                self.consume_semicolon();
                None
            };

            members.push(ClassMember {
                kind,
                key,
                value,
                is_static,
                computed,
            });
        }

        self.consume(Token::RightBrace)?;
        Ok(members)
    }

    fn parse_if_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::If)?;
        self.consume(Token::LeftParen)?;
        let test = self.parse_expression()?;
        self.consume(Token::RightParen)?;

        let consequent = Box::new(self.parse_statement()?);

        let alternate = if self.check_keyword(Keyword::Else) {
            self.advance();
            Some(Box::new(self.parse_statement()?))
        } else {
            None
        };

        Ok(Stmt::If { test, consequent, alternate })
    }

    fn parse_switch_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Switch)?;
        self.consume(Token::LeftParen)?;
        let discriminant = self.parse_expression()?;
        self.consume(Token::RightParen)?;

        self.consume(Token::LeftBrace)?;

        let mut cases = Vec::new();

        while !self.check(&Token::RightBrace) && !self.is_eof() {
            let test = if self.check_keyword(Keyword::Case) {
                self.advance();
                Some(self.parse_expression()?)
            } else if self.check_keyword(Keyword::Default) {
                self.advance();
                None
            } else {
                break;
            };

            self.consume(Token::Colon)?;

            let mut consequent = Vec::new();
            while !self.check_keyword(Keyword::Case) &&
                  !self.check_keyword(Keyword::Default) &&
                  !self.check(&Token::RightBrace) &&
                  !self.is_eof() {
                consequent.push(self.parse_statement()?);
            }

            cases.push(SwitchCase { test, consequent });
        }

        self.consume(Token::RightBrace)?;

        Ok(Stmt::Switch { discriminant, cases })
    }

    fn parse_for_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::For)?;

        let is_await = self.check_keyword(Keyword::Await);
        if is_await {
            self.advance();
        }

        self.consume(Token::LeftParen)?;

        // Check for for-in/for-of
        let init = if self.check(&Token::Semicolon) {
            None
        } else if self.check_keyword(Keyword::Var) ||
                  self.check_keyword(Keyword::Let) ||
                  self.check_keyword(Keyword::Const) {
            let kind = match &self.current {
                Token::Keyword(Keyword::Var) => VarKind::Var,
                Token::Keyword(Keyword::Let) => VarKind::Let,
                Token::Keyword(Keyword::Const) => VarKind::Const,
                _ => unreachable!(),
            };
            self.advance();

            let pattern = self.parse_pattern()?;

            // Check for for-in/for-of
            if self.check_keyword(Keyword::In) {
                self.advance();
                let right = self.parse_expression()?;
                self.consume(Token::RightParen)?;
                let body = Box::new(self.parse_statement()?);
                return Ok(Stmt::ForIn {
                    left: ForLeft::Variable(kind, pattern),
                    right,
                    body,
                });
            }

            if self.check_keyword(Keyword::Of) {
                self.advance();
                let right = self.parse_assignment_expression()?;
                self.consume(Token::RightParen)?;
                let body = Box::new(self.parse_statement()?);
                return Ok(Stmt::ForOf {
                    left: ForLeft::Variable(kind, pattern),
                    right,
                    body,
                    is_await,
                });
            }

            // Regular for loop with variable declaration
            let init_value = if self.check(&Token::Equals) {
                self.advance();
                Some(self.parse_assignment_expression()?)
            } else {
                None
            };

            let mut declarations = vec![VariableDeclarator { id: pattern, init: init_value }];

            while self.check(&Token::Comma) {
                self.advance();
                let id = self.parse_pattern()?;
                let init = if self.check(&Token::Equals) {
                    self.advance();
                    Some(self.parse_assignment_expression()?)
                } else {
                    None
                };
                declarations.push(VariableDeclarator { id, init });
            }

            Some(ForInit::Variable(kind, declarations))
        } else {
            let expr = self.parse_expression()?;

            // Check for for-in/for-of
            if self.check_keyword(Keyword::In) {
                self.advance();
                let right = self.parse_expression()?;
                self.consume(Token::RightParen)?;
                let body = Box::new(self.parse_statement()?);
                let left = expr_to_pattern(expr)?;
                return Ok(Stmt::ForIn {
                    left: ForLeft::Pattern(left),
                    right,
                    body,
                });
            }

            if self.check_keyword(Keyword::Of) {
                self.advance();
                let right = self.parse_assignment_expression()?;
                self.consume(Token::RightParen)?;
                let body = Box::new(self.parse_statement()?);
                let left = expr_to_pattern(expr)?;
                return Ok(Stmt::ForOf {
                    left: ForLeft::Pattern(left),
                    right,
                    body,
                    is_await,
                });
            }

            Some(ForInit::Expression(expr))
        };

        self.consume(Token::Semicolon)?;

        let test = if self.check(&Token::Semicolon) {
            None
        } else {
            Some(self.parse_expression()?)
        };

        self.consume(Token::Semicolon)?;

        let update = if self.check(&Token::RightParen) {
            None
        } else {
            Some(self.parse_expression()?)
        };

        self.consume(Token::RightParen)?;
        let body = Box::new(self.parse_statement()?);

        Ok(Stmt::For { init, test, update, body })
    }

    fn parse_while_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::While)?;
        self.consume(Token::LeftParen)?;
        let test = self.parse_expression()?;
        self.consume(Token::RightParen)?;
        let body = Box::new(self.parse_statement()?);
        Ok(Stmt::While { test, body })
    }

    fn parse_do_while_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Do)?;
        let body = Box::new(self.parse_statement()?);
        self.consume_keyword(Keyword::While)?;
        self.consume(Token::LeftParen)?;
        let test = self.parse_expression()?;
        self.consume(Token::RightParen)?;
        self.consume_semicolon();
        Ok(Stmt::DoWhile { body, test })
    }

    fn parse_break_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Break)?;
        let label = if let Token::Identifier(name) = &self.current {
            let name = name.clone();
            self.advance();
            Some(name)
        } else {
            None
        };
        self.consume_semicolon();
        Ok(Stmt::Break(label))
    }

    fn parse_continue_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Continue)?;
        let label = if let Token::Identifier(name) = &self.current {
            let name = name.clone();
            self.advance();
            Some(name)
        } else {
            None
        };
        self.consume_semicolon();
        Ok(Stmt::Continue(label))
    }

    fn parse_return_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Return)?;

        // Check for empty return
        let argument = if self.check(&Token::Semicolon) ||
                         self.check(&Token::RightBrace) ||
                         self.is_eof() {
            None
        } else {
            Some(self.parse_expression()?)
        };

        self.consume_semicolon();
        Ok(Stmt::Return(argument))
    }

    fn parse_throw_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Throw)?;
        let argument = self.parse_expression()?;
        self.consume_semicolon();
        Ok(Stmt::Throw(argument))
    }

    fn parse_try_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Try)?;
        self.consume(Token::LeftBrace)?;
        let block = self.parse_block_body()?;
        self.consume(Token::RightBrace)?;

        let handler = if self.check_keyword(Keyword::Catch) {
            self.advance();

            let param = if self.check(&Token::LeftParen) {
                self.consume(Token::LeftParen)?;
                let p = self.parse_pattern()?;
                self.consume(Token::RightParen)?;
                Some(p)
            } else {
                None
            };

            self.consume(Token::LeftBrace)?;
            let body = self.parse_block_body()?;
            self.consume(Token::RightBrace)?;

            Some(CatchClause { param, body })
        } else {
            None
        };

        let finalizer = if self.check_keyword(Keyword::Finally) {
            self.advance();
            self.consume(Token::LeftBrace)?;
            let body = self.parse_block_body()?;
            self.consume(Token::RightBrace)?;
            Some(body)
        } else {
            None
        };

        Ok(Stmt::Try { block, handler, finalizer })
    }

    fn parse_with_statement(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::With)?;
        self.consume(Token::LeftParen)?;
        let object = self.parse_expression()?;
        self.consume(Token::RightParen)?;
        let body = Box::new(self.parse_statement()?);
        Ok(Stmt::With { object, body })
    }

    fn parse_import_declaration(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Import)?;

        let mut specifiers = Vec::new();

        // Check for side-effect import
        if let Token::String(source) = &self.current {
            let source = source.clone();
            self.advance();
            self.consume_semicolon();
            return Ok(Stmt::Import(ImportDecl { specifiers, source }));
        }

        // Default import
        if let Token::Identifier(name) = &self.current {
            let name = name.clone();
            self.advance();
            specifiers.push(ImportSpecifier::Default(name));

            if self.check(&Token::Comma) {
                self.advance();
            }
        }

        // Namespace or named imports
        if self.check(&Token::Star) {
            self.advance();
            self.consume_keyword(Keyword::As)?;
            let name = self.consume_identifier()?;
            specifiers.push(ImportSpecifier::Namespace(name));
        } else if self.check(&Token::LeftBrace) {
            self.advance();

            while !self.check(&Token::RightBrace) {
                let imported = self.consume_identifier()?;
                let local = if self.check_keyword(Keyword::As) {
                    self.advance();
                    self.consume_identifier()?
                } else {
                    imported.clone()
                };
                specifiers.push(ImportSpecifier::Named { imported, local });

                if !self.check(&Token::Comma) {
                    break;
                }
                self.advance();
            }

            self.consume(Token::RightBrace)?;
        }

        self.consume_keyword(Keyword::From)?;

        let source = if let Token::String(s) = &self.current {
            let s = s.clone();
            self.advance();
            s
        } else {
            return Err(ParseError::ExpectedString);
        };

        self.consume_semicolon();
        Ok(Stmt::Import(ImportDecl { specifiers, source }))
    }

    fn parse_export_declaration(&mut self) -> Result<Stmt, ParseError> {
        self.consume_keyword(Keyword::Export)?;

        // export default
        if self.check_keyword(Keyword::Default) {
            self.advance();
            let expr = self.parse_assignment_expression()?;
            self.consume_semicolon();
            return Ok(Stmt::Export(ExportDecl::Default(expr)));
        }

        // export *
        if self.check(&Token::Star) {
            self.advance();
            self.consume_keyword(Keyword::From)?;
            let source = if let Token::String(s) = &self.current {
                let s = s.clone();
                self.advance();
                s
            } else {
                return Err(ParseError::ExpectedString);
            };
            self.consume_semicolon();
            return Ok(Stmt::Export(ExportDecl::All(source)));
        }

        // export { }
        if self.check(&Token::LeftBrace) {
            self.advance();

            let mut specifiers = Vec::new();

            while !self.check(&Token::RightBrace) {
                let local = self.consume_identifier()?;
                let exported = if self.check_keyword(Keyword::As) {
                    self.advance();
                    self.consume_identifier()?
                } else {
                    local.clone()
                };
                specifiers.push(ExportSpecifier { local, exported });

                if !self.check(&Token::Comma) {
                    break;
                }
                self.advance();
            }

            self.consume(Token::RightBrace)?;

            let source = if self.check_keyword(Keyword::From) {
                self.advance();
                if let Token::String(s) = &self.current {
                    let s = s.clone();
                    self.advance();
                    Some(s)
                } else {
                    return Err(ParseError::ExpectedString);
                }
            } else {
                None
            };

            self.consume_semicolon();
            return Ok(Stmt::Export(ExportDecl::Named(specifiers, source)));
        }

        // export declaration
        let decl = self.parse_statement()?;
        Ok(Stmt::Export(ExportDecl::Declaration(Box::new(decl))))
    }

    fn parse_expression_statement(&mut self) -> Result<Stmt, ParseError> {
        let expr = self.parse_expression()?;
        self.consume_semicolon();
        Ok(Stmt::Expression(expr))
    }

    // --------------------------------------------------------
    // Expression parsing
    // --------------------------------------------------------

    fn parse_expression(&mut self) -> Result<Expr, ParseError> {
        let expr = self.parse_assignment_expression()?;

        if self.check(&Token::Comma) {
            let mut exprs = vec![expr];
            while self.check(&Token::Comma) {
                self.advance();
                exprs.push(self.parse_assignment_expression()?);
            }
            return Ok(Expr::Sequence(exprs));
        }

        Ok(expr)
    }

    fn parse_assignment_expression(&mut self) -> Result<Expr, ParseError> {
        let expr = self.parse_conditional_expression()?;

        if let Some(op) = self.assignment_operator() {
            self.advance();
            let value = self.parse_assignment_expression()?;
            return Ok(Expr::Assignment {
                target: Box::new(expr),
                operator: op,
                value: Box::new(value),
            });
        }

        Ok(expr)
    }

    fn assignment_operator(&self) -> Option<AssignOp> {
        match &self.current {
            Token::Equals => Some(AssignOp::Assign),
            Token::PlusEquals => Some(AssignOp::AddAssign),
            Token::MinusEquals => Some(AssignOp::SubAssign),
            Token::StarEquals => Some(AssignOp::MulAssign),
            Token::SlashEquals => Some(AssignOp::DivAssign),
            Token::PercentEquals => Some(AssignOp::ModAssign),
            _ => None,
        }
    }

    fn parse_conditional_expression(&mut self) -> Result<Expr, ParseError> {
        let test = self.parse_logical_or_expression()?;

        if self.check(&Token::Question) {
            self.advance();
            let consequent = self.parse_assignment_expression()?;
            self.consume(Token::Colon)?;
            let alternate = self.parse_assignment_expression()?;
            return Ok(Expr::Conditional {
                test: Box::new(test),
                consequent: Box::new(consequent),
                alternate: Box::new(alternate),
            });
        }

        Ok(test)
    }

    fn parse_logical_or_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_logical_and_expression()?;

        while self.check(&Token::PipePipe) || self.check(&Token::QuestionQuestion) {
            let op = if self.check(&Token::PipePipe) {
                LogicalOp::Or
            } else {
                LogicalOp::NullishCoalescing
            };
            self.advance();
            let right = self.parse_logical_and_expression()?;
            left = Expr::Logical {
                left: Box::new(left),
                operator: op,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_logical_and_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_bitwise_or_expression()?;

        while self.check(&Token::AmpAmp) {
            self.advance();
            let right = self.parse_bitwise_or_expression()?;
            left = Expr::Logical {
                left: Box::new(left),
                operator: LogicalOp::And,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_bitwise_or_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_bitwise_xor_expression()?;

        while self.check(&Token::Pipe) {
            self.advance();
            let right = self.parse_bitwise_xor_expression()?;
            left = Expr::Binary {
                left: Box::new(left),
                operator: BinaryOp::BitwiseOr,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_bitwise_xor_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_bitwise_and_expression()?;

        while self.check(&Token::Caret) {
            self.advance();
            let right = self.parse_bitwise_and_expression()?;
            left = Expr::Binary {
                left: Box::new(left),
                operator: BinaryOp::BitwiseXor,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_bitwise_and_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_equality_expression()?;

        while self.check(&Token::Amp) {
            self.advance();
            let right = self.parse_equality_expression()?;
            left = Expr::Binary {
                left: Box::new(left),
                operator: BinaryOp::BitwiseAnd,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_equality_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_relational_expression()?;

        loop {
            let op = match &self.current {
                Token::EqualsEquals => BinaryOp::Equal,
                Token::BangEquals => BinaryOp::NotEqual,
                Token::EqualsEqualsEquals => BinaryOp::StrictEqual,
                Token::BangEqualsEquals => BinaryOp::StrictNotEqual,
                _ => break,
            };
            self.advance();
            let right = self.parse_relational_expression()?;
            left = Expr::Binary {
                left: Box::new(left),
                operator: op,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_relational_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_shift_expression()?;

        loop {
            let op = match &self.current {
                Token::Less => BinaryOp::Less,
                Token::LessEquals => BinaryOp::LessEqual,
                Token::Greater => BinaryOp::Greater,
                Token::GreaterEquals => BinaryOp::GreaterEqual,
                Token::Keyword(Keyword::Instanceof) => BinaryOp::Instanceof,
                Token::Keyword(Keyword::In) => BinaryOp::In,
                _ => break,
            };
            self.advance();
            let right = self.parse_shift_expression()?;
            left = Expr::Binary {
                left: Box::new(left),
                operator: op,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_shift_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_additive_expression()?;

        loop {
            let op = match &self.current {
                Token::LessLess => BinaryOp::LeftShift,
                Token::GreaterGreater => BinaryOp::RightShift,
                Token::GreaterGreaterGreater => BinaryOp::UnsignedRightShift,
                _ => break,
            };
            self.advance();
            let right = self.parse_additive_expression()?;
            left = Expr::Binary {
                left: Box::new(left),
                operator: op,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_additive_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_multiplicative_expression()?;

        loop {
            let op = match &self.current {
                Token::Plus => BinaryOp::Add,
                Token::Minus => BinaryOp::Sub,
                _ => break,
            };
            self.advance();
            let right = self.parse_multiplicative_expression()?;
            left = Expr::Binary {
                left: Box::new(left),
                operator: op,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_multiplicative_expression(&mut self) -> Result<Expr, ParseError> {
        let mut left = self.parse_exponentiation_expression()?;

        loop {
            let op = match &self.current {
                Token::Star => BinaryOp::Mul,
                Token::Slash => BinaryOp::Div,
                Token::Percent => BinaryOp::Mod,
                _ => break,
            };
            self.advance();
            let right = self.parse_exponentiation_expression()?;
            left = Expr::Binary {
                left: Box::new(left),
                operator: op,
                right: Box::new(right),
            };
        }

        Ok(left)
    }

    fn parse_exponentiation_expression(&mut self) -> Result<Expr, ParseError> {
        let left = self.parse_unary_expression()?;

        if self.check(&Token::StarStar) {
            self.advance();
            let right = self.parse_exponentiation_expression()?;
            return Ok(Expr::Binary {
                left: Box::new(left),
                operator: BinaryOp::Pow,
                right: Box::new(right),
            });
        }

        Ok(left)
    }

    fn parse_unary_expression(&mut self) -> Result<Expr, ParseError> {
        let op = match &self.current {
            Token::Minus => Some(UnaryOp::Minus),
            Token::Plus => Some(UnaryOp::Plus),
            Token::Bang => Some(UnaryOp::Not),
            Token::Tilde => Some(UnaryOp::BitwiseNot),
            Token::Keyword(Keyword::Typeof) => Some(UnaryOp::Typeof),
            Token::Keyword(Keyword::Void) => Some(UnaryOp::Void),
            Token::Keyword(Keyword::Delete) => Some(UnaryOp::Delete),
            Token::PlusPlus => Some(UnaryOp::Increment),
            Token::MinusMinus => Some(UnaryOp::Decrement),
            Token::Keyword(Keyword::Await) => {
                self.advance();
                let operand = self.parse_unary_expression()?;
                return Ok(Expr::Await(Box::new(operand)));
            },
            _ => None,
        };

        if let Some(op) = op {
            self.advance();
            let operand = self.parse_unary_expression()?;
            return Ok(Expr::Unary {
                operator: op,
                operand: Box::new(operand),
                prefix: true,
            });
        }

        self.parse_postfix_expression()
    }

    fn parse_postfix_expression(&mut self) -> Result<Expr, ParseError> {
        let mut expr = self.parse_left_hand_side_expression()?;

        // Postfix increment/decrement (no line terminator before)
        match &self.current {
            Token::PlusPlus => {
                self.advance();
                expr = Expr::Unary {
                    operator: UnaryOp::Increment,
                    operand: Box::new(expr),
                    prefix: false,
                };
            },
            Token::MinusMinus => {
                self.advance();
                expr = Expr::Unary {
                    operator: UnaryOp::Decrement,
                    operand: Box::new(expr),
                    prefix: false,
                };
            },
            _ => {}
        }

        Ok(expr)
    }

    fn parse_left_hand_side_expression(&mut self) -> Result<Expr, ParseError> {
        let expr = if self.check_keyword(Keyword::New) {
            self.parse_new_expression()?
        } else {
            self.parse_call_expression()?
        };

        Ok(expr)
    }

    fn parse_new_expression(&mut self) -> Result<Expr, ParseError> {
        self.consume_keyword(Keyword::New)?;

        let callee = if self.check_keyword(Keyword::New) {
            self.parse_new_expression()?
        } else {
            self.parse_member_expression()?
        };

        let arguments = if self.check(&Token::LeftParen) {
            self.parse_arguments()?
        } else {
            Vec::new()
        };

        let mut expr = Expr::New {
            callee: Box::new(callee),
            arguments,
        };

        // Continue with member/call
        expr = self.parse_call_member_chain(expr)?;

        Ok(expr)
    }

    fn parse_call_expression(&mut self) -> Result<Expr, ParseError> {
        let mut expr = self.parse_member_expression()?;
        expr = self.parse_call_member_chain(expr)?;
        Ok(expr)
    }

    fn parse_call_member_chain(&mut self, mut expr: Expr) -> Result<Expr, ParseError> {
        loop {
            if self.check(&Token::LeftParen) {
                let arguments = self.parse_arguments()?;
                expr = Expr::Call {
                    callee: Box::new(expr),
                    arguments,
                };
            } else if self.check(&Token::Dot) {
                self.advance();
                let property = self.consume_identifier()?;
                expr = Expr::Member {
                    object: Box::new(expr),
                    property,
                    computed: false,
                };
            } else if self.check(&Token::LeftBracket) {
                self.advance();
                let index = self.parse_expression()?;
                self.consume(Token::RightBracket)?;
                expr = Expr::Index {
                    object: Box::new(expr),
                    index: Box::new(index),
                };
            } else {
                break;
            }
        }
        Ok(expr)
    }

    fn parse_member_expression(&mut self) -> Result<Expr, ParseError> {
        let mut expr = self.parse_primary_expression()?;

        loop {
            if self.check(&Token::Dot) {
                self.advance();
                let property = self.consume_identifier()?;
                expr = Expr::Member {
                    object: Box::new(expr),
                    property,
                    computed: false,
                };
            } else if self.check(&Token::LeftBracket) {
                self.advance();
                let index = self.parse_expression()?;
                self.consume(Token::RightBracket)?;
                expr = Expr::Index {
                    object: Box::new(expr),
                    index: Box::new(index),
                };
            } else {
                break;
            }
        }

        Ok(expr)
    }

    fn parse_arguments(&mut self) -> Result<Vec<Expr>, ParseError> {
        self.consume(Token::LeftParen)?;

        let mut args = Vec::new();

        while !self.check(&Token::RightParen) {
            if self.check(&Token::DotDotDot) {
                self.advance();
                let arg = self.parse_assignment_expression()?;
                args.push(Expr::Spread(Box::new(arg)));
            } else {
                args.push(self.parse_assignment_expression()?);
            }

            if !self.check(&Token::Comma) {
                break;
            }
            self.advance();
        }

        self.consume(Token::RightParen)?;
        Ok(args)
    }

    fn parse_primary_expression(&mut self) -> Result<Expr, ParseError> {
        match &self.current {
            Token::Number(n) => {
                let n = *n;
                self.advance();
                Ok(Expr::Literal(Literal::Number(n)))
            },
            Token::String(s) => {
                let s = s.clone();
                self.advance();
                Ok(Expr::Literal(Literal::String(s)))
            },
            Token::Boolean(b) => {
                let b = *b;
                self.advance();
                Ok(Expr::Literal(Literal::Boolean(b)))
            },
            Token::Null => {
                self.advance();
                Ok(Expr::Literal(Literal::Null))
            },
            Token::Undefined => {
                self.advance();
                Ok(Expr::Literal(Literal::Undefined))
            },
            Token::Identifier(name) => {
                let name = name.clone();
                self.advance();

                // Check for arrow function
                if self.check(&Token::Arrow) {
                    self.advance();
                    return self.parse_arrow_function_body(vec![Pattern::Identifier(name)], false);
                }

                Ok(Expr::Identifier(name))
            },
            Token::Keyword(Keyword::This) => {
                self.advance();
                Ok(Expr::This)
            },
            Token::Keyword(Keyword::Super) => {
                self.advance();
                Ok(Expr::Super)
            },
            Token::Keyword(Keyword::Function) => self.parse_function_expression(),
            Token::Keyword(Keyword::Class) => self.parse_class_expression(),
            Token::Keyword(Keyword::Async) => self.parse_async_function_or_arrow(),
            Token::LeftParen => self.parse_parenthesized_or_arrow(),
            Token::LeftBracket => self.parse_array_literal(),
            Token::LeftBrace => self.parse_object_literal(),
            Token::TemplateLiteral(s) => {
                let s = s.clone();
                self.advance();
                Ok(Expr::TemplateLiteral {
                    quasis: vec![s],
                    expressions: vec![],
                })
            },
            Token::TemplateHead(s) => self.parse_template_literal(s.clone()),
            _ => Err(ParseError::UnexpectedToken(format!("{:?}", self.current))),
        }
    }

    fn parse_function_expression(&mut self) -> Result<Expr, ParseError> {
        self.consume_keyword(Keyword::Function)?;

        let is_generator = self.check(&Token::Star);
        if is_generator {
            self.advance();
        }

        let name = if let Token::Identifier(name) = &self.current {
            let name = name.clone();
            self.advance();
            Some(name)
        } else {
            None
        };

        let params = self.parse_function_params()?;
        let body = self.parse_function_body()?;

        Ok(Expr::Function(FunctionExpr {
            name,
            params,
            body,
            is_async: false,
            is_generator,
        }))
    }

    fn parse_class_expression(&mut self) -> Result<Expr, ParseError> {
        self.consume_keyword(Keyword::Class)?;

        let name = if let Token::Identifier(name) = &self.current {
            let name = name.clone();
            self.advance();
            Some(name)
        } else {
            None
        };

        let super_class = if self.check_keyword(Keyword::Extends) {
            self.advance();
            Some(Box::new(self.parse_left_hand_side_expression()?))
        } else {
            None
        };

        let body = self.parse_class_body()?;

        Ok(Expr::Class(ClassExpr { name, super_class, body }))
    }

    fn parse_async_function_or_arrow(&mut self) -> Result<Expr, ParseError> {
        self.consume_keyword(Keyword::Async)?;

        if self.check_keyword(Keyword::Function) {
            self.advance();

            let is_generator = self.check(&Token::Star);
            if is_generator {
                self.advance();
            }

            let name = if let Token::Identifier(name) = &self.current {
                let name = name.clone();
                self.advance();
                Some(name)
            } else {
                None
            };

            let params = self.parse_function_params()?;
            let body = self.parse_function_body()?;

            return Ok(Expr::Function(FunctionExpr {
                name,
                params,
                body,
                is_async: true,
                is_generator,
            }));
        }

        // Async arrow function
        if let Token::Identifier(name) = &self.current {
            let name = name.clone();
            self.advance();
            self.consume(Token::Arrow)?;
            return self.parse_arrow_function_body(vec![Pattern::Identifier(name)], true);
        }

        if self.check(&Token::LeftParen) {
            let params = self.parse_arrow_params()?;
            self.consume(Token::Arrow)?;
            return self.parse_arrow_function_body(params, true);
        }

        Err(ParseError::UnexpectedToken(format!("{:?}", self.current)))
    }

    fn parse_parenthesized_or_arrow(&mut self) -> Result<Expr, ParseError> {
        self.consume(Token::LeftParen)?;

        // Empty parens -> arrow function with no params
        if self.check(&Token::RightParen) {
            self.advance();
            if self.check(&Token::Arrow) {
                self.advance();
                return self.parse_arrow_function_body(vec![], false);
            }
            return Err(ParseError::UnexpectedToken("empty parens".to_string()));
        }

        // Parse contents
        let expr = self.parse_expression()?;
        self.consume(Token::RightParen)?;

        // Check for arrow
        if self.check(&Token::Arrow) {
            self.advance();
            let params = exprs_to_patterns(match expr {
                Expr::Sequence(exprs) => exprs,
                e => vec![e],
            })?;
            return self.parse_arrow_function_body(params, false);
        }

        Ok(expr)
    }

    fn parse_arrow_params(&mut self) -> Result<Vec<Pattern>, ParseError> {
        self.consume(Token::LeftParen)?;

        let mut params = Vec::new();

        while !self.check(&Token::RightParen) {
            if self.check(&Token::DotDotDot) {
                self.advance();
                let rest = self.parse_pattern()?;
                params.push(Pattern::Rest(Box::new(rest)));
                break;
            }

            let pattern = self.parse_pattern()?;

            if self.check(&Token::Equals) {
                self.advance();
                let default = self.parse_assignment_expression()?;
                params.push(Pattern::Assignment {
                    pattern: Box::new(pattern),
                    default,
                });
            } else {
                params.push(pattern);
            }

            if !self.check(&Token::Comma) {
                break;
            }
            self.advance();
        }

        self.consume(Token::RightParen)?;
        Ok(params)
    }

    fn parse_arrow_function_body(&mut self, params: Vec<Pattern>, is_async: bool) -> Result<Expr, ParseError> {
        let body = if self.check(&Token::LeftBrace) {
            self.consume(Token::LeftBrace)?;
            let stmts = self.parse_block_body()?;
            self.consume(Token::RightBrace)?;
            ArrowBody::Block(stmts)
        } else {
            ArrowBody::Expr(Box::new(self.parse_assignment_expression()?))
        };

        Ok(Expr::ArrowFunction(ArrowFunction { params, body, is_async }))
    }

    fn parse_array_literal(&mut self) -> Result<Expr, ParseError> {
        self.consume(Token::LeftBracket)?;

        let mut elements = Vec::new();

        while !self.check(&Token::RightBracket) {
            if self.check(&Token::Comma) {
                // Elision
                elements.push(Expr::Literal(Literal::Undefined));
                self.advance();
                continue;
            }

            if self.check(&Token::DotDotDot) {
                self.advance();
                let expr = self.parse_assignment_expression()?;
                elements.push(Expr::Spread(Box::new(expr)));
            } else {
                elements.push(self.parse_assignment_expression()?);
            }

            if !self.check(&Token::Comma) {
                break;
            }
            self.advance();
        }

        self.consume(Token::RightBracket)?;
        Ok(Expr::Array(elements))
    }

    fn parse_object_literal(&mut self) -> Result<Expr, ParseError> {
        self.consume(Token::LeftBrace)?;

        let mut properties = Vec::new();

        while !self.check(&Token::RightBrace) {
            properties.push(self.parse_property()?);

            if !self.check(&Token::Comma) {
                break;
            }
            self.advance();
        }

        self.consume(Token::RightBrace)?;
        Ok(Expr::Object(properties))
    }

    fn parse_property(&mut self) -> Result<Property, ParseError> {
        // Check for spread
        if self.check(&Token::DotDotDot) {
            self.advance();
            let value = self.parse_assignment_expression()?;
            return Ok(Property {
                key: PropertyKey::Identifier(String::new()),
                value: Expr::Spread(Box::new(value)),
                kind: PropertyKind::Init,
                computed: false,
                shorthand: false,
            });
        }

        // Check for getter/setter
        let kind = if self.check_keyword(Keyword::Get) {
            self.advance();
            PropertyKind::Get
        } else if self.check_keyword(Keyword::Set) {
            self.advance();
            PropertyKind::Set
        } else {
            PropertyKind::Init
        };

        let computed = self.check(&Token::LeftBracket);
        let key = self.parse_property_key()?;

        // Shorthand property
        if let PropertyKey::Identifier(ref name) = key {
            if !computed && (self.check(&Token::Comma) || self.check(&Token::RightBrace)) {
                return Ok(Property {
                    key: key.clone(),
                    value: Expr::Identifier(name.clone()),
                    kind: PropertyKind::Init,
                    computed: false,
                    shorthand: true,
                });
            }
        }

        // Method
        if self.check(&Token::LeftParen) {
            let params = self.parse_function_params()?;
            let body = self.parse_function_body()?;
            return Ok(Property {
                key,
                value: Expr::Function(FunctionExpr {
                    name: None,
                    params,
                    body,
                    is_async: false,
                    is_generator: false,
                }),
                kind: if kind == PropertyKind::Init { PropertyKind::Method } else { kind },
                computed,
                shorthand: false,
            });
        }

        // Regular property
        self.consume(Token::Colon)?;
        let value = self.parse_assignment_expression()?;

        Ok(Property {
            key,
            value,
            kind: PropertyKind::Init,
            computed,
            shorthand: false,
        })
    }

    fn parse_property_key(&mut self) -> Result<PropertyKey, ParseError> {
        if self.check(&Token::LeftBracket) {
            self.advance();
            let expr = self.parse_assignment_expression()?;
            self.consume(Token::RightBracket)?;
            return Ok(PropertyKey::Computed(Box::new(expr)));
        }

        match &self.current {
            Token::Identifier(name) => {
                let name = name.clone();
                self.advance();
                Ok(PropertyKey::Identifier(name))
            },
            Token::String(s) => {
                let s = s.clone();
                self.advance();
                Ok(PropertyKey::String(s))
            },
            Token::Number(n) => {
                let n = *n;
                self.advance();
                Ok(PropertyKey::Number(n))
            },
            _ => Err(ParseError::ExpectedPropertyKey),
        }
    }

    fn parse_template_literal(&mut self, head: String) -> Result<Expr, ParseError> {
        self.advance(); // Consume TemplateHead

        let mut quasis = vec![head];
        let mut expressions = Vec::new();

        loop {
            // Parse expression
            expressions.push(self.parse_expression()?);

            // Expect } and continue template
            self.consume(Token::RightBrace)?;
            let next = self.lexer.continue_template();

            match next {
                Token::TemplateTail(s) => {
                    quasis.push(s);
                    self.advance();
                    break;
                },
                Token::TemplateMiddle(s) => {
                    quasis.push(s);
                    self.advance();
                },
                _ => return Err(ParseError::UnexpectedToken(format!("{:?}", next))),
            }
        }

        Ok(Expr::TemplateLiteral { quasis, expressions })
    }

    // --------------------------------------------------------
    // Pattern parsing
    // --------------------------------------------------------

    fn parse_pattern(&mut self) -> Result<Pattern, ParseError> {
        match &self.current {
            Token::Identifier(name) => {
                let name = name.clone();
                self.advance();
                Ok(Pattern::Identifier(name))
            },
            Token::LeftBracket => self.parse_array_pattern(),
            Token::LeftBrace => self.parse_object_pattern(),
            _ => Err(ParseError::ExpectedPattern),
        }
    }

    fn parse_array_pattern(&mut self) -> Result<Pattern, ParseError> {
        self.consume(Token::LeftBracket)?;

        let mut elements = Vec::new();

        while !self.check(&Token::RightBracket) {
            if self.check(&Token::Comma) {
                elements.push(None);
                self.advance();
                continue;
            }

            if self.check(&Token::DotDotDot) {
                self.advance();
                let rest = self.parse_pattern()?;
                elements.push(Some(ArrayPatternElement {
                    pattern: Pattern::Rest(Box::new(rest)),
                    default_value: None,
                }));
                break;
            }

            let pattern = self.parse_pattern()?;
            let default_value = if self.check(&Token::Equals) {
                self.advance();
                Some(self.parse_assignment_expression()?)
            } else {
                None
            };

            elements.push(Some(ArrayPatternElement { pattern, default_value }));

            if !self.check(&Token::Comma) {
                break;
            }
            self.advance();
        }

        self.consume(Token::RightBracket)?;
        Ok(Pattern::Array(elements))
    }

    fn parse_object_pattern(&mut self) -> Result<Pattern, ParseError> {
        self.consume(Token::LeftBrace)?;

        let mut properties = Vec::new();

        while !self.check(&Token::RightBrace) {
            if self.check(&Token::DotDotDot) {
                self.advance();
                let rest = self.parse_pattern()?;
                properties.push(ObjectPatternProperty {
                    key: String::new(),
                    value: Pattern::Rest(Box::new(rest)),
                    computed: false,
                    shorthand: false,
                });
                break;
            }

            let key = self.consume_identifier()?;

            let (value, shorthand) = if self.check(&Token::Colon) {
                self.advance();
                (self.parse_pattern()?, false)
            } else {
                (Pattern::Identifier(key.clone()), true)
            };

            properties.push(ObjectPatternProperty {
                key,
                value,
                computed: false,
                shorthand,
            });

            if !self.check(&Token::Comma) {
                break;
            }
            self.advance();
        }

        self.consume(Token::RightBrace)?;
        Ok(Pattern::Object(properties))
    }
}

// ============================================================
// Error Types
// ============================================================

#[derive(Clone, Debug)]
pub enum ParseError {
    UnexpectedToken(String),
    ExpectedKeyword(Keyword),
    ExpectedIdentifier,
    ExpectedString,
    ExpectedPattern,
    ExpectedPropertyKey,
    InvalidPattern,
}

// ============================================================
// Helper Functions
// ============================================================

fn expr_to_pattern(expr: Expr) -> Result<Pattern, ParseError> {
    match expr {
        Expr::Identifier(name) => Ok(Pattern::Identifier(name)),
        Expr::Array(elements) => {
            let patterns = elements
                .into_iter()
                .map(|e| {
                    if let Expr::Literal(Literal::Undefined) = e {
                        Ok(None)
                    } else {
                        Ok(Some(ArrayPatternElement {
                            pattern: expr_to_pattern(e)?,
                            default_value: None,
                        }))
                    }
                })
                .collect::<Result<Vec<_>, _>>()?;
            Ok(Pattern::Array(patterns))
        },
        Expr::Object(props) => {
            let patterns = props
                .into_iter()
                .map(|p| {
                    let key = match p.key {
                        PropertyKey::Identifier(name) => name,
                        _ => return Err(ParseError::InvalidPattern),
                    };
                    let value = expr_to_pattern(p.value)?;
                    Ok(ObjectPatternProperty {
                        key,
                        value,
                        computed: p.computed,
                        shorthand: p.shorthand,
                    })
                })
                .collect::<Result<Vec<_>, _>>()?;
            Ok(Pattern::Object(patterns))
        },
        Expr::Assignment { target, value, .. } => {
            let pattern = expr_to_pattern(*target)?;
            Ok(Pattern::Assignment {
                pattern: Box::new(pattern),
                default: *value,
            })
        },
        Expr::Spread(inner) => {
            let pattern = expr_to_pattern(*inner)?;
            Ok(Pattern::Rest(Box::new(pattern)))
        },
        _ => Err(ParseError::InvalidPattern),
    }
}

fn exprs_to_patterns(exprs: Vec<Expr>) -> Result<Vec<Pattern>, ParseError> {
    exprs.into_iter().map(expr_to_pattern).collect()
}

// ============================================================
// Public API
// ============================================================

pub fn parse(source: &str) -> Result<Program, ParseError> {
    let mut parser = Parser::new(source);
    parser.parse()
}

pub fn parse_expression(source: &str) -> Result<Expr, ParseError> {
    let mut parser = Parser::new(source);
    parser.parse_expression()
}
