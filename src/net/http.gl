fn http_str_http11() -> i64 {
    // "HTTP/1.1"
    let buf = HTTP_TX_BUF + 3900;
    http_write_byte(buf, 72);   // H
    http_write_byte(buf+1, 84); // T
    http_write_byte(buf+2, 84); // T
    http_write_byte(buf+3, 80); // P
    http_write_byte(buf+4, 47); // /
    http_write_byte(buf+5, 49); // 1
    http_write_byte(buf+6, 46); // .
    http_write_byte(buf+7, 49); // 1
    http_write_byte(buf+8, 0);
    buf
}

