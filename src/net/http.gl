}

// Helper to build static string in buffer
fn http_static_string(c0: i64, c1: i64, c2: i64, c3: i64, c4: i64, c5: i64, c6: i64, c7: i64) -> i64 {
    let buf = HTTP_TX_BUF + 3990;
    http_write_byte(buf, c0);
    http_write_byte(buf+1, c1);
    http_write_byte(buf+2, c2);
    http_write_byte(buf+3, c3);
    http_write_byte(buf+4, c4);
    http_write_byte(buf+5, c5);
    http_write_byte(buf+6, c6);
    http_write_byte(buf+7, c7);
    buf
}

// ============================================================
// Helper Functions
// ============================================================

fn http_reset_state() {
    http_memset(HTTP_STATE, 0, 128);
    http_memset(HTTP_HEADERS, 0, HTTP_MAX_HEADERS * HTTP_HEADER_SIZE);
    http_write_u32(HTTP_STATE + HTTP_STATE_TIMEOUT, HTTP_DEFAULT_TIMEOUT as u64);
}

fn http_set_error(err: i64) {
    http_write_u32(HTTP_STATE + HTTP_STATE_ERROR, (0 - err) as u64);
}

fn http_find_line_end(buf: i64, start: i64, end: i64) -> i64 {
    let mut i = start;
    while i < end - 1 {
        if http_read_byte(buf + i) == 13 && http_read_byte(buf + i + 1) == 10 {
            return i;
        }
        i = i + 1;
    }
    end
}

fn http_find_char(buf: i64, start: i64, end: i64, ch: i64) -> i64 {
    let mut i = start;
    while i < end {
        if http_read_byte(buf + i) == ch {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

fn http_parse_decimal(addr: i64) -> i64 {
    let mut val: i64 = 0;
    let mut i: i64 = 0;
    while i < 20 {
        let ch = http_read_byte(addr + i);
        if ch >= 48 && ch <= 57 {
            val = val * 10 + (ch - 48);
        } else if ch == 0 {
            break;
        } else if ch != 32 {
            break;
        }
        i = i + 1;
    }
    val
}

fn http_hex_value(ch: i64) -> i64 {
    if ch >= 48 && ch <= 57 { return ch - 48; }
    if ch >= 65 && ch <= 70 { return ch - 65 + 10; }
    if ch >= 97 && ch <= 102 { return ch - 97 + 10; }
    0 - 1
}

fn http_strcasecmp(a: i64, b: i64) -> i64 {
    let mut i: i64 = 0;
    loop {
        let ca = http_tolower(http_read_byte(a + i));
        let cb = http_tolower(http_read_byte(b + i));
        if ca != cb { return ca - cb; }
        if ca == 0 { return 0; }
        i = i + 1;
        if i > 64 { return 0; }
    }
    0
}

fn http_tolower(ch: i64) -> i64 {
    if ch >= 65 && ch <= 90 { return ch + 32; }
    ch
}

fn http_copy_trim(src: i64, dst: i64, len: i64, max: i64) {
    let mut start: i64 = 0;
    let mut end = len;

    // Skip leading spaces
    while start < len && http_read_byte(src + start) == 32 {
        start = start + 1;
    }

    // Skip trailing spaces
    while end > start && http_read_byte(src + end - 1) == 32 {
        end = end - 1;
    }

    let copy_len = end - start;
    let actual = if copy_len < max { copy_len } else { max };

    let mut i: i64 = 0;
    while i < actual {
        http_write_byte(dst + i, http_read_byte(src + start + i));
        i = i + 1;
    }
    http_write_byte(dst + actual, 0);
}

fn http_copy_string(src: i64, dst: i64, max: i64) {
    let mut i: i64 = 0;
    while i < max - 1 {
        let ch = http_read_byte(src + i);
        http_write_byte(dst + i, ch);
        if ch == 0 { return; }
        i = i + 1;
    }
    http_write_byte(dst + max - 1, 0);
}

fn http_copy_bytes(dst: i64, dst_off: i64, src: i64, len: i64) -> i64 {
    let mut i: i64 = 0;
    while i < len {
        http_write_byte(dst + dst_off + i, http_read_byte(src + i));
        i = i + 1;
    }
    dst_off + len
}

fn http_write_string(buf: i64, pos: i64, str_addr: i64) -> i64 {
    let mut p = pos;
    let mut i: i64 = 0;
    while i < 256 {
        let ch = http_read_byte(str_addr + i);
        if ch == 0 { break; }
        http_write_byte(buf + p, ch);
        p = p + 1;
        i = i + 1;
    }
    p
}

fn http_write_decimal(buf: i64, pos: i64, val: i64) -> i64 {
    if val == 0 {
        http_write_byte(buf + pos, 48);
        return pos + 1;
    }

    // Count digits
    let mut temp = val;
    let mut digits: i64 = 0;
    while temp > 0 {
        temp = temp / 10;
        digits = digits + 1;
    }

    // Write digits
    let mut p = pos + digits - 1;
    temp = val;
    while temp > 0 {
        http_write_byte(buf + p, 48 + (temp % 10));
        temp = temp / 10;
        p = p - 1;
    }

    pos + digits
}

fn http_write_crlf(buf: i64, pos: i64) -> i64 {
    http_write_byte(buf + pos, 13);
    http_write_byte(buf + pos + 1, 10);
    pos + 2
}

fn http_write_byte_ret(buf: i64, pos: i64, val: i64) -> i64 {
    http_write_byte(buf + pos, val);
    pos + 1
}

fn http_memset(dst: i64, val: i64, len: i64) {
    let mut i: i64 = 0;
    while i < len {
        http_write_byte(dst + i, val);
        i = i + 1;
    }
}

// ============================================================
// Low-level Memory Access
// ============================================================

fn http_read_byte(addr: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "movzbq (%rdi), %rax",
            in("rdi") addr,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn http_write_byte(addr: i64, value: i64) {
    unsafe {
        asm!(
            "movb %sil, (%rdi)",
            in("rdi") addr,
            in("sil") value,
            options(nostack, att_syntax)
        );
    }
}

fn http_read_u16(addr: i64) -> u64 {
    let mut result: u64 = 0;
    unsafe {
        asm!(
            "movzwq (%rdi), %rax",
            in("rdi") addr,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn http_write_u16(addr: i64, value: u64) {
    unsafe {
        asm!(
            "movw %si, (%rdi)",
            in("rdi") addr,
            in("si") value,
            options(nostack, att_syntax)
        );
    }
}

fn http_read_u32(addr: i64) -> u64 {
    let mut result: u64 = 0;
    unsafe {
        asm!(
            "movl (%rdi), %eax",
            in("rdi") addr,
            lateout("eax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn http_write_u32(addr: i64, value: u64) {
    unsafe {
        asm!(
            "movl %esi, (%rdi)",
            in("rdi") addr,
            in("esi") value,
            options(nostack, att_syntax)
        );
    }
}

fn http_read_u64(addr: i64) -> u64 {
    let mut result: u64 = 0;
    unsafe {
        asm!(
            "movq (%rdi), %rax",
            in("rdi") addr,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn http_write_u64(addr: i64, value: u64) {
    unsafe {
        asm!(
            "movq %rsi, (%rdi)",
            in("rdi") addr,
            in("rsi") value,
            options(nostack, att_syntax)
        );
    }
}

// ============================================================
// System Calls (via kernel)
// ============================================================

// Syscall numbers
const SYS_NET_SOCKET: i64 = 50;
const SYS_NET_CONNECT: i64 = 54;
const SYS_NET_SEND: i64 = 55;
const SYS_NET_RECV: i64 = 56;
const SYS_NET_CLOSE: i64 = 57;
const SYS_NET_RESOLVE: i64 = 60;
const SYS_YIELD: i64 = 0;
const SYS_TIME: i64 = 34;

const SOCK_STREAM: i64 = 1;

fn http_syscall0(num: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn http_syscall1(num: i64, arg1: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn http_syscall3(num: i64, arg1: i64, arg2: i64, arg3: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn http_socket_create() -> i64 {
    http_syscall1(SYS_NET_SOCKET, SOCK_STREAM)
}

fn http_socket_connect(sock: i64, ip: i64, port: i64) -> i64 {
    http_syscall3(SYS_NET_CONNECT, sock, ip, port)
}

fn http_socket_send(sock: i64, buf: i64, len: i64) -> i64 {
    http_syscall3(SYS_NET_SEND, sock, buf, len)
}

fn http_socket_recv(sock: i64, buf: i64, len: i64) -> i64 {
    http_syscall3(SYS_NET_RECV, sock, buf, len)
}

fn http_socket_close(sock: i64) -> i64 {
    http_syscall1(SYS_NET_CLOSE, sock)
}

fn http_dns_resolve(hostname: i64) -> i64 {
    http_syscall1(SYS_NET_RESOLVE, hostname)
}

fn http_yield() {
    http_syscall0(SYS_YIELD);
}

fn http_get_ticks() -> i64 {
    http_syscall0(SYS_TIME)
}
