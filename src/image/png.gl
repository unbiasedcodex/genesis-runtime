// PNG Decoder (RFC 2083)
// Supports grayscale, RGB, indexed, grayscale+alpha, and RGBA images
// Filter types: None, Sub, Up, Average, Paeth

use super::common::{ImageBuffer, PixelFormat, read_u8, read_u32_be, clamp_u8};
use super::deflate::inflate_zlib;
use super::ImageError;

// ============================================================
// PNG Constants
// ============================================================

// PNG signature
const PNG_SIGNATURE: [u8; 8] = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A];

// Chunk types (as u32 for easy comparison)
const CHUNK_IHDR: u32 = 0x49484452;  // Image header
const CHUNK_PLTE: u32 = 0x504C5445;  // Palette
const CHUNK_IDAT: u32 = 0x49444154;  // Image data
const CHUNK_IEND: u32 = 0x49454E44;  // Image end
const CHUNK_TRNS: u32 = 0x74524E53;  // Transparency
const CHUNK_GAMA: u32 = 0x67414D41;  // Gamma
const CHUNK_SRGB: u32 = 0x73524742;  // sRGB color space
const CHUNK_BKGD: u32 = 0x624B4744;  // Background color

// Color types
const COLOR_GRAYSCALE: u8 = 0;
const COLOR_RGB: u8 = 2;
const COLOR_INDEXED: u8 = 3;
const COLOR_GRAYSCALE_ALPHA: u8 = 4;
const COLOR_RGBA: u8 = 6;

// Filter types
const FILTER_NONE: u8 = 0;
const FILTER_SUB: u8 = 1;
const FILTER_UP: u8 = 2;
const FILTER_AVERAGE: u8 = 3;
const FILTER_PAETH: u8 = 4;

// ============================================================
// PNG Context
// ============================================================

struct PngContext {
    width: u32,
    height: u32,
    bit_depth: u8,
    color_type: u8,
    compression: u8,
    filter: u8,
    interlace: u8,

    // Palette (for indexed images)
    palette: Vec<u32>,          // ARGB colors
    has_transparency: bool,
    trans_gray: u16,            // Transparent gray value
    trans_rgb: [u16; 3],        // Transparent RGB values

    // Accumulated IDAT data
    idat_data: Vec<u8>,
}

impl PngContext {
    fn new() -> PngContext {
        PngContext {
            width: 0,
            height: 0,
            bit_depth: 0,
            color_type: 0,
            compression: 0,
            filter: 0,
            interlace: 0,
            palette: Vec::new(),
            has_transparency: false,
            trans_gray: 0,
            trans_rgb: [0, 0, 0],
            idat_data: Vec::new(),
        }
    }

    fn bytes_per_pixel(&self) -> usize {
        let samples = match self.color_type {
            COLOR_GRAYSCALE => 1,
            COLOR_RGB => 3,
            COLOR_INDEXED => 1,
            COLOR_GRAYSCALE_ALPHA => 2,
            COLOR_RGBA => 4,
            _ => 1,
        };
        (samples * self.bit_depth as usize + 7) / 8
    }

    fn scanline_bytes(&self) -> usize {
        let bits_per_pixel = match self.color_type {
            COLOR_GRAYSCALE => self.bit_depth as usize,
            COLOR_RGB => 3 * self.bit_depth as usize,
            COLOR_INDEXED => self.bit_depth as usize,
            COLOR_GRAYSCALE_ALPHA => 2 * self.bit_depth as usize,
            COLOR_RGBA => 4 * self.bit_depth as usize,
            _ => 8,
        };
        (self.width as usize * bits_per_pixel + 7) / 8
    }
}

// ============================================================
// PNG Decoder
// ============================================================

pub fn decode(data: &[u8]) -> Result<ImageBuffer, ImageError> {
    // Check signature
    if data.len() < 8 {
        return Err(ImageError::TruncatedData);
    }

    let mut i: usize = 0;
    while i < 8 {
        if data[i] != PNG_SIGNATURE[i] {
            return Err(ImageError::InvalidHeader);
        }
        i += 1;
    }

    let mut ctx = PngContext::new();
    let mut pos: usize = 8;

    // Parse chunks
    while pos + 12 <= data.len() {
        let length = read_u32_be(data, pos) as usize;
        let chunk_type = read_u32_be(data, pos + 4);
        let chunk_data_start = pos + 8;
        let chunk_data_end = chunk_data_start + length;

        if chunk_data_end > data.len() {
            return Err(ImageError::TruncatedData);
        }

        let chunk_data = &data[chunk_data_start..chunk_data_end];

        match chunk_type {
            CHUNK_IHDR => parse_ihdr(&mut ctx, chunk_data)?,
            CHUNK_PLTE => parse_plte(&mut ctx, chunk_data)?,
            CHUNK_IDAT => {
                // Accumulate IDAT chunks
                ctx.idat_data.extend_from_slice(chunk_data);
            },
            CHUNK_IEND => break,
            CHUNK_TRNS => parse_trns(&mut ctx, chunk_data)?,
            _ => {
                // Ignore unknown chunks
            },
        }

        pos = chunk_data_end + 4;  // Skip CRC
    }

    // Validate
    if ctx.width == 0 || ctx.height == 0 {
        return Err(ImageError::InvalidHeader);
    }

    if ctx.idat_data.is_empty() {
        return Err(ImageError::InvalidData);
    }

    // Decompress IDAT data
    let raw_data = inflate_zlib(&ctx.idat_data)?;

    // Decode image data
    decode_image_data(&ctx, &raw_data)
}

fn parse_ihdr(ctx: &mut PngContext, data: &[u8]) -> Result<(), ImageError> {
    if data.len() < 13 {
        return Err(ImageError::InvalidHeader);
    }

    ctx.width = read_u32_be(data, 0);
    ctx.height = read_u32_be(data, 4);
    ctx.bit_depth = data[8];
    ctx.color_type = data[9];
    ctx.compression = data[10];
    ctx.filter = data[11];
    ctx.interlace = data[12];

    // Validate
    if ctx.width == 0 || ctx.height == 0 {
        return Err(ImageError::InvalidHeader);
    }

    // Check valid bit depth for color type
    let valid = match ctx.color_type {
        COLOR_GRAYSCALE => ctx.bit_depth == 1 || ctx.bit_depth == 2 ||
                          ctx.bit_depth == 4 || ctx.bit_depth == 8 ||
                          ctx.bit_depth == 16,
        COLOR_RGB => ctx.bit_depth == 8 || ctx.bit_depth == 16,
        COLOR_INDEXED => ctx.bit_depth == 1 || ctx.bit_depth == 2 ||
                        ctx.bit_depth == 4 || ctx.bit_depth == 8,
        COLOR_GRAYSCALE_ALPHA => ctx.bit_depth == 8 || ctx.bit_depth == 16,
        COLOR_RGBA => ctx.bit_depth == 8 || ctx.bit_depth == 16,
        _ => false,
    };

    if !valid {
        return Err(ImageError::InvalidHeader);
    }

    // Only support compression method 0
    if ctx.compression != 0 {
        return Err(ImageError::InvalidHeader);
    }

    // Only support filter method 0
    if ctx.filter != 0 {
        return Err(ImageError::InvalidHeader);
    }

    // Interlacing: 0 = none, 1 = Adam7
    if ctx.interlace > 1 {
        return Err(ImageError::InvalidHeader);
    }

    Ok(())
}

fn parse_plte(ctx: &mut PngContext, data: &[u8]) -> Result<(), ImageError> {
    if data.len() % 3 != 0 {
        return Err(ImageError::InvalidChunk);
    }

    let num_entries = data.len() / 3;
    ctx.palette.clear();

    let mut i: usize = 0;
    while i < num_entries {
        let r = data[i * 3] as u32;
        let g = data[i * 3 + 1] as u32;
        let b = data[i * 3 + 2] as u32;
        // Default alpha is 255 (fully opaque)
        let color = 0xFF000000 | (r << 16) | (g << 8) | b;
        ctx.palette.push(color);
        i += 1;
    }

    Ok(())
}

fn parse_trns(ctx: &mut PngContext, data: &[u8]) -> Result<(), ImageError> {
    ctx.has_transparency = true;

    match ctx.color_type {
        COLOR_GRAYSCALE => {
            if data.len() >= 2 {
                ctx.trans_gray = ((data[0] as u16) << 8) | (data[1] as u16);
            }
        },
        COLOR_RGB => {
            if data.len() >= 6 {
                ctx.trans_rgb[0] = ((data[0] as u16) << 8) | (data[1] as u16);
                ctx.trans_rgb[1] = ((data[2] as u16) << 8) | (data[3] as u16);
                ctx.trans_rgb[2] = ((data[4] as u16) << 8) | (data[5] as u16);
            }
        },
        COLOR_INDEXED => {
            // Update palette alpha values
            let mut i: usize = 0;
            while i < data.len() && i < ctx.palette.len() {
                let alpha = data[i] as u32;
                ctx.palette[i] = (ctx.palette[i] & 0x00FFFFFF) | (alpha << 24);
                i += 1;
            }
        },
        _ => {}
    }

    Ok(())
}

// ============================================================
// Image Data Decoding
// ============================================================

fn decode_image_data(ctx: &PngContext, raw_data: &[u8]) -> Result<ImageBuffer, ImageError> {
    if ctx.interlace == 1 {
        decode_interlaced(ctx, raw_data)
    } else {
        decode_non_interlaced(ctx, raw_data)
    }
}

fn decode_non_interlaced(ctx: &PngContext, raw_data: &[u8]) -> Result<ImageBuffer, ImageError> {
    let scanline_bytes = ctx.scanline_bytes();
    let filter_bytes = ctx.bytes_per_pixel();

    // Create output buffer
    let mut image = ImageBuffer::new_rgba(ctx.width, ctx.height);

    // Allocate scanline buffers
    let mut current_line = vec![0u8; scanline_bytes];
    let mut previous_line = vec![0u8; scanline_bytes];

    let mut pos: usize = 0;
    let mut y: u32 = 0;

    while y < ctx.height {
        // Read filter type
        if pos >= raw_data.len() {
            return Err(ImageError::TruncatedData);
        }
        let filter_type = raw_data[pos];
        pos += 1;

        // Read scanline
        if pos + scanline_bytes > raw_data.len() {
            return Err(ImageError::TruncatedData);
        }

        // Copy and unfilter
        let mut i: usize = 0;
        while i < scanline_bytes {
            current_line[i] = raw_data[pos + i];
            i += 1;
        }
        pos += scanline_bytes;

        // Apply reverse filter
        unfilter_scanline(&mut current_line, &previous_line, filter_type, filter_bytes)?;

        // Convert scanline to pixels
        convert_scanline_to_pixels(ctx, &current_line, &mut image, y);

        // Swap buffers
        std::mem::swap(&mut current_line, &mut previous_line);

        y += 1;
    }

    Ok(image)
}

fn decode_interlaced(ctx: &PngContext, raw_data: &[u8]) -> Result<ImageBuffer, ImageError> {
    // Adam7 interlacing pattern
    const START_X: [u32; 7] = [0, 4, 0, 2, 0, 1, 0];
    const START_Y: [u32; 7] = [0, 0, 4, 0, 2, 0, 1];
    const INC_X: [u32; 7] = [8, 8, 4, 4, 2, 2, 1];
    const INC_Y: [u32; 7] = [8, 8, 8, 4, 4, 2, 2];

    let mut image = ImageBuffer::new_rgba(ctx.width, ctx.height);
    let filter_bytes = ctx.bytes_per_pixel();
    let mut pos: usize = 0;

    let mut pass: usize = 0;
    while pass < 7 {
        let pass_width = (ctx.width + INC_X[pass] - 1 - START_X[pass]) / INC_X[pass];
        let pass_height = (ctx.height + INC_Y[pass] - 1 - START_Y[pass]) / INC_Y[pass];

        if pass_width == 0 || pass_height == 0 {
            pass += 1;
            continue;
        }

        let bits_per_pixel = match ctx.color_type {
            COLOR_GRAYSCALE => ctx.bit_depth as usize,
            COLOR_RGB => 3 * ctx.bit_depth as usize,
            COLOR_INDEXED => ctx.bit_depth as usize,
            COLOR_GRAYSCALE_ALPHA => 2 * ctx.bit_depth as usize,
            COLOR_RGBA => 4 * ctx.bit_depth as usize,
            _ => 8,
        };
        let scanline_bytes = (pass_width as usize * bits_per_pixel + 7) / 8;

        let mut current_line = vec![0u8; scanline_bytes];
        let mut previous_line = vec![0u8; scanline_bytes];

        let mut py: u32 = 0;
        while py < pass_height {
            // Read filter type
            if pos >= raw_data.len() {
                return Err(ImageError::TruncatedData);
            }
            let filter_type = raw_data[pos];
            pos += 1;

            // Read and unfilter scanline
            if pos + scanline_bytes > raw_data.len() {
                return Err(ImageError::TruncatedData);
            }

            let mut i: usize = 0;
            while i < scanline_bytes {
                current_line[i] = raw_data[pos + i];
                i += 1;
            }
            pos += scanline_bytes;

            unfilter_scanline(&mut current_line, &previous_line, filter_type, filter_bytes)?;

            // Convert and place pixels
            let y = START_Y[pass] + py * INC_Y[pass];
            let mut px: u32 = 0;
            while px < pass_width {
                let x = START_X[pass] + px * INC_X[pass];
                let pixel = extract_pixel(ctx, &current_line, px);
                image.set_pixel(x, y, pixel);
                px += 1;
            }

            std::mem::swap(&mut current_line, &mut previous_line);
            py += 1;
        }

        pass += 1;
    }

    Ok(image)
}

// ============================================================
// Filter Reversal
// ============================================================

fn unfilter_scanline(
    current: &mut [u8],
    previous: &[u8],
    filter_type: u8,
    filter_bytes: usize,
) -> Result<(), ImageError> {
    match filter_type {
        FILTER_NONE => Ok(()),
        FILTER_SUB => {
            let mut i = filter_bytes;
            while i < current.len() {
                current[i] = current[i].wrapping_add(current[i - filter_bytes]);
                i += 1;
            }
            Ok(())
        },
        FILTER_UP => {
            let mut i: usize = 0;
            while i < current.len() {
                current[i] = current[i].wrapping_add(previous[i]);
                i += 1;
            }
            Ok(())
        },
        FILTER_AVERAGE => {
            let mut i: usize = 0;
            while i < current.len() {
                let a = if i >= filter_bytes { current[i - filter_bytes] as u16 } else { 0 };
                let b = previous[i] as u16;
                current[i] = current[i].wrapping_add(((a + b) / 2) as u8);
                i += 1;
            }
            Ok(())
        },
        FILTER_PAETH => {
            let mut i: usize = 0;
            while i < current.len() {
                let a = if i >= filter_bytes { current[i - filter_bytes] } else { 0 };
                let b = previous[i];
                let c = if i >= filter_bytes { previous[i - filter_bytes] } else { 0 };
                current[i] = current[i].wrapping_add(paeth_predictor(a, b, c));
                i += 1;
            }
            Ok(())
        },
        _ => Err(ImageError::InvalidFilter),
    }
}

fn paeth_predictor(a: u8, b: u8, c: u8) -> u8 {
    let a = a as i32;
    let b = b as i32;
    let c = c as i32;

    let p = a + b - c;
    let pa = (p - a).abs();
    let pb = (p - b).abs();
    let pc = (p - c).abs();

    if pa <= pb && pa <= pc {
        a as u8
    } else if pb <= pc {
        b as u8
    } else {
        c as u8
    }
}

// ============================================================
// Pixel Conversion
// ============================================================

fn convert_scanline_to_pixels(ctx: &PngContext, scanline: &[u8], image: &mut ImageBuffer, y: u32) {
    let mut x: u32 = 0;
    while x < ctx.width {
        let pixel = extract_pixel(ctx, scanline, x);
        image.set_pixel(x, y, pixel);
        x += 1;
    }
}

fn extract_pixel(ctx: &PngContext, scanline: &[u8], x: u32) -> u32 {
    match ctx.color_type {
        COLOR_GRAYSCALE => extract_grayscale(ctx, scanline, x),
        COLOR_RGB => extract_rgb(ctx, scanline, x),
        COLOR_INDEXED => extract_indexed(ctx, scanline, x),
        COLOR_GRAYSCALE_ALPHA => extract_grayscale_alpha(ctx, scanline, x),
        COLOR_RGBA => extract_rgba(ctx, scanline, x),
        _ => 0,
    }
}

fn extract_grayscale(ctx: &PngContext, scanline: &[u8], x: u32) -> u32 {
    let g: u32;

    match ctx.bit_depth {
        1 => {
            let byte_idx = x as usize / 8;
            let bit_idx = 7 - (x as usize % 8);
            let bit = (scanline[byte_idx] >> bit_idx) & 1;
            g = if bit == 0 { 0 } else { 255 };
        },
        2 => {
            let byte_idx = x as usize / 4;
            let bit_idx = (3 - (x as usize % 4)) * 2;
            let val = (scanline[byte_idx] >> bit_idx) & 3;
            g = val as u32 * 85;  // Scale 0-3 to 0-255
        },
        4 => {
            let byte_idx = x as usize / 2;
            let bit_idx = (1 - (x as usize % 2)) * 4;
            let val = (scanline[byte_idx] >> bit_idx) & 15;
            g = val as u32 * 17;  // Scale 0-15 to 0-255
        },
        8 => {
            g = scanline[x as usize] as u32;
        },
        16 => {
            let idx = x as usize * 2;
            g = scanline[idx] as u32;  // Use high byte only
        },
        _ => g = 0,
    }

    // Check transparency
    let a = if ctx.has_transparency && g == (ctx.trans_gray as u32 & 0xFF) {
        0
    } else {
        255
    };

    (a << 24) | (g << 16) | (g << 8) | g
}

fn extract_rgb(ctx: &PngContext, scanline: &[u8], x: u32) -> u32 {
    let (r, g, b): (u32, u32, u32);

    if ctx.bit_depth == 8 {
        let idx = x as usize * 3;
        r = scanline[idx] as u32;
        g = scanline[idx + 1] as u32;
        b = scanline[idx + 2] as u32;
    } else {
        // 16-bit
        let idx = x as usize * 6;
        r = scanline[idx] as u32;      // Use high byte
        g = scanline[idx + 2] as u32;
        b = scanline[idx + 4] as u32;
    }

    // Check transparency
    let a = if ctx.has_transparency &&
            r == (ctx.trans_rgb[0] as u32 & 0xFF) &&
            g == (ctx.trans_rgb[1] as u32 & 0xFF) &&
            b == (ctx.trans_rgb[2] as u32 & 0xFF) {
        0
    } else {
        255
    };

    (a << 24) | (r << 16) | (g << 8) | b
}

fn extract_indexed(ctx: &PngContext, scanline: &[u8], x: u32) -> u32 {
    let index: usize;

    match ctx.bit_depth {
        1 => {
            let byte_idx = x as usize / 8;
            let bit_idx = 7 - (x as usize % 8);
            index = ((scanline[byte_idx] >> bit_idx) & 1) as usize;
        },
        2 => {
            let byte_idx = x as usize / 4;
            let bit_idx = (3 - (x as usize % 4)) * 2;
            index = ((scanline[byte_idx] >> bit_idx) & 3) as usize;
        },
        4 => {
            let byte_idx = x as usize / 2;
            let bit_idx = (1 - (x as usize % 2)) * 4;
            index = ((scanline[byte_idx] >> bit_idx) & 15) as usize;
        },
        8 => {
            index = scanline[x as usize] as usize;
        },
        _ => index = 0,
    }

    if index < ctx.palette.len() {
        ctx.palette[index]
    } else {
        0xFF000000  // Default black
    }
}

fn extract_grayscale_alpha(ctx: &PngContext, scanline: &[u8], x: u32) -> u32 {
    let (g, a): (u32, u32);

    if ctx.bit_depth == 8 {
        let idx = x as usize * 2;
        g = scanline[idx] as u32;
        a = scanline[idx + 1] as u32;
    } else {
        // 16-bit
        let idx = x as usize * 4;
        g = scanline[idx] as u32;
        a = scanline[idx + 2] as u32;
    }

    (a << 24) | (g << 16) | (g << 8) | g
}

fn extract_rgba(ctx: &PngContext, scanline: &[u8], x: u32) -> u32 {
    let (r, g, b, a): (u32, u32, u32, u32);

    if ctx.bit_depth == 8 {
        let idx = x as usize * 4;
        r = scanline[idx] as u32;
        g = scanline[idx + 1] as u32;
        b = scanline[idx + 2] as u32;
        a = scanline[idx + 3] as u32;
    } else {
        // 16-bit
        let idx = x as usize * 8;
        r = scanline[idx] as u32;
        g = scanline[idx + 2] as u32;
        b = scanline[idx + 4] as u32;
        a = scanline[idx + 6] as u32;
    }

    (a << 24) | (r << 16) | (g << 8) | b
}
