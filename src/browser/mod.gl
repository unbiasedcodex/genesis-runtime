// ============================================================
// Browser Entry Point
// ============================================================

/// Start the Genesis Browser
pub fn start_browser() {
    let mut browser = Browser::new(1024, 768);

    // Navigate to default home page
    browser.navigate("about:blank");

    // Main event loop would be handled by the window manager
    // This is a placeholder for the actual integration
    println!("Genesis Browser (Geb) started");
    println!("Window size: {}x{}", browser.config.width, browser.config.height);
}

/// Create a browser with custom configuration
pub fn create_browser(config: BrowserConfig) -> Browser {
    Browser::with_config(config)
}

// ============================================================
// URL Handling
// ============================================================

/// Parse a URL into its components
pub struct ParsedUrl {
    pub scheme: String,
    pub host: String,
    pub port: Option<u16>,
    pub path: String,
    pub query: Option<String>,
    pub fragment: Option<String>,
}

impl ParsedUrl {
    pub fn parse(url: &str) -> Option<ParsedUrl> {
        let url = url.trim();

        // Handle special URLs
        if url.starts_with("about:") {
            return Some(ParsedUrl {
                scheme: "about".to_string(),
                host: String::new(),
                port: None,
                path: url[6..].to_string(),
                query: None,
                fragment: None,
            });
        }

        // Parse scheme
        let (scheme, rest) = if let Some(idx) = url.find("://") {
            (url[..idx].to_string(), &url[idx + 3..])
        } else {
            // Default to http
            ("http".to_string(), url)
        };

        // Parse fragment
        let (rest, fragment) = if let Some(idx) = rest.find('#') {
            (&rest[..idx], Some(rest[idx + 1..].to_string()))
        } else {
            (rest, None)
        };

        // Parse query
        let (rest, query) = if let Some(idx) = rest.find('?') {
            (&rest[..idx], Some(rest[idx + 1..].to_string()))
        } else {
            (rest, None)
        };

        // Parse host and path
        let (host_port, path) = if let Some(idx) = rest.find('/') {
            (&rest[..idx], rest[idx..].to_string())
        } else {
            (rest, "/".to_string())
        };

        // Parse port from host
        let (host, port) = if let Some(idx) = host_port.find(':') {
            let port_str = &host_port[idx + 1..];
            let port = port_str.parse::<u16>().ok();
            (host_port[..idx].to_string(), port)
        } else {
            (host_port.to_string(), None)
        };

        Some(ParsedUrl {
            scheme,
            host,
            port,
            path,
            query,
            fragment,
        })
    }

    /// Get the effective port (default based on scheme if not specified)
    pub fn effective_port(&self) -> u16 {
        self.port.unwrap_or_else(|| {
            match self.scheme.as_str() {
                "https" => 443,
                "http" => 80,
                "ftp" => 21,
                _ => 80,
            }
        })
    }

    /// Convert back to string
    pub fn to_string(&self) -> String {
        let mut result = format!("{}://", self.scheme);

        if !self.host.is_empty() {
            result.push_str(&self.host);
            if let Some(port) = self.port {
                result.push_str(&format!(":{}", port));
            }
        }

        result.push_str(&self.path);

        if let Some(ref query) = self.query {
            result.push('?');
            result.push_str(query);
        }

        if let Some(ref fragment) = self.fragment {
            result.push('#');
            result.push_str(fragment);
        }

        result
    }

    /// Resolve a relative URL against this base URL
    pub fn resolve(&self, relative: &str) -> ParsedUrl {
        let relative = relative.trim();

        // Absolute URL
        if relative.contains("://") {
            return ParsedUrl::parse(relative).unwrap_or_else(|| self.clone());
        }

        // Protocol-relative
        if relative.starts_with("//") {
            return ParsedUrl::parse(&format!("{}:{}", self.scheme, relative))
                .unwrap_or_else(|| self.clone());
        }

        // Absolute path
        if relative.starts_with('/') {
            let mut result = self.clone();

            // Parse path, query, fragment from relative
            let (path, rest) = if let Some(idx) = relative.find('?') {
                (&relative[..idx], &relative[idx..])
            } else if let Some(idx) = relative.find('#') {
                (&relative[..idx], &relative[idx..])
            } else {
                (relative, "")
            };

            result.path = path.to_string();

            if rest.starts_with('?') {
                if let Some(idx) = rest.find('#') {
                    result.query = Some(rest[1..idx].to_string());
                    result.fragment = Some(rest[idx + 1..].to_string());
                } else {
                    result.query = Some(rest[1..].to_string());
                    result.fragment = None;
                }
            } else if rest.starts_with('#') {
                result.query = None;
                result.fragment = Some(rest[1..].to_string());
            } else {
                result.query = None;
                result.fragment = None;
            }

            return result;
        }

        // Fragment only
        if relative.starts_with('#') {
            let mut result = self.clone();
            result.fragment = Some(relative[1..].to_string());
            return result;
        }

        // Query only
        if relative.starts_with('?') {
            let mut result = self.clone();
            if let Some(idx) = relative.find('#') {
                result.query = Some(relative[1..idx].to_string());
                result.fragment = Some(relative[idx + 1..].to_string());
            } else {
                result.query = Some(relative[1..].to_string());
                result.fragment = None;
            }
            return result;
        }

        // Relative path
        let mut result = self.clone();

        // Get directory of current path
        let base_dir = if let Some(idx) = self.path.rfind('/') {
            &self.path[..idx + 1]
        } else {
            "/"
        };

        // Combine with relative path
        let combined = format!("{}{}", base_dir, relative);

        // Normalize path (handle . and ..)
        result.path = normalize_path(&combined);
        result.query = None;
        result.fragment = None;

        // Parse query and fragment from relative
        if let Some(idx) = relative.find('?') {
            let rest = &relative[idx..];
            if let Some(frag_idx) = rest.find('#') {
                result.query = Some(rest[1..frag_idx].to_string());
                result.fragment = Some(rest[frag_idx + 1..].to_string());
            } else {
                result.query = Some(rest[1..].to_string());
            }
        } else if let Some(idx) = relative.find('#') {
            result.fragment = Some(relative[idx + 1..].to_string());
        }

        result
    }

    fn clone(&self) -> ParsedUrl {
        ParsedUrl {
            scheme: self.scheme.clone(),
            host: self.host.clone(),
            port: self.port,
            path: self.path.clone(),
            query: self.query.clone(),
            fragment: self.fragment.clone(),
        }
    }
}

/// Normalize a URL path (resolve . and ..)
fn normalize_path(path: &str) -> String {
    let mut segments: Vec<&str> = Vec::new();

    for segment in path.split('/') {
        match segment {
            "" | "." => {
                // Skip empty and current directory
            }
            ".." => {
                // Go up one directory
                segments.pop();
            }
            s => {
                segments.push(s);
            }
        }
    }

    let mut result = String::from("/");
    result.push_str(&segments.join("/"));

    // Preserve trailing slash
    if path.ends_with('/') && !result.ends_with('/') {
        result.push('/');
    }

    result
}

