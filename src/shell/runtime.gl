// Genesis Runtime Library for Shell Server
// Syscall wrappers for userspace shell

// ============================================================================
// Syscall Numbers (must match kernel)
// ============================================================================

pub const SYS_YIELD: i64 = 0;
pub const SYS_GETPID: i64 = 1;
pub const SYS_PRINT: i64 = 2;
pub const SYS_SEND: i64 = 3;
pub const SYS_RECV: i64 = 4;
pub const SYS_EXIT: i64 = 5;

// Keyboard syscalls
pub const SYS_KB_READ: i64 = 16;
pub const SYS_KB_AVAIL: i64 = 17;

// ELF Loader syscall
pub const SYS_EXEC: i64 = 18;

// Signal syscalls
pub const SYS_KILL: i64 = 19;
pub const SYS_WAIT: i64 = 20;
pub const SYS_GETPPID: i64 = 21;

// Disk syscalls
pub const SYS_DISK_READ: i64 = 25;
pub const SYS_DISK_INFO: i64 = 26;

// VGA syscalls
pub const SYS_VGA_PUTCHAR: i64 = 36;
pub const SYS_VGA_SETCURSOR: i64 = 37;
pub const SYS_VGA_CLEAR: i64 = 38;
pub const SYS_VGA_SCROLL: i64 = 39;

// Capability syscalls
pub const SYS_CAP_LIST: i64 = 15;

// RAMFS syscalls
pub const SYS_RAMFS_FILE_COUNT: i64 = 40;
pub const SYS_RAMFS_FILE_INFO: i64 = 41;
pub const SYS_RAMFS_READ_BYTE: i64 = 42;
pub const SYS_RAMFS_FILE_SIZE: i64 = 43;
pub const SYS_RAMFS_READ_NAME: i64 = 46;

// Process info syscalls
pub const SYS_PROC_COUNT: i64 = 44;
pub const SYS_PROC_STATE: i64 = 45;

// Time syscalls
pub const SYS_TIME: i64 = 34;

// ============================================================================
// Low-level Syscall Functions
// ============================================================================

fn syscall0(num: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn syscall1(num: i64, arg1: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn syscall2(num: i64, arg1: i64, arg2: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn syscall3(num: i64, arg1: i64, arg2: i64, arg3: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn syscall4(num: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            in("r10") arg4,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// For framebuffer syscalls that use R8/R9 for args 4/5
fn syscall5_fb(num: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64, arg5: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            in("r8") arg4,
            in("r9") arg5,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// For framebuffer syscalls that use R8 for arg4
fn syscall4_fb(num: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            in("r8") arg4,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// ============================================================================
// Process Management
// ============================================================================

pub fn yield_cpu() {
    syscall0(SYS_YIELD);
}

pub fn getpid() -> i64 {
    syscall0(SYS_GETPID)
}

pub fn exit() {
    syscall0(SYS_EXIT);
}

pub fn getppid() -> i64 {
    syscall0(SYS_GETPPID)
}

// ============================================================================
// Serial I/O (for debugging)
// ============================================================================

pub fn print_char(c: i64) {
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") 2,      // SYS_PRINT = 2 (literal constant)
            in("rdi") c,
            lateout("rax") _,
            options(nostack, att_syntax)
        );
    }
}

pub fn print_num(n: i64) {
    if n < 0 {
        print_char(45);  // '-'
        print_num(0 - n);
        return;
    }
    if n >= 10 {
        print_num(n / 10);
    }
    print_char(48 + (n % 10));
}

pub fn print_str8(s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64) {
    if s0 != 0 { print_char(s0); }
    if s1 != 0 { print_char(s1); }
    if s2 != 0 { print_char(s2); }
    if s3 != 0 { print_char(s3); }
    if s4 != 0 { print_char(s4); }
    if s5 != 0 { print_char(s5); }
    if s6 != 0 { print_char(s6); }
    if s7 != 0 { print_char(s7); }
}

pub fn print_newline() {
    print_char(10);
}

// ============================================================================
// IPC - Inter-Process Communication
// ============================================================================

pub fn send(dest_pid: i64, msg: i64) -> i64 {
    syscall2(SYS_SEND, dest_pid, msg)
}

pub fn recv() -> i64 {
    syscall0(SYS_RECV)
}

// ============================================================================
// Keyboard Access
// ============================================================================

// Read character from keyboard buffer
// Returns: ASCII character, or -1 if buffer empty
pub fn kb_read() -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") 16,  // SYS_KB_READ = 16 (literal constant)
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// Check if keyboard buffer has data
// Returns: 1 if data available, 0 otherwise
pub fn kb_avail() -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") 17,  // SYS_KB_AVAIL = 17 (literal constant)
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// ============================================================================
// VGA Access
// ============================================================================

// Write character at position with color
// x: column (0-79), y: row (0-24), ch: ASCII char, color: attribute byte
pub fn vga_putchar(x: i64, y: i64, ch: i64, color: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") 36,  // SYS_VGA_PUTCHAR = 36 (literal)
            in("rdi") x,
            in("rsi") y,
            in("rdx") ch,
            in("r10") color,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// Set hardware cursor position
// x: column (0-79), y: row (0-24)
pub fn vga_setcursor(x: i64, y: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") 37,  // SYS_VGA_SETCURSOR = 37 (literal)
            in("rdi") x,
            in("rsi") y,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// Clear screen region
// y_start: first row, y_end: last row (exclusive), color: fill color
pub fn vga_clear(y_start: i64, y_end: i64, color: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") 38,  // SYS_VGA_CLEAR = 38 (literal)
            in("rdi") y_start,
            in("rsi") y_end,
            in("rdx") color,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// Scroll screen region up by one line
// y_start: first row, y_end: last row (exclusive), color: fill color for new line
pub fn vga_scroll(y_start: i64, y_end: i64, color: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") 39,  // SYS_VGA_SCROLL = 39 (literal)
            in("rdi") y_start,
            in("rsi") y_end,
            in("rdx") color,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// ============================================================================
// Process Execution
// ============================================================================

// Execute ELF binary from RAMFS
// name_lo: packed filename (first 8 chars in little-endian)
// Returns: new PID on success, negative error on failure
pub fn exec(name_lo: i64) -> i64 {
    syscall1(SYS_EXEC, name_lo)
}

// ============================================================================
// Signal Management
// ============================================================================

// Send signal to process
// pid: target process ID
// signum: signal number (e.g., 15=SIGTERM, 9=SIGKILL)
// Returns: 0 on success, negative error on failure
pub fn kill(pid: i64, signum: i64) -> i64 {
    syscall2(SYS_KILL, pid, signum)
}

// Wait flags
pub const WAIT_NOHANG: i64 = 1;

// Wait for child process to change state
// pid: process ID to wait for (-1 for any child)
// flags: WAIT_NOHANG=1 for non-blocking
// Returns: terminated child PID, 0 if NOHANG and no zombie, or negative error
pub fn wait(pid: i64, flags: i64) -> i64 {
    syscall2(SYS_WAIT, pid, flags)
}

// Non-blocking wait to reap any zombie children
// Returns: reaped child PID, or 0 if no zombies
pub fn reap_zombies() -> i64 {
    wait(0 - 1, WAIT_NOHANG)  // -1 = any child, WAIT_NOHANG = non-blocking
}

// ============================================================================
// Disk Access
// ============================================================================

// Read disk sectors
// lba: logical block address
// count: number of sectors to read
// buffer: destination address
// Returns: bytes read, or negative error
pub fn disk_read(lba: i64, count: i64, buffer: i64) -> i64 {
    syscall3(SYS_DISK_READ, lba, count, buffer)
}

// Get disk information
// info_type: 0=present, 1=total_sectors
// Returns: requested value
pub fn disk_info(info_type: i64) -> i64 {
    syscall1(SYS_DISK_INFO, info_type)
}

// ============================================================================
// RAMFS Access
// ============================================================================

// Get number of files in RAMFS
pub fn ramfs_file_count() -> i64 {
    syscall0(SYS_RAMFS_FILE_COUNT)
}

// Get file info (flags)
// file_idx: file index
// Returns: file flags (0=unused, 1=regular file)
pub fn ramfs_file_info(file_idx: i64) -> i64 {
    syscall1(SYS_RAMFS_FILE_INFO, file_idx)
}

// Get file size
// file_idx: file index
// Returns: file size in bytes
pub fn ramfs_file_size(file_idx: i64) -> i64 {
    syscall1(SYS_RAMFS_FILE_SIZE, file_idx)
}

// Read byte from file
// file_idx: file index
// offset: byte offset within file
// Returns: byte value (0-255), or negative error
pub fn ramfs_read_byte(file_idx: i64, offset: i64) -> i64 {
    syscall2(SYS_RAMFS_READ_BYTE, file_idx, offset)
}

// Read filename character
// file_idx: file index
// char_idx: character index (0-7)
// Returns: ASCII character, or 0 if past end
pub fn ramfs_read_name(file_idx: i64, char_idx: i64) -> i64 {
    syscall2(SYS_RAMFS_READ_NAME, file_idx, char_idx)
}

// ============================================================================
// Capability Access
// ============================================================================

// Get capability info at index
// cap_idx: capability slot index (0-3)
// Returns: packed info (type * 65536 + target * 256 + rights), or negative error
pub fn cap_list(cap_idx: i64) -> i64 {
    syscall1(SYS_CAP_LIST, cap_idx)
}

// ============================================================================
// Process Info Access
// ============================================================================

// Get number of active processes
// Returns: count of processes
pub fn proc_count() -> i64 {
    syscall0(SYS_PROC_COUNT)
}

// Get process state by PID
// pid: process ID
// Returns: state (0=unused, 1=ready, 2=running, 3=waiting, 4=zombie, 5=stopped)
pub fn proc_state(pid: i64) -> i64 {
    syscall1(SYS_PROC_STATE, pid)
}

// ============================================================================
// Time Access
// ============================================================================

// Get current tick count (system uptime in timer ticks)
// Returns: number of ticks since boot
pub fn time() -> i64 {
    syscall0(SYS_TIME)
}

// ============================================================================
// IPC Message Helpers
// ============================================================================

// VFS command types
pub const VFS_OPEN: i64 = 1;
pub const VFS_READ: i64 = 2;
pub const VFS_STAT: i64 = 5;
pub const VFS_LIST: i64 = 8;

// VFS server PID
pub const VFS_PID: i64 = 2;

// Pack a VFS request message
// cmd: command type
// sender: sender PID (included so VFS knows who to respond to)
// d0-d5: additional data bytes
pub fn pack_vfs_request(cmd: i64, sender: i64, d0: i64, d1: i64, d2: i64, d3: i64, d4: i64, d5: i64) -> i64 {
    (cmd % 256) +
    ((sender % 256) * 256) +
    ((d0 % 256) * 65536) +
    ((d1 % 256) * 16777216) +
    ((d2 % 256) * 0x100000000) +
    ((d3 % 256) * 0x10000000000) +
    ((d4 % 256) * 0x1000000000000) +
    ((d5 % 256) * 0x100000000000000)
}

// Extract byte from packed message
pub fn msg_byte(msg: i64, index: i64) -> i64 {
    if index == 0 { return msg % 256; }
    if index == 1 { return (msg / 256) % 256; }
    if index == 2 { return (msg / 65536) % 256; }
    if index == 3 { return (msg / 16777216) % 256; }
    if index == 4 { return (msg / 0x100000000) % 256; }
    if index == 5 { return (msg / 0x10000000000) % 256; }
    if index == 6 { return (msg / 0x1000000000000) % 256; }
    if index == 7 { return (msg / 0x100000000000000) % 256; }
    0
}

// Send VFS request and wait for response
// Returns the response message
pub fn vfs_request(request: i64) -> i64 {
    // Send request to VFS server
    send(VFS_PID, request);

    // Wait for response (simple polling loop)
    let mut response: i64 = 0;
    let mut attempts: i64 = 0;
    while response == 0 && attempts < 10000 {
        response = recv();
        if response == 0 {
            yield_cpu();
        }
        attempts = attempts + 1;
    }
    response
}

// ============================================================================
// Network Syscalls
// ============================================================================

pub const SYS_NET_SOCKET: i64 = 50;
pub const SYS_NET_BIND: i64 = 51;
pub const SYS_NET_LISTEN: i64 = 52;
pub const SYS_NET_ACCEPT: i64 = 53;
pub const SYS_NET_CONNECT: i64 = 54;
pub const SYS_NET_SEND: i64 = 55;
pub const SYS_NET_RECV: i64 = 56;
pub const SYS_NET_CLOSE: i64 = 57;
pub const SYS_NET_CONFIG: i64 = 58;
pub const SYS_NET_STATUS: i64 = 59;
pub const SYS_NET_RESOLVE: i64 = 60;
pub const SYS_NET_PING: i64 = 61;
pub const SYS_NET_ARP: i64 = 62;
pub const SYS_NET_DHCP: i64 = 63;
pub const SYS_NET_GETIP: i64 = 64;
pub const SYS_NET_GETMAC: i64 = 65;
pub const SYS_NET_POLL: i64 = 66;

// Network status info types
pub const NET_STATUS_LINK: i64 = 0;       // Link up/down
pub const NET_STATUS_RX_COUNT: i64 = 1;   // RX packet count
pub const NET_STATUS_TX_COUNT: i64 = 2;   // TX packet count
pub const NET_STATUS_INIT: i64 = 3;       // Stack initialized

// Socket types
pub const SOCK_STREAM: i64 = 1;   // TCP
pub const SOCK_DGRAM: i64 = 2;    // UDP

// Get network status
// status_type: 0=link, 1=rx_count, 2=tx_count, 3=initialized
pub fn net_status(status_type: i64) -> i64 {
    syscall1(SYS_NET_STATUS, status_type)
}

// Get current IP address (packed format)
pub fn net_getip() -> i64 {
    syscall0(SYS_NET_GETIP)
}

// Get MAC address bytes
// Returns low 4 bytes when idx=0, high 2 bytes when idx=1
pub fn net_getmac(idx: i64) -> i64 {
    syscall1(SYS_NET_GETMAC, idx)
}

// Configure network (static IP)
// ip, mask, gateway: packed IP addresses (a.b.c.d = a*16777216 + b*65536 + c*256 + d)
pub fn net_config(ip: i64, mask: i64, gateway: i64) -> i64 {
    syscall3(SYS_NET_CONFIG, ip, mask, gateway)
}

// Start DHCP auto-configuration
pub fn net_dhcp() -> i64 {
    syscall0(SYS_NET_DHCP)
}

// Ping an IP address
// target_ip: packed IP address
// timeout: timeout in ticks
// Returns: RTT in ticks, or negative error
pub fn net_ping(target_ip: i64, timeout: i64) -> i64 {
    syscall2(SYS_NET_PING, target_ip, timeout)
}

// Resolve hostname to IP via DNS
// hostname_addr: address of hostname string
// Returns: packed IP address, or 0 on failure
pub fn net_resolve(hostname_addr: i64) -> i64 {
    syscall1(SYS_NET_RESOLVE, hostname_addr)
}

// ARP lookup
// ip: packed IP address
// Returns: MAC address (packed), or 0 if not found
pub fn net_arp_lookup(ip: i64) -> i64 {
    syscall1(SYS_NET_ARP, ip)
}

// Create network socket
// sock_type: 1=SOCK_STREAM (TCP), 2=SOCK_DGRAM (UDP)
// Returns: socket ID, or negative error
pub fn net_socket(sock_type: i64) -> i64 {
    // Socket syscall expects: domain (AF_INET=2), sock_type, protocol (0=default)
    let domain: i64 = 2;  // AF_INET
    let protocol: i64 = 0;  // Default protocol
    syscall3(SYS_NET_SOCKET, domain, sock_type, protocol)
}

// Bind socket to port
pub fn net_bind(sock_id: i64, port: i64) -> i64 {
    syscall2(SYS_NET_BIND, sock_id, port)
}

// Connect socket to remote address
pub fn net_connect(sock_id: i64, ip: i64, port: i64) -> i64 {
    syscall3(SYS_NET_CONNECT, sock_id, ip, port)
}

// Send data on socket
pub fn net_send_data(sock_id: i64, data_addr: i64, len: i64) -> i64 {
    syscall3(SYS_NET_SEND, sock_id, data_addr, len)
}

// Receive data from socket
pub fn net_recv_data(sock_id: i64, buf_addr: i64, max_len: i64) -> i64 {
    syscall3(SYS_NET_RECV, sock_id, buf_addr, max_len)
}

// Close socket
pub fn net_close(sock_id: i64) -> i64 {
    syscall1(SYS_NET_CLOSE, sock_id)
}

// Poll network (process pending packets)
pub fn net_poll() -> i64 {
    syscall0(SYS_NET_POLL)
}

// ============================================================================
// Network Helpers
// ============================================================================

// Pack IP address from components (a.b.c.d)
pub fn pack_ip(a: i64, b: i64, c: i64, d: i64) -> i64 {
    (a * 16777216) + (b * 65536) + (c * 256) + d
}

// Extract IP component (0=a, 1=b, 2=c, 3=d from a.b.c.d)
pub fn ip_byte(ip: i64, idx: i64) -> i64 {
    if idx == 0 { return (ip / 16777216) % 256; }
    if idx == 1 { return (ip / 65536) % 256; }
    if idx == 2 { return (ip / 256) % 256; }
    ip % 256
}

// ============================================================================
// Framebuffer Graphics Syscalls
// ============================================================================

pub const SYS_FB_INFO: i64 = 70;
pub const SYS_FB_PIXEL: i64 = 71;
pub const SYS_FB_RECT: i64 = 72;
pub const SYS_FB_SWAP: i64 = 73;
pub const SYS_FB_CLEAR: i64 = 74;
pub const SYS_FB_BLIT: i64 = 75;
pub const SYS_FB_MAP: i64 = 76;
pub const SYS_FB_CHAR: i64 = 77;
pub const SYS_FB_TEXT: i64 = 78;

// Get framebuffer info (returns width << 32 | height, or packed info)
pub fn fb_info(query: i64) -> i64 {
    syscall1(SYS_FB_INFO, query)
}

// Draw a single pixel
pub fn fb_pixel(x: i64, y: i64, color: i64) -> i64 {
    syscall3(SYS_FB_PIXEL, x, y, color)
}

// Draw a filled rectangle (uses R8/R9 for args 4/5)
pub fn fb_rect(x: i64, y: i64, w: i64, h: i64, color: i64) -> i64 {
    syscall5_fb(SYS_FB_RECT, x, y, w, h, color)
}

// Swap buffers (display back buffer)
pub fn fb_swap() -> i64 {
    syscall0(SYS_FB_SWAP)
}

// Clear framebuffer with color
pub fn fb_clear(color: i64) -> i64 {
    syscall1(SYS_FB_CLEAR, color)
}

// Draw character at position (uses R8 for arg4)
pub fn fb_char(x: i64, y: i64, ch: i64, color: i64) -> i64 {
    syscall4_fb(SYS_FB_CHAR, x, y, ch, color)
}

// Draw text string at position (text_addr is pointer to null-terminated string)
pub fn fb_text(x: i64, y: i64, text_addr: i64, color: i64) -> i64 {
    syscall4_fb(SYS_FB_TEXT, x, y, text_addr, color)
}
