// Genesis Shell Built-in Commands
// All shell commands are implemented here

mod runtime;

// ============================================================================
// Shell Constants
// ============================================================================

pub const VGA_WIDTH: i64 = 80;
pub const VGA_HEIGHT: i64 = 25;
pub const CONSOLE_START_ROW: i64 = 14;

pub const COLOR_WHITE: i64 = 0x0F;
pub const COLOR_GREEN: i64 = 0x0A;

// Signal numbers
pub const SIGTERM: i64 = 15;

// Line buffer in BSS section (0xB08000-0xB0A000, 8KB)
// This is a separate RW segment loaded by the kernel
pub const LINE_BUFFER_ADDR: i64 = 0xB08000;   // Shell line buffer (256 bytes)
pub const LINE_LEN_ADDR: i64 = 0xB08100;      // Line length (8 bytes)
pub const CURSOR_X_ADDR: i64 = 0xB08108;      // Cursor X (8 bytes)
pub const CURSOR_Y_ADDR: i64 = 0xB08110;      // Cursor Y (8 bytes)
pub const DISK_BUFFER_ADDR: i64 = 0xB08200;   // 4KB disk buffer

pub const LINE_MAX: i64 = 80;

// Capability types
pub const CAP_TYPE_UNUSED: i64 = 0;
pub const CAP_TYPE_IPC: i64 = 1;
pub const CAP_TYPE_FILE: i64 = 2;
pub const CAP_TYPE_MEM: i64 = 3;
pub const CAP_TYPE_ROOT: i64 = 4;

// Process states
pub const PROC_STATE_UNUSED: i64 = 0;
pub const PROC_STATE_READY: i64 = 1;
pub const PROC_STATE_RUNNING: i64 = 2;
pub const PROC_STATE_WAITING: i64 = 3;
pub const PROC_STATE_ZOMBIE: i64 = 4;
pub const PROC_STATE_STOPPED: i64 = 5;

// ============================================================================
// Memory Access Helpers
// ============================================================================

pub fn read_byte(addr: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "movzbl (%rdi), %eax",
            in("rdi") addr,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

pub fn write_byte(addr: i64, val: i64) {
    unsafe {
        asm!(
            "movb %sil, (%rdi)",
            in("rdi") addr,
            in("rsi") val,
            options(nostack, att_syntax)
        );
    }
}

pub fn read_u64(addr: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "movq (%rdi), %rax",
            in("rdi") addr,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

pub fn write_u64(addr: i64, val: i64) {
    unsafe {
        asm!(
            "movq %rsi, (%rdi)",
            in("rdi") addr,
            in("rsi") val,
            options(nostack, att_syntax)
        );
    }
}

// ============================================================================
// Cursor and Line Buffer Management
// Now using clean code - compiler constant propagation bug has been fixed!
// ============================================================================

pub fn cursor_x() -> i64 {
    read_u64(CURSOR_X_ADDR)
}

pub fn cursor_y() -> i64 {
    read_u64(CURSOR_Y_ADDR)
}

pub fn set_cursor_x(x: i64) {
    write_u64(CURSOR_X_ADDR, x);
}

pub fn set_cursor_y(y: i64) {
    write_u64(CURSOR_Y_ADDR, y);
}

pub fn line_len() -> i64 {
    read_u64(LINE_LEN_ADDR)
}

pub fn set_line_len(len: i64) {
    write_u64(LINE_LEN_ADDR, len);
}

pub fn line_get(idx: i64) -> i64 {
    read_byte(LINE_BUFFER_ADDR + idx)
}

pub fn line_set(idx: i64, ch: i64) {
    write_byte(LINE_BUFFER_ADDR + idx, ch);
}

pub fn line_clear() {
    set_line_len(0);
    let mut i: i64 = 0;
    while i < LINE_MAX {
        line_set(i, 0);
        i = i + 1;
    }
}

// ============================================================================
// Console Output Helpers
// ============================================================================

// Write character at cursor and advance
// Note: Column 0 has a bug where characters disappear, so we use column 1 as minimum
pub fn putchar(ch: i64) {
    let mut cx = cursor_x();
    let mut cy = cursor_y();

    if ch == 10 {
        // Newline: move to next row, start at column 1 (workaround for col 0 bug)
        cx = 1;
        cy = cy + 1;
    } else if ch == 8 {
        // Backspace: move back if possible
        if cx > 2 {  // Don't erase prompt "> "
            cx = cx - 1;
            runtime::vga_putchar(cx, cy, 32, COLOR_WHITE);  // Clear char
        }
    } else {
        // Regular character
        runtime::vga_putchar(cx, cy, ch, COLOR_WHITE);
        cx = cx + 1;
    }

    // Wrap at end of line
    if cx >= VGA_WIDTH {
        cx = 1;  // Start at column 1 (workaround for col 0 bug)
        cy = cy + 1;
    }

    // Scroll if needed (simple: reset to start row)
    if cy >= VGA_HEIGHT {
        cy = CONSOLE_START_ROW;
        clear_area();
    }

    set_cursor_x(cx);
    set_cursor_y(cy);
}

// Print string (up to 8 chars)
pub fn print_str(s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64) {
    if s0 != 0 { putchar(s0); }
    if s1 != 0 { putchar(s1); }
    if s2 != 0 { putchar(s2); }
    if s3 != 0 { putchar(s3); }
    if s4 != 0 { putchar(s4); }
    if s5 != 0 { putchar(s5); }
    if s6 != 0 { putchar(s6); }
    if s7 != 0 { putchar(s7); }
}

// Print decimal number
pub fn print_dec(value: i64) {
    if value == 0 {
        putchar(48);
        return;
    }

    let mut num = value;
    if num < 0 {
        putchar(45);  // '-'
        num = 0 - num;
    }

    // Count digits
    let mut temp = num;
    let mut digits: i64 = 0;
    while temp > 0 {
        temp = temp / 10;
        digits = digits + 1;
    }

    // Print digits
    let mut divisor: i64 = 1;
    let mut d: i64 = 1;
    while d < digits {
        divisor = divisor * 10;
        d = d + 1;
    }

    while divisor > 0 {
        let digit = num / divisor;
        putchar(48 + digit);
        num = num - (digit * divisor);
        divisor = divisor / 10;
    }
}

// Clear the shell display area
pub fn clear_area() {
    runtime::vga_clear(CONSOLE_START_ROW, VGA_HEIGHT, COLOR_WHITE);
}

// Show shell prompt
pub fn prompt() {
    let cx = cursor_x();
    let cy = cursor_y();

    runtime::vga_putchar(cx, cy, 62, COLOR_GREEN);      // >
    runtime::vga_putchar(cx + 1, cy, 32, COLOR_GREEN);  // space

    set_cursor_x(cx + 2);
}

// ============================================================================
// Command Matching
// ============================================================================

// Compare line buffer with command (up to 8 chars)
pub fn cmd_match(c0: i64, c1: i64, c2: i64, c3: i64, c4: i64, c5: i64, c6: i64, c7: i64) -> bool {
    let b0 = line_get(0);
    let b1 = line_get(1);
    let b2 = line_get(2);
    let b3 = line_get(3);
    let b4 = line_get(4);
    let b5 = line_get(5);
    let b6 = line_get(6);
    let b7 = line_get(7);

    b0 == c0 && b1 == c1 && b2 == c2 && b3 == c3 &&
    b4 == c4 && b5 == c5 && b6 == c6 && b7 == c7
}

// ============================================================================
// Built-in Commands
// ============================================================================

// Command: help
pub fn cmd_help() {
    // "Commands:"
    print_str(67, 111, 109, 109, 97, 110, 100, 115);  // Commands
    putchar(58);  // :
    putchar(10);  // newline

    // "  help  - show this"
    print_str(32, 32, 104, 101, 108, 112, 0, 0);
    putchar(10);

    // "  ps    - processes"
    print_str(32, 32, 112, 115, 0, 0, 0, 0);
    putchar(10);

    // "  caps  - capabilities"
    print_str(32, 32, 99, 97, 112, 115, 0, 0);
    putchar(10);

    // "  files - list files"
    print_str(32, 32, 102, 105, 108, 101, 115, 0);
    putchar(10);

    // "  echo  - echo text"
    print_str(32, 32, 101, 99, 104, 111, 0, 0);
    putchar(10);

    // "  clear - clear screen"
    print_str(32, 32, 99, 108, 101, 97, 114, 0);
    putchar(10);

    // "  run   - run program"
    print_str(32, 32, 114, 117, 110, 0, 0, 0);
    putchar(10);

    // "  kill  - signal proc"
    print_str(32, 32, 107, 105, 108, 108, 0, 0);
    putchar(10);

    // "  disk  - disk info"
    print_str(32, 32, 100, 105, 115, 107, 0, 0);
    putchar(10);

    // "  sector - read sector"
    print_str(32, 32, 115, 101, 99, 116, 111, 114);
    putchar(10);
}

// Command: ps - show processes
pub fn cmd_ps() {
    // Print header
    print_str(80, 73, 68, 32, 83, 84, 65, 84);  // "PID STAT"
    putchar(10);

    // Get process count via syscall
    let num_procs = runtime::proc_count();
    let mut pid: i64 = 0;
    while pid < num_procs {
        let state = runtime::proc_state(pid);
        if state != PROC_STATE_UNUSED {
            // Print PID
            putchar(48 + pid);
            putchar(32);
            putchar(32);
            putchar(32);

            // Print state
            if state == PROC_STATE_READY {
                print_str(82, 69, 65, 68, 89, 0, 0, 0);    // READY
            } else if state == PROC_STATE_RUNNING {
                print_str(82, 85, 78, 0, 0, 0, 0, 0);      // RUN
            } else if state == PROC_STATE_WAITING {
                print_str(87, 65, 73, 84, 0, 0, 0, 0);     // WAIT
            } else if state == PROC_STATE_ZOMBIE {
                print_str(90, 79, 77, 66, 73, 69, 0, 0);   // ZOMBIE
            } else if state == PROC_STATE_STOPPED {
                print_str(83, 84, 79, 80, 0, 0, 0, 0);     // STOP
            }
            putchar(10);
        }
        pid = pid + 1;
    }
}

// Command: caps - show capabilities for current process
pub fn cmd_caps() {
    let pid = runtime::getpid();

    print_str(67, 65, 80, 83, 32, 80, 0, 0);  // "CAPS P"
    putchar(48 + pid);
    putchar(58);
    putchar(10);

    // List capabilities using SYS_CAP_LIST
    let mut i: i64 = 0;
    while i < 4 {
        let cap_info = runtime::cap_list(i);
        if cap_info >= 0 {
            // Extract type from packed value: (type * 65536) + (target * 256) + rights
            let cap_type = cap_info / 65536;
            if cap_type != CAP_TYPE_UNUSED {
                putchar(48 + i);  // index
                putchar(58);
                putchar(32);

                if cap_type == CAP_TYPE_ROOT {
                    print_str(82, 79, 79, 84, 0, 0, 0, 0);  // ROOT
                } else if cap_type == CAP_TYPE_IPC {
                    print_str(73, 80, 67, 0, 0, 0, 0, 0);   // IPC
                } else if cap_type == CAP_TYPE_FILE {
                    print_str(70, 73, 76, 69, 0, 0, 0, 0);  // FILE
                }
                putchar(10);
            }
        }
        i = i + 1;
    }
}

// Command: files - list files
pub fn cmd_files() {
    print_str(70, 105, 108, 101, 115, 58, 0, 0);  // "Files:"
    putchar(10);

    let used = runtime::ramfs_file_count();
    let mut i: i64 = 0;
    while i < used {
        let flags = runtime::ramfs_file_info(i);
        if flags != 0 {
            // Print file index
            putchar(48 + i);
            putchar(58);
            putchar(32);

            // Read and print filename (first 8 chars)
            let mut j: i64 = 0;
            while j < 8 {
                let ch = runtime::ramfs_read_name(i, j);
                if ch != 0 {
                    putchar(ch);
                }
                j = j + 1;
            }

            // Print size
            putchar(32);
            putchar(40);  // (
            let size = runtime::ramfs_file_size(i);
            if size < 10 {
                putchar(48 + size);
            } else if size < 100 {
                putchar(48 + (size / 10) % 10);
                putchar(48 + size % 10);
            } else {
                print_dec(size);
            }
            putchar(66);  // B
            putchar(41);  // )
            putchar(10);
        }
        i = i + 1;
    }
}

// Command: echo - echo remaining input
pub fn cmd_echo() {
    let len = line_len();
    // Skip "echo " (5 chars)
    let mut i: i64 = 5;
    while i < len {
        let ch = line_get(i);
        if ch != 0 {
            putchar(ch);
        }
        i = i + 1;
    }
    putchar(10);
}

// Command: clear - clear shell area
pub fn cmd_clear() {
    clear_area();
    set_cursor_x(0);
    set_cursor_y(CONSOLE_START_ROW);
}

// Command: run <filename> - execute ELF binary
pub fn cmd_run() {
    // Get filename starting at position 4 (after "run ")
    let c0 = line_get(4);
    let c1 = line_get(5);
    let c2 = line_get(6);
    let c3 = line_get(7);
    let c4 = line_get(8);
    let c5 = line_get(9);
    let c6 = line_get(10);
    let c7 = line_get(11);

    // Pack filename into i64 (little-endian)
    let name_lo = c0 + (c1 * 256) + (c2 * 65536) + (c3 * 16777216) +
                  (c4 * 0x100000000) + (c5 * 0x10000000000) +
                  (c6 * 0x1000000000000) + (c7 * 0x100000000000000);

    // Print "run: "
    print_str(114, 117, 110, 58, 32, 0, 0, 0);  // "run: "

    // Print filename
    if c0 > 0 { putchar(c0); }
    if c1 > 0 { putchar(c1); }
    if c2 > 0 { putchar(c2); }
    if c3 > 0 { putchar(c3); }
    if c4 > 0 { putchar(c4); }
    if c5 > 0 { putchar(c5); }
    if c6 > 0 { putchar(c6); }
    if c7 > 0 { putchar(c7); }
    putchar(10);

    // Execute the ELF file
    let result = runtime::exec(name_lo);

    if result >= 0 {
        // Print "PID: N"
        print_str(80, 73, 68, 58, 32, 0, 0, 0);  // "PID: "
        putchar(48 + result);
        putchar(10);
    } else {
        // Print error
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        putchar(48 - result);  // error code as digit
        putchar(10);
    }
}

// Command: kill <pid> [signal] - send signal to process
pub fn cmd_kill() {
    // Get PID from position 5 (after "kill ")
    let pid_char = line_get(5);

    // Parse single-digit PID
    let pid = pid_char - 48;

    if pid < 0 || pid >= 32 {
        print_str(69, 82, 82, 58, 32, 80, 73, 68);  // "ERR: PID"
        putchar(10);
        return;
    }

    // Check for optional signal number (default: SIGTERM=15)
    let mut signum: i64 = SIGTERM;
    let space_pos = line_get(6);
    if space_pos == 32 {
        // Parse signal number
        let sig_char = line_get(7);
        if sig_char >= 48 && sig_char <= 57 {
            signum = sig_char - 48;
            // Check for second digit
            let sig_char2 = line_get(8);
            if sig_char2 >= 48 && sig_char2 <= 57 {
                signum = signum * 10 + (sig_char2 - 48);
            }
        }
    }

    // Print "kill: PID SIG"
    print_str(107, 105, 108, 108, 58, 32, 0, 0);  // "kill: "
    putchar(48 + pid);
    putchar(32);
    if signum >= 10 {
        putchar(48 + (signum / 10));
    }
    putchar(48 + (signum % 10));
    putchar(10);

    // Send the signal
    let result = runtime::kill(pid, signum);

    if result == 0 {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);  // "OK"
        putchar(10);
    } else {
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        putchar(48 - result);
        putchar(10);
    }
}

// Command: disk - show disk status
pub fn cmd_disk() {
    let present = runtime::disk_info(0);
    let total = runtime::disk_info(1);

    // Print "Disk: "
    print_str(68, 105, 115, 107, 58, 32, 0, 0);

    if present == 0 {
        // Print "NO DISK"
        print_str(78, 79, 32, 68, 73, 83, 75, 0);
    } else {
        // Print "ATA PIO"
        print_str(65, 84, 65, 32, 80, 73, 79, 0);
        putchar(10);

        // Print "Sectors: <number>"
        print_str(83, 101, 99, 116, 111, 114, 115, 58);  // "Sectors:"
        putchar(32);
        print_dec(total);

        // Print " (~<size>MB)"
        putchar(32);
        putchar(40);  // (
        let mb = total / 2048;  // 512 bytes/sector, 1MB = 2048 sectors
        print_dec(mb);
        putchar(77);   // M
        putchar(66);   // B
        putchar(41);   // )
    }
    putchar(10);
}

// Command: sector <lba> - read and display sector
pub fn cmd_sector() {
    let present = runtime::disk_info(0);
    if present == 0 {
        print_str(78, 79, 32, 68, 73, 83, 75, 0);  // "NO DISK"
        putchar(10);
        return;
    }

    // Parse LBA from position 7 (after "sector ")
    let mut lba: i64 = 0;
    let mut pos: i64 = 7;
    let len = line_len();

    while pos < len {
        let ch = line_get(pos);
        if ch >= 48 && ch <= 57 {
            lba = lba * 10 + (ch - 48);
            pos = pos + 1;
        } else {
            pos = len;  // Exit loop
        }
    }

    // Read sector to buffer
    let bytes = runtime::disk_read(lba, 1, DISK_BUFFER_ADDR);

    if bytes < 0 {
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        print_dec(0 - bytes);
        putchar(10);
        return;
    }

    // Print "LBA <lba>:"
    print_str(76, 66, 65, 32, 0, 0, 0, 0);  // "LBA "
    print_dec(lba);
    putchar(58);  // :
    putchar(10);

    // Display first 64 bytes in hex
    let mut i: i64 = 0;
    while i < 64 {
        let byte = read_byte(DISK_BUFFER_ADDR + i);
        // Print as hex (2 digits)
        let hi = byte / 16;
        let lo = byte - (hi * 16);
        if hi < 10 {
            putchar(48 + hi);
        } else {
            putchar(65 + hi - 10);
        }
        if lo < 10 {
            putchar(48 + lo);
        } else {
            putchar(65 + lo - 10);
        }
        putchar(32);

        // Newline every 16 bytes
        let col = i + 1;
        let row_check = col / 16;
        let row_rem = col - (row_check * 16);
        if row_rem == 0 {
            putchar(10);
        }
        i = i + 1;
    }
}
