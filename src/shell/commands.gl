    // "  net config - static IP"
    print_str(32, 32, 110, 101, 116, 32, 99, 111);   // "  net co"
    print_str(110, 102, 105, 103, 0, 0, 0, 0);       // "nfig"
    putchar(10);

    // "  ping - ICMP ping"
    print_str(32, 32, 112, 105, 110, 103, 0, 0);  // "  ping"
    putchar(10);

    // "  arp - ARP cache"
    print_str(32, 32, 97, 114, 112, 0, 0, 0);  // "  arp"
    putchar(10);

    // "  nc - netcat"
    print_str(32, 32, 110, 99, 0, 0, 0, 0);  // "  nc"
