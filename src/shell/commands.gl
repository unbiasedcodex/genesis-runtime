// Genesis Shell Built-in Commands
// All shell commands are implemented here

mod runtime;

// ============================================================================
// Shell Constants
// ============================================================================

pub const VGA_WIDTH: i64 = 80;
pub const VGA_HEIGHT: i64 = 25;
pub const CONSOLE_START_ROW: i64 = 14;

pub const COLOR_WHITE: i64 = 0x0F;
pub const COLOR_GREEN: i64 = 0x0A;

// Signal numbers
pub const SIGTERM: i64 = 15;

// Line buffer in BSS section (0xB08000-0xB0A000, 8KB)
// This is a separate RW segment loaded by the kernel
pub const LINE_BUFFER_ADDR: i64 = 0xB08000;   // Shell line buffer (256 bytes)
pub const LINE_LEN_ADDR: i64 = 0xB08100;      // Line length (8 bytes)
pub const CURSOR_X_ADDR: i64 = 0xB08108;      // Cursor X (8 bytes)
pub const CURSOR_Y_ADDR: i64 = 0xB08110;      // Cursor Y (8 bytes)
pub const DISK_BUFFER_ADDR: i64 = 0xB08200;   // 4KB disk buffer

pub const LINE_MAX: i64 = 80;

// Capability types
pub const CAP_TYPE_UNUSED: i64 = 0;
pub const CAP_TYPE_IPC: i64 = 1;
pub const CAP_TYPE_FILE: i64 = 2;
pub const CAP_TYPE_MEM: i64 = 3;
pub const CAP_TYPE_ROOT: i64 = 4;

// Process states
pub const PROC_STATE_UNUSED: i64 = 0;
pub const PROC_STATE_READY: i64 = 1;
pub const PROC_STATE_RUNNING: i64 = 2;
pub const PROC_STATE_WAITING: i64 = 3;
pub const PROC_STATE_ZOMBIE: i64 = 4;
pub const PROC_STATE_STOPPED: i64 = 5;

// ============================================================================
// Memory Access Helpers
// ============================================================================

pub fn read_byte(addr: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "movzbl (%rdi), %eax",
            in("rdi") addr,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

pub fn write_byte(addr: i64, val: i64) {
    unsafe {
        asm!(
            "movb %sil, (%rdi)",
            in("rdi") addr,
            in("rsi") val,
            options(nostack, att_syntax)
        );
    }
}

pub fn read_u64(addr: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "movq (%rdi), %rax",
            in("rdi") addr,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

pub fn write_u64(addr: i64, val: i64) {
    unsafe {
        asm!(
            "movq %rsi, (%rdi)",
            in("rdi") addr,
            in("rsi") val,
            options(nostack, att_syntax)
        );
    }
}

// ============================================================================
// Cursor and Line Buffer Management
// Now using clean code - compiler constant propagation bug has been fixed!
// ============================================================================

pub fn cursor_x() -> i64 {
    read_u64(CURSOR_X_ADDR)
}

pub fn cursor_y() -> i64 {
    read_u64(CURSOR_Y_ADDR)
}

pub fn set_cursor_x(x: i64) {
    write_u64(CURSOR_X_ADDR, x);
}

pub fn set_cursor_y(y: i64) {
    write_u64(CURSOR_Y_ADDR, y);
}

pub fn line_len() -> i64 {
    read_u64(LINE_LEN_ADDR)
}

pub fn set_line_len(len: i64) {
    write_u64(LINE_LEN_ADDR, len);
}

pub fn line_get(idx: i64) -> i64 {
    read_byte(LINE_BUFFER_ADDR + idx)
}

pub fn line_set(idx: i64, ch: i64) {
    write_byte(LINE_BUFFER_ADDR + idx, ch);
}

pub fn line_clear() {
    set_line_len(0);
    let mut i: i64 = 0;
    while i < LINE_MAX {
        line_set(i, 0);
        i = i + 1;
    }
}

// ============================================================================
// Console Output Helpers
// ============================================================================

// Write character at cursor and advance
// Note: Column 0 has a bug where characters disappear, so we use column 1 as minimum
// Also outputs to serial for debugging/testing
pub fn putchar(ch: i64) {
    let mut cx = cursor_x();
    let mut cy = cursor_y();

    // Also send to serial for debugging
    runtime::print_char(ch);

    if ch == 10 {
        // Newline: move to next row, start at column 1 (workaround for col 0 bug)
        cx = 1;
        cy = cy + 1;
    } else if ch == 8 {
        // Backspace: move back if possible
        if cx > 2 {  // Don't erase prompt "> "
            cx = cx - 1;
            runtime::vga_putchar(cx, cy, 32, COLOR_WHITE);  // Clear char
        }
    } else {
        // Regular character
        runtime::vga_putchar(cx, cy, ch, COLOR_WHITE);
        cx = cx + 1;
    }

    // Wrap at end of line
    if cx >= VGA_WIDTH {
        cx = 1;  // Start at column 1 (workaround for col 0 bug)
        cy = cy + 1;
    }

    // Scroll if needed (simple: reset to start row)
    if cy >= VGA_HEIGHT {
        cy = CONSOLE_START_ROW;
        clear_area();
    }

    set_cursor_x(cx);
    set_cursor_y(cy);
}

// Print string (up to 8 chars)
pub fn print_str(s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64) {
    if s0 != 0 { putchar(s0); }
    if s1 != 0 { putchar(s1); }
    if s2 != 0 { putchar(s2); }
    if s3 != 0 { putchar(s3); }
    if s4 != 0 { putchar(s4); }
    if s5 != 0 { putchar(s5); }
    if s6 != 0 { putchar(s6); }
    if s7 != 0 { putchar(s7); }
}

// Print decimal number
pub fn print_dec(value: i64) {
    if value == 0 {
        putchar(48);
        return;
    }

    let mut num = value;
    if num < 0 {
        putchar(45);  // '-'
        num = 0 - num;
    }

    // Count digits
    let mut temp = num;
    let mut digits: i64 = 0;
    while temp > 0 {
        temp = temp / 10;
        digits = digits + 1;
    }

    // Print digits
    let mut divisor: i64 = 1;
    let mut d: i64 = 1;
    while d < digits {
        divisor = divisor * 10;
        d = d + 1;
    }

    while divisor > 0 {
        let digit = num / divisor;
        putchar(48 + digit);
        num = num - (digit * divisor);
        divisor = divisor / 10;
    }
}

// Clear the shell display area
pub fn clear_area() {
    runtime::vga_clear(CONSOLE_START_ROW, VGA_HEIGHT, COLOR_WHITE);
}

// Show shell prompt
pub fn prompt() {
    let cx = cursor_x();
    let cy = cursor_y();

    // Also send prompt to serial
    runtime::print_char(10);  // newline
    runtime::print_char(62);  // >
    runtime::print_char(32);  // space

    runtime::vga_putchar(cx, cy, 62, COLOR_GREEN);      // >
    runtime::vga_putchar(cx + 1, cy, 32, COLOR_GREEN);  // space

    set_cursor_x(cx + 2);
}

// ============================================================================
// Command Matching
// ============================================================================

// Compare line buffer with command (up to 8 chars)
pub fn cmd_match(c0: i64, c1: i64, c2: i64, c3: i64, c4: i64, c5: i64, c6: i64, c7: i64) -> bool {
    let b0 = line_get(0);
    let b1 = line_get(1);
    let b2 = line_get(2);
    let b3 = line_get(3);
    let b4 = line_get(4);
    let b5 = line_get(5);
    let b6 = line_get(6);
    let b7 = line_get(7);

    b0 == c0 && b1 == c1 && b2 == c2 && b3 == c3 &&
    b4 == c4 && b5 == c5 && b6 == c6 && b7 == c7
}

// ============================================================================
// Built-in Commands
// ============================================================================

// Command: help
pub fn cmd_help() {
    // "Commands:"
    print_str(67, 111, 109, 109, 97, 110, 100, 115);  // Commands
    putchar(58);  // :
    putchar(10);  // newline

    // "  help  - show this"
    print_str(32, 32, 104, 101, 108, 112, 0, 0);
    putchar(10);

    // "  ps    - processes"
    print_str(32, 32, 112, 115, 0, 0, 0, 0);
    putchar(10);

    // "  caps  - capabilities"
    print_str(32, 32, 99, 97, 112, 115, 0, 0);
    putchar(10);

    // "  files - list files"
    print_str(32, 32, 102, 105, 108, 101, 115, 0);
    putchar(10);

    // "  cat   - read file"
    print_str(32, 32, 99, 97, 116, 0, 0, 0);
    putchar(10);

    // "  echo  - echo text"
    print_str(32, 32, 101, 99, 104, 111, 0, 0);
    putchar(10);

    // "  clear - clear screen"
    print_str(32, 32, 99, 108, 101, 97, 114, 0);
    putchar(10);

    // "  run   - run program"
    print_str(32, 32, 114, 117, 110, 0, 0, 0);
    putchar(10);

    // "  kill  - signal proc"
    print_str(32, 32, 107, 105, 108, 108, 0, 0);
    putchar(10);

    // "  disk  - disk info"
    print_str(32, 32, 100, 105, 115, 107, 0, 0);
    putchar(10);

    // "  sector - read sector"
    print_str(32, 32, 115, 101, 99, 116, 111, 114);
    putchar(10);

    // "  health - service status"
    print_str(32, 32, 104, 101, 97, 108, 116, 104);  // "  health"
    putchar(10);

    // "  uptime - system uptime"
    print_str(32, 32, 117, 112, 116, 105, 109, 101);  // "  uptime"
    putchar(10);

    // "  whoami - process info"
    print_str(32, 32, 119, 104, 111, 97, 109, 105);  // "  whoami"
    putchar(10);

    // "  env    - system info"
    print_str(32, 32, 101, 110, 118, 0, 0, 0);  // "  env"
    putchar(10);
}

// Command: ps - show processes
pub fn cmd_ps() {
    // Print header
    print_str(80, 73, 68, 32, 83, 84, 65, 84);  // "PID STAT"
    putchar(10);

    // Get process count via syscall
    let num_procs = runtime::proc_count();
    let mut pid: i64 = 0;
    while pid < num_procs {
        let state = runtime::proc_state(pid);
        if state != PROC_STATE_UNUSED {
            // Print PID
            putchar(48 + pid);
            putchar(32);
            putchar(32);
            putchar(32);

            // Print state
            if state == PROC_STATE_READY {
                print_str(82, 69, 65, 68, 89, 0, 0, 0);    // READY
            } else if state == PROC_STATE_RUNNING {
                print_str(82, 85, 78, 0, 0, 0, 0, 0);      // RUN
            } else if state == PROC_STATE_WAITING {
                print_str(87, 65, 73, 84, 0, 0, 0, 0);     // WAIT
            } else if state == PROC_STATE_ZOMBIE {
                print_str(90, 79, 77, 66, 73, 69, 0, 0);   // ZOMBIE
            } else if state == PROC_STATE_STOPPED {
                print_str(83, 84, 79, 80, 0, 0, 0, 0);     // STOP
            }
            putchar(10);
        }
        pid = pid + 1;
    }
}

// Command: caps - show capabilities for current process
pub fn cmd_caps() {
    let pid = runtime::getpid();

    print_str(67, 65, 80, 83, 32, 80, 0, 0);  // "CAPS P"
    putchar(48 + pid);
    putchar(58);
    putchar(10);

    // List capabilities using SYS_CAP_LIST
    let mut i: i64 = 0;
    while i < 4 {
        let cap_info = runtime::cap_list(i);
        if cap_info >= 0 {
            // Extract type from packed value: (type * 65536) + (target * 256) + rights
            let cap_type = cap_info / 65536;
            if cap_type != CAP_TYPE_UNUSED {
                putchar(48 + i);  // index
                putchar(58);
                putchar(32);

                if cap_type == CAP_TYPE_ROOT {
                    print_str(82, 79, 79, 84, 0, 0, 0, 0);  // ROOT
                } else if cap_type == CAP_TYPE_IPC {
                    print_str(73, 80, 67, 0, 0, 0, 0, 0);   // IPC
                } else if cap_type == CAP_TYPE_FILE {
                    print_str(70, 73, 76, 69, 0, 0, 0, 0);  // FILE
                }
                putchar(10);
            }
        }
        i = i + 1;
    }
}

// Command: files - list files via VFS IPC
pub fn cmd_files() {
    print_str(70, 105, 108, 101, 115, 58, 0, 0);  // "Files:"
    putchar(10);

    // Clear any pending messages first
    drain_pending_messages();

    // Get my PID for the response
    let my_pid = runtime::getpid();

    // Send VFS_LIST request to VFS server (PID 2)
    let request = runtime::pack_vfs_request(runtime::VFS_LIST, my_pid, 0, 0, 0, 0, 0, 0);
    runtime::send(runtime::VFS_PID, request);

    // Wait for file count response
    let count_resp = wait_vfs_response();
    if count_resp < 0 {
        print_str(69, 82, 82, 58, 32, 86, 70, 83);  // "ERR: VFS"
        putchar(10);
        return;
    }

    // NOTE: Using direct computation due to possible compiler bug with msg_byte()
    let status = count_resp % 256;
    let file_count = (count_resp / 256) % 256;

    // Debug: show count
    runtime::print_char(35);  // #
    runtime::print_char(48 + file_count);
    runtime::print_char(32);

    // Receive file entries until end marker (0xFE)
    let mut done: i64 = 0;
    while done == 0 {
        let file_resp = wait_vfs_response();
        if file_resp < 0 {
            done = 1;
        } else {
            // NOTE: Using direct computation due to possible compiler bug with msg_byte()
            let marker = file_resp % 256;

            if marker == 254 {
                // End marker received
                done = 1;
            } else if marker == 255 {
                // Size message - already handled below
            } else {
                // File entry: [index, c0, c1, c2, c3, c4, c5]
                let file_idx = marker;
                let c0 = (file_resp / 256) % 256;
                let c1 = (file_resp / 65536) % 256;
                let c2 = (file_resp / 16777216) % 256;
                let c3 = (file_resp / 0x100000000) % 256;
                let c4 = (file_resp / 0x10000000000) % 256;
                let c5 = (file_resp / 0x1000000000000) % 256;

                // Print file index
                putchar(48 + file_idx);
                putchar(58);
                putchar(32);

                // Print filename
                if c0 != 0 { putchar(c0); }
                if c1 != 0 { putchar(c1); }
                if c2 != 0 { putchar(c2); }
                if c3 != 0 { putchar(c3); }
                if c4 != 0 { putchar(c4); }
                if c5 != 0 { putchar(c5); }

                // Wait for size message
                let size_resp = wait_vfs_response();
                if size_resp >= 0 {
                    let size_marker = size_resp % 256;
                    if size_marker == 255 {
                        let size_lo = (size_resp / 256) % 256;
                        let size_hi = (size_resp / 65536) % 256;
                        let size = size_lo + (size_hi * 256);

                        putchar(32);
                        putchar(40);  // (
                        print_dec(size);
                        putchar(66);  // B
                        putchar(41);  // )
                    }
                }
                putchar(10);
            }
        }
    }
}

// Drain any pending messages from queue (clear stale messages)
fn drain_pending_messages() {
    let mut msg = runtime::recv();
    // recv() returns 0 for "no message" or -1, only positive values are real messages
    while msg > 0 {
        // Debug: show we're draining a message
        runtime::print_char(68);  // D
        runtime::print_char(58);  // :
        runtime::print_num(msg);
        runtime::print_char(32);
        msg = runtime::recv();
    }
}

// Wait for VFS response with timeout
// Returns >=0 for valid message, -1 for timeout/no response
// NOTE: recv() returns -1 for "no message", but 0 can be a valid response!
fn wait_vfs_response() -> i64 {
    let mut response: i64 = 0 - 1;  // Start with -1 (no message)
    let mut attempts: i64 = 0;
    // Wait until we get a non-negative response (valid message)
    // recv() returns -1 for "no message", >= 0 for valid message
    while response < 0 && attempts < 10000 {
        response = runtime::recv();
        if response < 0 {
            runtime::yield_cpu();
        }
        attempts = attempts + 1;
    }
    if response < 0 {
        // Debug: timeout
        runtime::print_char(84);  // T
        runtime::print_char(79);  // O
        runtime::print_char(32);  // space
        0 - 1  // Return -1 for timeout
    } else {
        response
    }
}

// Command: cat <filename> - display file contents via VFS IPC
pub fn cmd_cat() {
    // Get filename starting at position 4 (after "cat ")
    let c0 = line_get(4);
    let c1 = line_get(5);
    let c2 = line_get(6);
    let c3 = line_get(7);
    let c4 = line_get(8);
    let c5 = line_get(9);

    if c0 == 0 {
        print_str(85, 115, 97, 103, 101, 58, 32, 0);  // "Usage: "
        print_str(99, 97, 116, 32, 60, 102, 62, 0);   // "cat <f>"
        putchar(10);
        return;
    }

    // Clear any pending messages first
    drain_pending_messages();

    let my_pid = runtime::getpid();

    // Send VFS_OPEN request
    let open_req = runtime::pack_vfs_request(runtime::VFS_OPEN, my_pid, c0, c1, c2, c3, c4, c5);
    runtime::send(runtime::VFS_PID, open_req);

    // Wait for open response
    let open_resp = wait_vfs_response();
    if open_resp < 0 {
        print_str(69, 82, 82, 58, 32, 86, 70, 83);  // "ERR: VFS"
        putchar(10);
        return;
    }

    // NOTE: Using direct computation due to possible compiler bug with msg_byte()
    let open_status = open_resp % 256;
    let file_idx = (open_resp / 256) % 256;

    if open_status != 0 {
        print_str(70, 105, 108, 101, 32, 110, 111, 116);  // "File not"
        putchar(10);
        print_str(102, 111, 117, 110, 100, 0, 0, 0);      // "found"
        putchar(10);
        return;
    }

    // Get file size first via VFS_STAT
    let stat_req = runtime::pack_vfs_request(runtime::VFS_STAT, my_pid, file_idx, 0, 0, 0, 0, 0);
    runtime::send(runtime::VFS_PID, stat_req);

    let stat_resp = wait_vfs_response();
    if stat_resp < 0 {
        return;
    }

    // NOTE: Using direct computation due to possible compiler bug with msg_byte()
    let size_lo = (stat_resp / 256) % 256;
    let size_hi = (stat_resp / 65536) % 256;
    let size_mid = (stat_resp / 16777216) % 256;
    let file_size = size_lo + (size_hi * 256) + (size_mid * 65536);

    // Read and display file contents
    let mut offset: i64 = 0;
    let mut bytes_displayed: i64 = 0;
    let max_display: i64 = 256;  // Limit output for display

    while offset < file_size && bytes_displayed < max_display {
        // Send VFS_READ request
        let offset_lo = offset % 256;
        let offset_hi = (offset / 256) % 256;
        let read_req = runtime::pack_vfs_request(runtime::VFS_READ, my_pid, file_idx, offset_lo, offset_hi, 6, 0, 0);
        runtime::send(runtime::VFS_PID, read_req);

        // Wait for read response
        let read_resp = wait_vfs_response();
        if read_resp < 0 {
            break;
        }

        // NOTE: Using direct computation due to possible compiler bug with msg_byte()
        let bytes_read = read_resp % 256;
        if bytes_read == 0 {
            break;
        }

        // Extract all 6 data bytes upfront (bytes 1-6 of the response)
        let b0 = (read_resp / 256) % 256;
        let b1 = (read_resp / 65536) % 256;
        let b2 = (read_resp / 16777216) % 256;
        let b3 = (read_resp / 0x100000000) % 256;
        let b4 = (read_resp / 0x10000000000) % 256;
        let b5 = (read_resp / 0x1000000000000) % 256;

        // Display bytes using unrolled loop (can't use dynamic indexing with direct computation)
        if bytes_read > 0 && bytes_displayed < max_display {
            print_byte_if_printable(b0);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 1 && bytes_displayed < max_display {
            print_byte_if_printable(b1);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 2 && bytes_displayed < max_display {
            print_byte_if_printable(b2);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 3 && bytes_displayed < max_display {
            print_byte_if_printable(b3);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 4 && bytes_displayed < max_display {
            print_byte_if_printable(b4);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 5 && bytes_displayed < max_display {
            print_byte_if_printable(b5);
            bytes_displayed = bytes_displayed + 1;
        }

        offset = offset + bytes_read;
    }

    putchar(10);

    // Show truncation notice if file was larger
    if file_size > max_display {
        print_str(91, 46, 46, 46, 93, 0, 0, 0);  // "[...]"
        putchar(10);
    }
}

// Helper: print byte if it's printable ASCII, newline, or tab
fn print_byte_if_printable(byte: i64) {
    if byte >= 32 && byte < 127 {
        putchar(byte);
    } else if byte == 10 {
        putchar(10);  // newline
    } else if byte == 9 {
        putchar(32);  // tab -> space
    }
}

// Command: echo - echo remaining input
pub fn cmd_echo() {
    let len = line_len();
    // Skip "echo " (5 chars)
    let mut i: i64 = 5;
    while i < len {
        let ch = line_get(i);
        if ch != 0 {
            putchar(ch);
        }
        i = i + 1;
    }
    putchar(10);
}

// Command: clear - clear shell area
pub fn cmd_clear() {
    clear_area();
    set_cursor_x(0);
    set_cursor_y(CONSOLE_START_ROW);
}

// Command: run <filename> - execute ELF binary
pub fn cmd_run() {
    // Get filename starting at position 4 (after "run ")
    let c0 = line_get(4);
    let c1 = line_get(5);
    let c2 = line_get(6);
    let c3 = line_get(7);
    let c4 = line_get(8);
    let c5 = line_get(9);
    let c6 = line_get(10);
    let c7 = line_get(11);

    // Pack filename into i64 (little-endian)
    let name_lo = c0 + (c1 * 256) + (c2 * 65536) + (c3 * 16777216) +
                  (c4 * 0x100000000) + (c5 * 0x10000000000) +
                  (c6 * 0x1000000000000) + (c7 * 0x100000000000000);

    // Print "run: "
    print_str(114, 117, 110, 58, 32, 0, 0, 0);  // "run: "

    // Print filename
    if c0 > 0 { putchar(c0); }
    if c1 > 0 { putchar(c1); }
    if c2 > 0 { putchar(c2); }
    if c3 > 0 { putchar(c3); }
    if c4 > 0 { putchar(c4); }
    if c5 > 0 { putchar(c5); }
    if c6 > 0 { putchar(c6); }
    if c7 > 0 { putchar(c7); }
    putchar(10);

    // Execute the ELF file
    let result = runtime::exec(name_lo);

    if result >= 0 {
        // Print "PID: N"
        print_str(80, 73, 68, 58, 32, 0, 0, 0);  // "PID: "
        putchar(48 + result);
        putchar(10);
    } else {
        // Print error
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        putchar(48 - result);  // error code as digit
        putchar(10);
    }
}

// Command: kill <pid> [signal] - send signal to process
pub fn cmd_kill() {
    // Get PID from position 5 (after "kill ")
    let pid_char = line_get(5);

    // Parse single-digit PID
    let pid = pid_char - 48;

    if pid < 0 || pid >= 32 {
        print_str(69, 82, 82, 58, 32, 80, 73, 68);  // "ERR: PID"
        putchar(10);
        return;
    }

    // Check for optional signal number (default: SIGTERM=15)
    let mut signum: i64 = SIGTERM;
    let space_pos = line_get(6);
    if space_pos == 32 {
        // Parse signal number
        let sig_char = line_get(7);
        if sig_char >= 48 && sig_char <= 57 {
            signum = sig_char - 48;
            // Check for second digit
            let sig_char2 = line_get(8);
            if sig_char2 >= 48 && sig_char2 <= 57 {
                signum = signum * 10 + (sig_char2 - 48);
            }
        }
    }

    // Print "kill: PID SIG"
    print_str(107, 105, 108, 108, 58, 32, 0, 0);  // "kill: "
    putchar(48 + pid);
    putchar(32);
    if signum >= 10 {
        putchar(48 + (signum / 10));
    }
    putchar(48 + (signum % 10));
    putchar(10);

    // Send the signal
    let result = runtime::kill(pid, signum);

    if result == 0 {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);  // "OK"
        putchar(10);
    } else {
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        putchar(48 - result);
        putchar(10);
    }
}

// Command: disk - show disk status
pub fn cmd_disk() {
    let present = runtime::disk_info(0);
    let total = runtime::disk_info(1);

    // Print "Disk: "
    print_str(68, 105, 115, 107, 58, 32, 0, 0);

    if present == 0 {
        // Print "NO DISK"
        print_str(78, 79, 32, 68, 73, 83, 75, 0);
    } else {
        // Print "ATA PIO"
        print_str(65, 84, 65, 32, 80, 73, 79, 0);
        putchar(10);

        // Print "Sectors: <number>"
        print_str(83, 101, 99, 116, 111, 114, 115, 58);  // "Sectors:"
        putchar(32);
        print_dec(total);

        // Print " (~<size>MB)"
        putchar(32);
        putchar(40);  // (
        let mb = total / 2048;  // 512 bytes/sector, 1MB = 2048 sectors
        print_dec(mb);
        putchar(77);   // M
        putchar(66);   // B
        putchar(41);   // )
    }
    putchar(10);
}

// Command: sector <lba> - read and display sector
pub fn cmd_sector() {
    let present = runtime::disk_info(0);
    if present == 0 {
        print_str(78, 79, 32, 68, 73, 83, 75, 0);  // "NO DISK"
        putchar(10);
        return;
    }

    // Parse LBA from position 7 (after "sector ")
    let mut lba: i64 = 0;
    let mut pos: i64 = 7;
    let len = line_len();

    while pos < len {
        let ch = line_get(pos);
        if ch >= 48 && ch <= 57 {
            lba = lba * 10 + (ch - 48);
            pos = pos + 1;
        } else {
            pos = len;  // Exit loop
        }
    }

    // Read sector to buffer
    let bytes = runtime::disk_read(lba, 1, DISK_BUFFER_ADDR);

    if bytes < 0 {
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        print_dec(0 - bytes);
        putchar(10);
        return;
    }

    // Print "LBA <lba>:"
    print_str(76, 66, 65, 32, 0, 0, 0, 0);  // "LBA "
    print_dec(lba);
    putchar(58);  // :
    putchar(10);

    // Display first 64 bytes in hex
    let mut i: i64 = 0;
    while i < 64 {
        let byte = read_byte(DISK_BUFFER_ADDR + i);
        // Print as hex (2 digits)
        let hi = byte / 16;
        let lo = byte - (hi * 16);
        if hi < 10 {
            putchar(48 + hi);
        } else {
            putchar(65 + hi - 10);
        }
        if lo < 10 {
            putchar(48 + lo);
        } else {
            putchar(65 + lo - 10);
        }
        putchar(32);

        // Newline every 16 bytes
        let col = i + 1;
        let row_check = col / 16;
        let row_rem = col - (row_check * 16);
        if row_rem == 0 {
            putchar(10);
        }
        i = i + 1;
    }
}

// Command: health - show system service health status
pub fn cmd_health() {
    // Print header: "Service Status:"
    print_str(83, 101, 114, 118, 105, 99, 101, 32);  // "Service "
    print_str(83, 116, 97, 116, 117, 115, 58, 0);    // "Status:"
    putchar(10);

    // Service PIDs
    let init_pid: i64 = 1;
    let vfs_pid: i64 = 2;
    let console_pid: i64 = 3;
    let shell_pid: i64 = 4;

    // Check Init (PID 1)
    print_str(73, 110, 105, 116, 40, 49, 41, 58);   // "Init(1):"
    putchar(32);
    let init_state = runtime::proc_state(init_pid);
    print_service_status(init_state, init_pid);
    putchar(10);

    // Check VFS (PID 2)
    print_str(86, 70, 83, 40, 50, 41, 58, 32);      // "VFS(2): "
    let vfs_state = runtime::proc_state(vfs_pid);
    print_service_status(vfs_state, vfs_pid);
    putchar(10);

    // Check Console (PID 3)
    print_str(67, 111, 110, 115, 111, 108, 101, 40); // "Console("
    putchar(51);  // 3
    putchar(41);  // )
    putchar(58);  // :
    putchar(32);  // space
    let console_state = runtime::proc_state(console_pid);
    print_service_status(console_state, console_pid);
    putchar(10);

    // Check Shell (PID 4)
    print_str(83, 104, 101, 108, 108, 40, 52, 41);  // "Shell(4)"
    putchar(58);  // :
    putchar(32);  // space
    let shell_state = runtime::proc_state(shell_pid);
    print_service_status(shell_state, shell_pid);
    putchar(10);

    // Optional: Ping VFS to verify it responds
    putchar(10);
    print_str(86, 70, 83, 32, 80, 105, 110, 103);   // "VFS Ping"
    putchar(58);  // :
    putchar(32);  // space

    // Try to ping VFS with a simple STAT request for file 0
    drain_pending_messages();
    let my_pid = runtime::getpid();
    let ping_req = runtime::pack_vfs_request(runtime::VFS_STAT, my_pid, 0, 0, 0, 0, 0, 0);
    runtime::send(runtime::VFS_PID, ping_req);

    // Wait for response (shorter timeout for ping)
    let mut response: i64 = 0 - 1;
    let mut attempts: i64 = 0;
    while response < 0 && attempts < 5000 {
        response = runtime::recv();
        if response < 0 {
            runtime::yield_cpu();
        }
        attempts = attempts + 1;
    }

    if response >= 0 {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);        // "OK"
    } else {
        print_str(78, 79, 32, 82, 69, 83, 80, 0);   // "NO RESP"
    }
    putchar(10);
}

// Helper: print service status based on state
fn print_service_status(state: i64, pid: i64) {
    let my_pid = runtime::getpid();

    // If this is our own process (shell), show RUNNING
    if pid == my_pid {
        print_str(82, 85, 78, 78, 73, 78, 71, 0);   // "RUNNING"
    } else if state == PROC_STATE_READY {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);        // "OK"
    } else if state == PROC_STATE_RUNNING {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);        // "OK"
    } else if state == PROC_STATE_WAITING {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);        // "OK" (waiting is normal for servers)
    } else if state == PROC_STATE_ZOMBIE {
        print_str(90, 79, 77, 66, 73, 69, 0, 0);    // "ZOMBIE"
    } else if state == PROC_STATE_STOPPED {
        print_str(83, 84, 79, 80, 80, 69, 68, 0);   // "STOPPED"
    } else if state == PROC_STATE_UNUSED {
        print_str(68, 79, 87, 78, 0, 0, 0, 0);      // "DOWN"
    } else {
        print_str(85, 78, 75, 78, 79, 87, 78, 0);   // "UNKNOWN"
    }
}

// Command: uptime - show system uptime in ticks
pub fn cmd_uptime() {
    let ticks = runtime::time();

    // Print "Uptime: "
    print_str(85, 112, 116, 105, 109, 101, 58, 32);  // "Uptime: "
    print_dec(ticks);
    // Print " ticks"
    print_str(32, 116, 105, 99, 107, 115, 0, 0);  // " ticks"
    putchar(10);

    // Also show approximate seconds (assuming ~100 ticks/second typical timer rate)
    // Note: actual tick rate depends on kernel timer configuration
    let seconds = ticks / 100;
    let minutes = seconds / 60;
    let hours = minutes / 60;

    // Print "(~"
    putchar(40);  // (
    putchar(126); // ~

    // Format: HH:MM:SS or just seconds if small
    if hours > 0 {
        print_dec(hours);
        putchar(104);  // h
        putchar(32);   // space
        let rem_min = minutes - (hours * 60);
        print_dec(rem_min);
        putchar(109);  // m
    } else if minutes > 0 {
        print_dec(minutes);
        putchar(109);  // m
        putchar(32);   // space
        let rem_sec = seconds - (minutes * 60);
        print_dec(rem_sec);
        putchar(115);  // s
    } else {
        print_dec(seconds);
        putchar(115);  // s
    }

    putchar(41);  // )
    putchar(10);
}

// Command: whoami - show current process information
pub fn cmd_whoami() {
    let pid = runtime::getpid();
    let ppid = runtime::getppid();

    // Print "PID: "
    print_str(80, 73, 68, 58, 32, 0, 0, 0);  // "PID: "
    print_dec(pid);
    putchar(10);

    // Print "PPID: "
    print_str(80, 80, 73, 68, 58, 32, 0, 0);  // "PPID: "
    print_dec(ppid);
    putchar(10);

    // Print "Name: shell"
    print_str(78, 97, 109, 101, 58, 32, 0, 0);  // "Name: "
    print_str(115, 104, 101, 108, 108, 0, 0, 0);  // "shell"
    putchar(10);

    // Print state
    let state = runtime::proc_state(pid);
    print_str(83, 116, 97, 116, 101, 58, 32, 0);  // "State: "
    if state == PROC_STATE_READY {
        print_str(82, 69, 65, 68, 89, 0, 0, 0);    // READY
    } else if state == PROC_STATE_RUNNING {
        print_str(82, 85, 78, 78, 73, 78, 71, 0);  // RUNNING
    } else if state == PROC_STATE_WAITING {
        print_str(87, 65, 73, 84, 73, 78, 71, 0);  // WAITING
    } else {
        print_dec(state);
    }
    putchar(10);
}

// Command: env - show system environment info
pub fn cmd_env() {
    // Get disk info
    let disk_present = runtime::disk_info(0);
    let disk_sectors = runtime::disk_info(1);

    // Get process count
    let proc_count = runtime::proc_count();

    // Get uptime
    let ticks = runtime::time();

    // Print "Procs: "
    print_str(80, 114, 111, 99, 115, 58, 32, 0);  // "Procs: "
    print_dec(proc_count);
    putchar(10);

    // Print "Uptime: "
    print_str(85, 112, 116, 105, 109, 101, 58, 32);  // "Uptime: "
    print_dec(ticks);
    putchar(10);

    // Print "Disk: "
    print_str(68, 105, 115, 107, 58, 32, 0, 0);  // "Disk: "
    if disk_present == 0 {
        print_str(110, 111, 110, 101, 0, 0, 0, 0);  // "none"
    } else {
        let mb = disk_sectors / 2048;
        print_dec(mb);
        print_str(77, 66, 0, 0, 0, 0, 0, 0);  // "MB"
    }
    putchar(10);

    // Print "Files: "
    print_str(70, 105, 108, 101, 115, 58, 32, 0);  // "Files: "
    let file_count = runtime::ramfs_file_count();
    print_dec(file_count);
    putchar(10);
}
