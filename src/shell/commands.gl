// Command: ps - show processes
pub fn cmd_ps() {
    // Print header
    print_str(80, 73, 68, 32, 83, 84, 65, 84);  // "PID STAT"
    putchar(10);

    // Get process count via syscall
    let num_procs = runtime::proc_count();
    let mut pid: i64 = 0;
    while pid < num_procs {
        let state = runtime::proc_state(pid);
        if state != PROC_STATE_UNUSED {
            // Print PID
            putchar(48 + pid);
            putchar(32);
            putchar(32);
            putchar(32);

            // Print state
            if state == PROC_STATE_READY {
                print_str(82, 69, 65, 68, 89, 0, 0, 0);    // READY
            } else if state == PROC_STATE_RUNNING {
                print_str(82, 85, 78, 0, 0, 0, 0, 0);      // RUN
            } else if state == PROC_STATE_WAITING {
                print_str(87, 65, 73, 84, 0, 0, 0, 0);     // WAIT
            } else if state == PROC_STATE_ZOMBIE {
                print_str(90, 79, 77, 66, 73, 69, 0, 0);   // ZOMBIE
            } else if state == PROC_STATE_STOPPED {
                print_str(83, 84, 79, 80, 0, 0, 0, 0);     // STOP
            }
            putchar(10);
        }
        pid = pid + 1;
    }
}

// Command: caps - show capabilities for current process
pub fn cmd_caps() {
    let pid = runtime::getpid();

    print_str(67, 65, 80, 83, 32, 80, 0, 0);  // "CAPS P"
    putchar(48 + pid);
    putchar(58);
    putchar(10);

    // List capabilities using SYS_CAP_LIST
    let mut i: i64 = 0;
    while i < 4 {
        let cap_info = runtime::cap_list(i);
        if cap_info >= 0 {
            // Extract type from packed value: (type * 65536) + (target * 256) + rights
            let cap_type = cap_info / 65536;
            if cap_type != CAP_TYPE_UNUSED {
                putchar(48 + i);  // index
                putchar(58);
                putchar(32);

                if cap_type == CAP_TYPE_ROOT {
                    print_str(82, 79, 79, 84, 0, 0, 0, 0);  // ROOT
                } else if cap_type == CAP_TYPE_IPC {
                    print_str(73, 80, 67, 0, 0, 0, 0, 0);   // IPC
                } else if cap_type == CAP_TYPE_FILE {
                    print_str(70, 73, 76, 69, 0, 0, 0, 0);  // FILE
                }
                putchar(10);
            }
        }
        i = i + 1;
    }
}

// Command: files - list files via VFS IPC
pub fn cmd_files() {
    print_str(70, 105, 108, 101, 115, 58, 0, 0);  // "Files:"
    putchar(10);

    // Clear any pending messages first
    drain_pending_messages();

    // Get my PID for the response
    let my_pid = runtime::getpid();

    // Send VFS_LIST request to VFS server (PID 2)
    let request = runtime::pack_vfs_request(runtime::VFS_LIST, my_pid, 0, 0, 0, 0, 0, 0);
    runtime::send(runtime::VFS_PID, request);

    // Wait for file count response
    let count_resp = wait_vfs_response();
    if count_resp < 0 {
        print_str(69, 82, 82, 58, 32, 86, 70, 83);  // "ERR: VFS"
        putchar(10);
        return;
    }

    // NOTE: Using direct computation due to possible compiler bug with msg_byte()
    let status = count_resp % 256;
    let file_count = (count_resp / 256) % 256;

    // Debug: show count
    runtime::print_char(35);  // #
    runtime::print_char(48 + file_count);
    runtime::print_char(32);

    // Receive file entries until end marker (0xFE)
    let mut done: i64 = 0;
    while done == 0 {
        let file_resp = wait_vfs_response();
        if file_resp < 0 {
            done = 1;
        } else {
            // NOTE: Using direct computation due to possible compiler bug with msg_byte()
            let marker = file_resp % 256;

            if marker == 254 {
                // End marker received
                done = 1;
            } else if marker == 255 {
                // Size message - already handled below
            } else {
                // File entry: [index, c0, c1, c2, c3, c4, c5]
                let file_idx = marker;
                let c0 = (file_resp / 256) % 256;
                let c1 = (file_resp / 65536) % 256;
                let c2 = (file_resp / 16777216) % 256;
                let c3 = (file_resp / 0x100000000) % 256;
                let c4 = (file_resp / 0x10000000000) % 256;
                let c5 = (file_resp / 0x1000000000000) % 256;

                // Print file index
                putchar(48 + file_idx);
                putchar(58);
                putchar(32);

                // Print filename
                if c0 != 0 { putchar(c0); }
                if c1 != 0 { putchar(c1); }
                if c2 != 0 { putchar(c2); }
                if c3 != 0 { putchar(c3); }
                if c4 != 0 { putchar(c4); }
                if c5 != 0 { putchar(c5); }

                // Wait for size message
                let size_resp = wait_vfs_response();
                if size_resp >= 0 {
                    let size_marker = size_resp % 256;
                    if size_marker == 255 {
                        let size_lo = (size_resp / 256) % 256;
                        let size_hi = (size_resp / 65536) % 256;
                        let size = size_lo + (size_hi * 256);

                        putchar(32);
                        putchar(40);  // (
                        print_dec(size);
                        putchar(66);  // B
                        putchar(41);  // )
                    }
                }
                putchar(10);
            }
        }
    }
}

// Drain any pending messages from queue (clear stale messages)
fn drain_pending_messages() {
    let mut msg = runtime::recv();
    // recv() returns 0 for "no message" or -1, only positive values are real messages
    while msg > 0 {
        // Debug: show we're draining a message
        runtime::print_char(68);  // D
        runtime::print_char(58);  // :
        runtime::print_num(msg);
        runtime::print_char(32);
        msg = runtime::recv();
    }
}

// Wait for VFS response with timeout
// Returns >=0 for valid message, -1 for timeout/no response
// NOTE: recv() returns -1 for "no message", but 0 can be a valid response!
fn wait_vfs_response() -> i64 {
    let mut response: i64 = 0 - 1;  // Start with -1 (no message)
    let mut attempts: i64 = 0;
    // Wait until we get a non-negative response (valid message)
    // recv() returns -1 for "no message", >= 0 for valid message
    while response < 0 && attempts < 10000 {
        response = runtime::recv();
        if response < 0 {
            runtime::yield_cpu();
        }
        attempts = attempts + 1;
    }
    if response < 0 {
        // Debug: timeout
        runtime::print_char(84);  // T
        runtime::print_char(79);  // O
        runtime::print_char(32);  // space
        0 - 1  // Return -1 for timeout
    } else {
        response
    }
}

// Command: cat <filename> - display file contents via VFS IPC
pub fn cmd_cat() {
    // Get filename starting at position 4 (after "cat ")
    let c0 = line_get(4);
    let c1 = line_get(5);
    let c2 = line_get(6);
    let c3 = line_get(7);
    let c4 = line_get(8);
    let c5 = line_get(9);

    if c0 == 0 {
        print_str(85, 115, 97, 103, 101, 58, 32, 0);  // "Usage: "
        print_str(99, 97, 116, 32, 60, 102, 62, 0);   // "cat <f>"
        putchar(10);
        return;
    }

    // Clear any pending messages first
    drain_pending_messages();

    let my_pid = runtime::getpid();

    // Send VFS_OPEN request
    let open_req = runtime::pack_vfs_request(runtime::VFS_OPEN, my_pid, c0, c1, c2, c3, c4, c5);
    runtime::send(runtime::VFS_PID, open_req);

    // Wait for open response
    let open_resp = wait_vfs_response();
    if open_resp < 0 {
        print_str(69, 82, 82, 58, 32, 86, 70, 83);  // "ERR: VFS"
        putchar(10);
        return;
    }

    // NOTE: Using direct computation due to possible compiler bug with msg_byte()
    let open_status = open_resp % 256;
    let file_idx = (open_resp / 256) % 256;

    if open_status != 0 {
        print_str(70, 105, 108, 101, 32, 110, 111, 116);  // "File not"
        putchar(10);
        print_str(102, 111, 117, 110, 100, 0, 0, 0);      // "found"
        putchar(10);
        return;
    }

    // Get file size first via VFS_STAT
    let stat_req = runtime::pack_vfs_request(runtime::VFS_STAT, my_pid, file_idx, 0, 0, 0, 0, 0);
    runtime::send(runtime::VFS_PID, stat_req);

    let stat_resp = wait_vfs_response();
    if stat_resp < 0 {
        return;
    }

    // NOTE: Using direct computation due to possible compiler bug with msg_byte()
    let size_lo = (stat_resp / 256) % 256;
    let size_hi = (stat_resp / 65536) % 256;
    let size_mid = (stat_resp / 16777216) % 256;
    let file_size = size_lo + (size_hi * 256) + (size_mid * 65536);

    // Read and display file contents
    let mut offset: i64 = 0;
    let mut bytes_displayed: i64 = 0;
    let max_display: i64 = 256;  // Limit output for display

    while offset < file_size && bytes_displayed < max_display {
        // Send VFS_READ request
        let offset_lo = offset % 256;
        let offset_hi = (offset / 256) % 256;
        let read_req = runtime::pack_vfs_request(runtime::VFS_READ, my_pid, file_idx, offset_lo, offset_hi, 6, 0, 0);
        runtime::send(runtime::VFS_PID, read_req);

        // Wait for read response
        let read_resp = wait_vfs_response();
        if read_resp < 0 {
            break;
        }

        // NOTE: Using direct computation due to possible compiler bug with msg_byte()
        let bytes_read = read_resp % 256;
        if bytes_read == 0 {
            break;
        }

        // Extract all 6 data bytes upfront (bytes 1-6 of the response)
        let b0 = (read_resp / 256) % 256;
        let b1 = (read_resp / 65536) % 256;
        let b2 = (read_resp / 16777216) % 256;
        let b3 = (read_resp / 0x100000000) % 256;
        let b4 = (read_resp / 0x10000000000) % 256;
        let b5 = (read_resp / 0x1000000000000) % 256;

        // Display bytes using unrolled loop (can't use dynamic indexing with direct computation)
        if bytes_read > 0 && bytes_displayed < max_display {
            print_byte_if_printable(b0);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 1 && bytes_displayed < max_display {
            print_byte_if_printable(b1);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 2 && bytes_displayed < max_display {
            print_byte_if_printable(b2);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 3 && bytes_displayed < max_display {
            print_byte_if_printable(b3);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 4 && bytes_displayed < max_display {
            print_byte_if_printable(b4);
            bytes_displayed = bytes_displayed + 1;
        }
        if bytes_read > 5 && bytes_displayed < max_display {
            print_byte_if_printable(b5);
            bytes_displayed = bytes_displayed + 1;
        }

        offset = offset + bytes_read;
    }

    putchar(10);

    // Show truncation notice if file was larger
    if file_size > max_display {
        print_str(91, 46, 46, 46, 93, 0, 0, 0);  // "[...]"
        putchar(10);
    }
}

// Helper: print byte if it's printable ASCII, newline, or tab
fn print_byte_if_printable(byte: i64) {
    if byte >= 32 && byte < 127 {
        putchar(byte);
    } else if byte == 10 {
        putchar(10);  // newline
    } else if byte == 9 {
        putchar(32);  // tab -> space
    }
}

// Command: echo - echo remaining input
pub fn cmd_echo() {
    let len = line_len();
    // Skip "echo " (5 chars)
    let mut i: i64 = 5;
    while i < len {
        let ch = line_get(i);
        if ch != 0 {
            putchar(ch);
        }
        i = i + 1;
    }
    putchar(10);
}

// Command: clear - clear shell area
pub fn cmd_clear() {
    clear_area();
    set_cursor_x(0);
    set_cursor_y(CONSOLE_START_ROW);
}

// Command: run <filename> - execute ELF binary
pub fn cmd_run() {
    // Get filename starting at position 4 (after "run ")
    let c0 = line_get(4);
    let c1 = line_get(5);
    let c2 = line_get(6);
    let c3 = line_get(7);
    let c4 = line_get(8);
    let c5 = line_get(9);
    let c6 = line_get(10);
    let c7 = line_get(11);

    // Pack filename into i64 (little-endian)
    let name_lo = c0 + (c1 * 256) + (c2 * 65536) + (c3 * 16777216) +
                  (c4 * 0x100000000) + (c5 * 0x10000000000) +
                  (c6 * 0x1000000000000) + (c7 * 0x100000000000000);

    // Print "run: "
    print_str(114, 117, 110, 58, 32, 0, 0, 0);  // "run: "

    // Print filename
    if c0 > 0 { putchar(c0); }
    if c1 > 0 { putchar(c1); }
    if c2 > 0 { putchar(c2); }
    if c3 > 0 { putchar(c3); }
    if c4 > 0 { putchar(c4); }
    if c5 > 0 { putchar(c5); }
    if c6 > 0 { putchar(c6); }
    if c7 > 0 { putchar(c7); }
    putchar(10);

    // Execute the ELF file
    let result = runtime::exec(name_lo);

    if result >= 0 {
        // Print "PID: N"
        print_str(80, 73, 68, 58, 32, 0, 0, 0);  // "PID: "
        putchar(48 + result);
        putchar(10);
    } else {
        // Print error
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        putchar(48 - result);  // error code as digit
        putchar(10);
    }
}

// Command: kill <pid> [signal] - send signal to process
pub fn cmd_kill() {
    // Get PID from position 5 (after "kill ")
    let pid_char = line_get(5);

    // Parse single-digit PID
    let pid = pid_char - 48;

    if pid < 0 || pid >= 32 {
        print_str(69, 82, 82, 58, 32, 80, 73, 68);  // "ERR: PID"
        putchar(10);
        return;
    }

    // Check for optional signal number (default: SIGTERM=15)
    let mut signum: i64 = SIGTERM;
    let space_pos = line_get(6);
    if space_pos == 32 {
        // Parse signal number
        let sig_char = line_get(7);
        if sig_char >= 48 && sig_char <= 57 {
            signum = sig_char - 48;
            // Check for second digit
            let sig_char2 = line_get(8);
            if sig_char2 >= 48 && sig_char2 <= 57 {
                signum = signum * 10 + (sig_char2 - 48);
            }
        }
    }

    // Print "kill: PID SIG"
    print_str(107, 105, 108, 108, 58, 32, 0, 0);  // "kill: "
    putchar(48 + pid);
    putchar(32);
    if signum >= 10 {
        putchar(48 + (signum / 10));
    }
    putchar(48 + (signum % 10));
    putchar(10);

    // Send the signal
    let result = runtime::kill(pid, signum);

    if result == 0 {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);  // "OK"
        putchar(10);
    } else {
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        putchar(48 - result);
        putchar(10);
    }
}

// Command: disk - show disk status
pub fn cmd_disk() {
    let present = runtime::disk_info(0);
    let total = runtime::disk_info(1);

    // Print "Disk: "
    print_str(68, 105, 115, 107, 58, 32, 0, 0);

    if present == 0 {
        // Print "NO DISK"
        print_str(78, 79, 32, 68, 73, 83, 75, 0);
    } else {
        // Print "ATA PIO"
        print_str(65, 84, 65, 32, 80, 73, 79, 0);
        putchar(10);

        // Print "Sectors: <number>"
        print_str(83, 101, 99, 116, 111, 114, 115, 58);  // "Sectors:"
        putchar(32);
        print_dec(total);

        // Print " (~<size>MB)"
        putchar(32);
        putchar(40);  // (
        let mb = total / 2048;  // 512 bytes/sector, 1MB = 2048 sectors
        print_dec(mb);
        putchar(77);   // M
        putchar(66);   // B
        putchar(41);   // )
    }
    putchar(10);
}

// Command: sector <lba> - read and display sector
pub fn cmd_sector() {
    let present = runtime::disk_info(0);
    if present == 0 {
        print_str(78, 79, 32, 68, 73, 83, 75, 0);  // "NO DISK"
        putchar(10);
        return;
    }

    // Parse LBA from position 7 (after "sector ")
    let mut lba: i64 = 0;
    let mut pos: i64 = 7;
    let len = line_len();

    while pos < len {
        let ch = line_get(pos);
        if ch >= 48 && ch <= 57 {
            lba = lba * 10 + (ch - 48);
            pos = pos + 1;
        } else {
            pos = len;  // Exit loop
        }
    }

    // Read sector to buffer
    let bytes = runtime::disk_read(lba, 1, DISK_BUFFER_ADDR);

    if bytes < 0 {
        print_str(69, 82, 82, 58, 32, 0, 0, 0);  // "ERR: "
        print_dec(0 - bytes);
        putchar(10);
        return;
    }

    // Print "LBA <lba>:"
    print_str(76, 66, 65, 32, 0, 0, 0, 0);  // "LBA "
    print_dec(lba);
    putchar(58);  // :
    putchar(10);

    // Display first 64 bytes in hex
    let mut i: i64 = 0;
    while i < 64 {
        let byte = read_byte(DISK_BUFFER_ADDR + i);
        // Print as hex (2 digits)
        let hi = byte / 16;
        let lo = byte - (hi * 16);
        if hi < 10 {
            putchar(48 + hi);
        } else {
            putchar(65 + hi - 10);
        }
        if lo < 10 {
            putchar(48 + lo);
        } else {
            putchar(65 + lo - 10);
        }
        putchar(32);

        // Newline every 16 bytes
        let col = i + 1;
        let row_check = col / 16;
        let row_rem = col - (row_check * 16);
        if row_rem == 0 {
            putchar(10);
        }
        i = i + 1;
    }
}

// Command: health - show system service health status
pub fn cmd_health() {
    // Print header: "Service Status:"
    print_str(83, 101, 114, 118, 105, 99, 101, 32);  // "Service "
    print_str(83, 116, 97, 116, 117, 115, 58, 0);    // "Status:"
    putchar(10);

    // Service PIDs
    let init_pid: i64 = 1;
    let vfs_pid: i64 = 2;
    let console_pid: i64 = 3;
    let shell_pid: i64 = 4;

    // Check Init (PID 1)
    print_str(73, 110, 105, 116, 40, 49, 41, 58);   // "Init(1):"
    putchar(32);
    let init_state = runtime::proc_state(init_pid);
    print_service_status(init_state, init_pid);
    putchar(10);

    // Check VFS (PID 2)
    print_str(86, 70, 83, 40, 50, 41, 58, 32);      // "VFS(2): "
    let vfs_state = runtime::proc_state(vfs_pid);
    print_service_status(vfs_state, vfs_pid);
    putchar(10);

    // Check Console (PID 3)
    print_str(67, 111, 110, 115, 111, 108, 101, 40); // "Console("
    putchar(51);  // 3
    putchar(41);  // )
    putchar(58);  // :
    putchar(32);  // space
    let console_state = runtime::proc_state(console_pid);
    print_service_status(console_state, console_pid);
    putchar(10);

    // Check Shell (PID 4)
    print_str(83, 104, 101, 108, 108, 40, 52, 41);  // "Shell(4)"
    putchar(58);  // :
    putchar(32);  // space
    let shell_state = runtime::proc_state(shell_pid);
    print_service_status(shell_state, shell_pid);
    putchar(10);

    // Optional: Ping VFS to verify it responds
    putchar(10);
    print_str(86, 70, 83, 32, 80, 105, 110, 103);   // "VFS Ping"
    putchar(58);  // :
    putchar(32);  // space

    // Try to ping VFS with a simple STAT request for file 0
    drain_pending_messages();
    let my_pid = runtime::getpid();
    let ping_req = runtime::pack_vfs_request(runtime::VFS_STAT, my_pid, 0, 0, 0, 0, 0, 0);
    runtime::send(runtime::VFS_PID, ping_req);

    // Wait for response (shorter timeout for ping)
    let mut response: i64 = 0 - 1;
    let mut attempts: i64 = 0;
    while response < 0 && attempts < 5000 {
        response = runtime::recv();
        if response < 0 {
            runtime::yield_cpu();
        }
        attempts = attempts + 1;
    }

    if response >= 0 {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);        // "OK"
    } else {
        print_str(78, 79, 32, 82, 69, 83, 80, 0);   // "NO RESP"
    }
    putchar(10);
}

// Helper: print service status based on state
fn print_service_status(state: i64, pid: i64) {
    let my_pid = runtime::getpid();

    // If this is our own process (shell), show RUNNING
    if pid == my_pid {
        print_str(82, 85, 78, 78, 73, 78, 71, 0);   // "RUNNING"
    } else if state == PROC_STATE_READY {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);        // "OK"
    } else if state == PROC_STATE_RUNNING {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);        // "OK"
    } else if state == PROC_STATE_WAITING {
        print_str(79, 75, 0, 0, 0, 0, 0, 0);        // "OK" (waiting is normal for servers)
    } else if state == PROC_STATE_ZOMBIE {
        print_str(90, 79, 77, 66, 73, 69, 0, 0);    // "ZOMBIE"
    } else if state == PROC_STATE_STOPPED {
        print_str(83, 84, 79, 80, 80, 69, 68, 0);   // "STOPPED"
    } else if state == PROC_STATE_UNUSED {
        print_str(68, 79, 87, 78, 0, 0, 0, 0);      // "DOWN"
    } else {
        print_str(85, 78, 75, 78, 79, 87, 78, 0);   // "UNKNOWN"
    }
}

// Command: uptime - show system uptime in ticks
pub fn cmd_uptime() {
    let ticks = runtime::time();

    // Print "Uptime: "
    print_str(85, 112, 116, 105, 109, 101, 58, 32);  // "Uptime: "
    print_dec(ticks);
    // Print " ticks"
    print_str(32, 116, 105, 99, 107, 115, 0, 0);  // " ticks"
    putchar(10);

    // Also show approximate seconds (assuming ~100 ticks/second typical timer rate)
    // Note: actual tick rate depends on kernel timer configuration
    let seconds = ticks / 100;
    let minutes = seconds / 60;
    let hours = minutes / 60;

    // Print "(~"
    putchar(40);  // (
    putchar(126); // ~

    // Format: HH:MM:SS or just seconds if small
    if hours > 0 {
        print_dec(hours);
        putchar(104);  // h
        putchar(32);   // space
        let rem_min = minutes - (hours * 60);
        print_dec(rem_min);
        putchar(109);  // m
    } else if minutes > 0 {
        print_dec(minutes);
        putchar(109);  // m
        putchar(32);   // space
        let rem_sec = seconds - (minutes * 60);
        print_dec(rem_sec);
        putchar(115);  // s
    } else {
        print_dec(seconds);
        putchar(115);  // s
    }

    putchar(41);  // )
    putchar(10);
}

// Command: whoami - show current process information
pub fn cmd_whoami() {
    let pid = runtime::getpid();
    let ppid = runtime::getppid();

    // Print "PID: "
    print_str(80, 73, 68, 58, 32, 0, 0, 0);  // "PID: "
    print_dec(pid);
    putchar(10);

    // Print "PPID: "
    print_str(80, 80, 73, 68, 58, 32, 0, 0);  // "PPID: "
    print_dec(ppid);
    putchar(10);

    // Print "Name: shell"
    print_str(78, 97, 109, 101, 58, 32, 0, 0);  // "Name: "
    print_str(115, 104, 101, 108, 108, 0, 0, 0);  // "shell"
    putchar(10);

    // Print state
    let state = runtime::proc_state(pid);
    print_str(83, 116, 97, 116, 101, 58, 32, 0);  // "State: "
    if state == PROC_STATE_READY {
        print_str(82, 69, 65, 68, 89, 0, 0, 0);    // READY
    } else if state == PROC_STATE_RUNNING {
        print_str(82, 85, 78, 78, 73, 78, 71, 0);  // RUNNING
    } else if state == PROC_STATE_WAITING {
        print_str(87, 65, 73, 84, 73, 78, 71, 0);  // WAITING
    } else {
        print_dec(state);
    }
    putchar(10);
}

// Command: env - show system environment info
pub fn cmd_env() {
    // Get disk info
    let disk_present = runtime::disk_info(0);
    let disk_sectors = runtime::disk_info(1);

    // Get process count
    let proc_count = runtime::proc_count();

    // Get uptime
    let ticks = runtime::time();

    // Print "Procs: "
    print_str(80, 114, 111, 99, 115, 58, 32, 0);  // "Procs: "
    print_dec(proc_count);
    putchar(10);

    // Print "Uptime: "
    print_str(85, 112, 116, 105, 109, 101, 58, 32);  // "Uptime: "
    print_dec(ticks);
    putchar(10);

    // Print "Disk: "
    print_str(68, 105, 115, 107, 58, 32, 0, 0);  // "Disk: "
    if disk_present == 0 {
        print_str(110, 111, 110, 101, 0, 0, 0, 0);  // "none"
    } else {
        let mb = disk_sectors / 2048;
        print_dec(mb);
        print_str(77, 66, 0, 0, 0, 0, 0, 0);  // "MB"
    }
    putchar(10);

    // Print "Files: "
    print_str(70, 105, 108, 101, 115, 58, 32, 0);  // "Files: "
    let file_count = runtime::ramfs_file_count();
    print_dec(file_count);
    putchar(10);
}

// ============================================================================
// Network Commands
// ============================================================================

// Command: net - network subcommands
// Usage: net status | net dhcp | net config <ip> <mask> <gw>
pub fn cmd_net() {
    // Get subcommand starting at position 4 (after "net ")
    let sub0 = line_get(4);
    let sub1 = line_get(5);
    let sub2 = line_get(6);
    let sub3 = line_get(7);
    let sub4 = line_get(8);
    let sub5 = line_get(9);

    // "status" = 115, 116, 97, 116, 117, 115
    if sub0 == 115 && sub1 == 116 && sub2 == 97 && sub3 == 116 && sub4 == 117 && sub5 == 115 {
        cmd_net_status();
    }
    // "dhcp" = 100, 104, 99, 112
    else if sub0 == 100 && sub1 == 104 && sub2 == 99 && sub3 == 112 {
        cmd_net_dhcp();
    }
    // "config" = 99, 111, 110, 102, 105, 103
    else if sub0 == 99 && sub1 == 111 && sub2 == 110 && sub3 == 102 && sub4 == 105 && sub5 == 103 {
        cmd_net_config();
    }
    else {
        // Print usage
        print_str(85, 115, 97, 103, 101, 58, 32, 0);  // "Usage: "
        putchar(10);
        print_str(32, 32, 110, 101, 116, 32, 115, 116);  // "  net st"
        print_str(97, 116, 117, 115, 0, 0, 0, 0);        // "atus"
        putchar(10);
        print_str(32, 32, 110, 101, 116, 32, 100, 104);  // "  net dh"
        print_str(99, 112, 0, 0, 0, 0, 0, 0);            // "cp"
        putchar(10);
        print_str(32, 32, 110, 101, 116, 32, 99, 111);   // "  net co"
        print_str(110, 102, 105, 103, 0, 0, 0, 0);       // "nfig"
        putchar(10);
    }
}

// net status - show network status
fn cmd_net_status() {
    // Print "=== Network Status ==="
    print_str(61, 61, 61, 32, 78, 101, 116, 119);  // "=== Netw"
    print_str(111, 114, 107, 32, 83, 116, 97, 116);  // "ork Stat"
    print_str(117, 115, 32, 61, 61, 61, 0, 0);  // "us ==="
    putchar(10);

    // Check if initialized
    let init = runtime::net_status(runtime::NET_STATUS_INIT);
    print_str(73, 110, 105, 116, 58, 32, 0, 0);  // "Init: "
    if init == 1 {
        print_str(89, 101, 115, 0, 0, 0, 0, 0);  // "Yes"
    } else {
        print_str(78, 111, 0, 0, 0, 0, 0, 0);  // "No"
        putchar(10);
        return;
    }
    putchar(10);

    // Link status
    let link = runtime::net_status(runtime::NET_STATUS_LINK);
    print_str(76, 105, 110, 107, 58, 32, 0, 0);  // "Link: "
    if link == 1 {
        print_str(85, 80, 0, 0, 0, 0, 0, 0);  // "UP"
    } else {
        print_str(68, 79, 87, 78, 0, 0, 0, 0);  // "DOWN"
    }
    putchar(10);

    // MAC address
    print_str(77, 65, 67, 58, 32, 0, 0, 0);  // "MAC: "
    let mac_lo = runtime::net_getmac(0);  // bytes 0-3
    let mac_hi = runtime::net_getmac(1);  // bytes 4-5
    print_hex_byte((mac_lo / 1) % 256);
    putchar(58);  // :
    print_hex_byte((mac_lo / 256) % 256);
    putchar(58);
    print_hex_byte((mac_lo / 65536) % 256);
    putchar(58);
    print_hex_byte((mac_lo / 16777216) % 256);
    putchar(58);
    print_hex_byte((mac_hi / 1) % 256);
    putchar(58);
    print_hex_byte((mac_hi / 256) % 256);
    putchar(10);

    // IP address
    let ip = runtime::net_getip();
    print_str(73, 80, 58, 32, 0, 0, 0, 0);  // "IP: "
    if ip != 0 {
        print_ip(ip);
    } else {
        print_str(78, 111, 116, 32, 115, 101, 116, 0);  // "Not set"
    }
    putchar(10);

    // RX/TX counts
    let rx = runtime::net_status(runtime::NET_STATUS_RX_COUNT);
    let tx = runtime::net_status(runtime::NET_STATUS_TX_COUNT);
    print_str(82, 88, 58, 32, 0, 0, 0, 0);  // "RX: "
    print_dec(rx);
    print_str(32, 84, 88, 58, 32, 0, 0, 0);  // " TX: "
    print_dec(tx);
    putchar(10);
}

// net dhcp - start DHCP
fn cmd_net_dhcp() {
    print_str(83, 116, 97, 114, 116, 105, 110, 103);  // "Starting"
    print_str(32, 68, 72, 67, 80, 46, 46, 46);        // " DHCP..."
    putchar(10);

    let result = runtime::net_dhcp();
    if result >= 0 {
        print_str(68, 72, 67, 80, 32, 79, 75, 0);  // "DHCP OK"
        putchar(10);
        // Show the obtained IP
        let ip = runtime::net_getip();
        print_str(73, 80, 58, 32, 0, 0, 0, 0);  // "IP: "
        print_ip(ip);
        putchar(10);
    } else {
        print_str(68, 72, 67, 80, 32, 70, 65, 73);  // "DHCP FAI"
        print_str(76, 69, 68, 0, 0, 0, 0, 0);       // "LED"
        putchar(10);
    }
}

// net config <ip> <mask> <gw> - configure static IP
fn cmd_net_config() {
    // Parse IP addresses starting at position 11 (after "net config ")
    // For simplicity, this expects: net config a.b.c.d m.m.m.m g.g.g.g
    // We'll use a simplified parser

    let mut pos: i64 = 11;
    let ip = parse_ip_at(pos);
    if ip == 0 {
        print_str(85, 115, 97, 103, 101, 58, 32, 110);  // "Usage: n"
        print_str(101, 116, 32, 99, 111, 110, 102, 105);  // "et confi"
        print_str(103, 32, 60, 105, 112, 62, 0, 0);      // "g <ip>"
        putchar(10);
        return;
    }

    // Skip to next IP (find space, then parse)
    pos = skip_to_next_ip(pos);
    let mask = parse_ip_at(pos);
    if mask == 0 {
        // Default mask 255.255.255.0
        let default_mask = runtime::pack_ip(255, 255, 255, 0);
        let result = runtime::net_config(ip, default_mask, 0);
        print_str(67, 111, 110, 102, 105, 103, 117, 114);  // "Configur"
        print_str(101, 100, 0, 0, 0, 0, 0, 0);             // "ed"
        putchar(10);
        return;
    }

    // Skip to gateway
    pos = skip_to_next_ip(pos);
    let gw = parse_ip_at(pos);

    let result = runtime::net_config(ip, mask, gw);
    print_str(67, 111, 110, 102, 105, 103, 117, 114);  // "Configur"
    print_str(101, 100, 58, 0, 0, 0, 0, 0);            // "ed:"
    putchar(10);
    print_str(73, 80, 58, 32, 0, 0, 0, 0);  // "IP: "
    print_ip(ip);
    putchar(10);
}

// Command: ping <ip> - send ICMP echo request
pub fn cmd_ping() {
    // Parse IP address starting at position 5 (after "ping ")
    let ip = parse_ip_at(5);

    if ip == 0 {
        print_str(85, 115, 97, 103, 101, 58, 32, 112);  // "Usage: p"
        print_str(105, 110, 103, 32, 60, 105, 112, 62);  // "ing <ip>"
        putchar(10);
        return;
    }

    // Print "Pinging "
    print_str(80, 105, 110, 103, 105, 110, 103, 32);  // "Pinging "
    print_ip(ip);
    putchar(10);

    // Send ping with 1000 tick timeout
    let mut i: i64 = 0;
    while i < 4 {
        let rtt = runtime::net_ping(ip, 1000);
        if rtt >= 0 {
            print_str(82, 101, 112, 108, 121, 58, 32, 0);  // "Reply: "
            print_dec(rtt);
            print_str(32, 116, 105, 99, 107, 115, 0, 0);  // " ticks"
        } else {
            print_str(84, 105, 109, 101, 111, 117, 116, 0);  // "Timeout"
        }
        putchar(10);
        i = i + 1;

        // Small delay between pings
        let mut delay: i64 = 0;
        while delay < 10000 {
            runtime::yield_cpu();
            delay = delay + 1;
        }
    }
}

// Command: arp - show ARP cache
pub fn cmd_arp() {
    print_str(65, 82, 80, 32, 67, 97, 99, 104);  // "ARP Cach"
    print_str(101, 58, 0, 0, 0, 0, 0, 0);        // "e:"
    putchar(10);

    // Try to look up common IPs
    // Gateway is usually at .1 or .2
    let ip = runtime::net_getip();
    if ip == 0 {
        print_str(78, 111, 32, 73, 80, 0, 0, 0);  // "No IP"
        putchar(10);
        return;
    }

    // Print our own entry
    print_ip(ip);
    print_str(32, 45, 62, 32, 0, 0, 0, 0);  // " -> "
    print_str(40, 115, 101, 108, 102, 41, 0, 0);  // "(self)"
    putchar(10);

    // Try gateway (.1 and .2)
    let base = ip - (ip % 256);
    let mut gw_ip = base + 1;
    let mac = runtime::net_arp_lookup(gw_ip);
    if mac != 0 {
        print_ip(gw_ip);
        print_str(32, 45, 62, 32, 0, 0, 0, 0);  // " -> "
        print_hex_byte((mac / 1) % 256);
        putchar(58);
        print_hex_byte((mac / 256) % 256);
        putchar(58);
        print_hex_byte((mac / 65536) % 256);
        putchar(58);
        print_hex_byte((mac / 16777216) % 256);
        putchar(58);
        let mac_hi = runtime::net_arp_lookup(gw_ip + 0x80000000);  // Flag to get hi bytes
        print_hex_byte((mac_hi / 1) % 256);
        putchar(58);
        print_hex_byte((mac_hi / 256) % 256);
        putchar(10);
    }
}

// Command: nc <ip> <port> - simple netcat
pub fn cmd_nc() {
    // Parse IP at position 3 (after "nc ")
    let ip = parse_ip_at(3);
    if ip == 0 {
        print_str(85, 115, 97, 103, 101, 58, 32, 110);  // "Usage: n"
        print_str(99, 32, 60, 105, 112, 62, 32, 60);    // "c <ip> <"
        print_str(112, 111, 114, 116, 62, 0, 0, 0);     // "port>"
        putchar(10);
        return;
    }

    // Find port (after IP and space)
    let mut pos: i64 = 3;
    pos = skip_to_next_ip(pos);  // Skip past IP
    let port = parse_number_at(pos);
    if port == 0 {
        print_str(78, 101, 101, 100, 32, 112, 111, 114);  // "Need por"
        print_str(116, 0, 0, 0, 0, 0, 0, 0);              // "t"
        putchar(10);
        return;
    }

    // Print connecting message
    print_str(67, 111, 110, 110, 101, 99, 116, 105);  // "Connecti"
    print_str(110, 103, 32, 0, 0, 0, 0, 0);           // "ng "
    print_ip(ip);
    putchar(58);
    print_dec(port);
    putchar(10);

    // Create TCP socket
    let sock = runtime::net_socket(runtime::SOCK_STREAM);
    if sock < 0 {
        print_str(69, 82, 82, 58, 32, 115, 111, 99);  // "ERR: soc"
        print_str(107, 101, 116, 0, 0, 0, 0, 0);      // "ket"
        putchar(10);
        return;
    }

    // Connect
    let result = runtime::net_connect(sock, ip, port);
    if result < 0 {
        print_str(69, 82, 82, 58, 32, 99, 111, 110);  // "ERR: con"
        print_str(110, 101, 99, 116, 0, 0, 0, 0);     // "nect"
        putchar(10);
        runtime::net_close(sock);
        return;
    }

    print_str(67, 111, 110, 110, 101, 99, 116, 101);  // "Connecte"
    print_str(100, 33, 0, 0, 0, 0, 0, 0);             // "d!"
    putchar(10);

    // Simple test: try to receive some data
    let buf_addr = DISK_BUFFER_ADDR;  // Reuse disk buffer
    let recv_len = runtime::net_recv_data(sock, buf_addr, 256);
    if recv_len > 0 {
        print_str(82, 101, 99, 118, 58, 32, 0, 0);  // "Recv: "
        print_dec(recv_len);
        print_str(32, 98, 121, 116, 101, 115, 0, 0);  // " bytes"
        putchar(10);
    }

    runtime::net_close(sock);
    print_str(67, 108, 111, 115, 101, 100, 0, 0);  // "Closed"
    putchar(10);
}

// ============================================================================
// Network Helper Functions
// ============================================================================

// Print IP address in dotted decimal
fn print_ip(ip: i64) {
    print_dec(runtime::ip_byte(ip, 0));
    putchar(46);  // .
    print_dec(runtime::ip_byte(ip, 1));
    putchar(46);
    print_dec(runtime::ip_byte(ip, 2));
    putchar(46);
    print_dec(runtime::ip_byte(ip, 3));
}

// Print hex byte (2 digits)
fn print_hex_byte(b: i64) {
    let hi = (b / 16) % 16;
    let lo = b % 16;
    if hi < 10 {
        putchar(48 + hi);
    } else {
        putchar(65 + hi - 10);
    }
    if lo < 10 {
        putchar(48 + lo);
    } else {
        putchar(65 + lo - 10);
    }
}

// Parse IP address from line buffer at given position
// Returns packed IP or 0 on error
fn parse_ip_at(start: i64) -> i64 {
    let mut pos = start;
    let len = line_len();

    // Skip leading spaces
    while pos < len && line_get(pos) == 32 {
        pos = pos + 1;
    }

    // Parse four octets
    let mut octets: [i64; 4] = [0; 4];
    let mut octet_idx: i64 = 0;
    let mut current: i64 = 0;
    let mut has_digit: i64 = 0;

    while pos < len && octet_idx < 4 {
        let ch = line_get(pos);
        if ch >= 48 && ch <= 57 {
            // Digit
            current = current * 10 + (ch - 48);
            has_digit = 1;
        } else if ch == 46 && has_digit == 1 {
            // Dot - save octet and move to next
            octets[octet_idx as usize] = current;
            octet_idx = octet_idx + 1;
            current = 0;
            has_digit = 0;
        } else if ch == 32 || ch == 0 {
            // Space or end - save last octet
            if has_digit == 1 {
                octets[octet_idx as usize] = current;
                octet_idx = octet_idx + 1;
            }
            pos = len;  // Exit loop
        } else {
            // Invalid character
            pos = len;
        }
        pos = pos + 1;
    }

    // Need exactly 4 octets
    if octet_idx != 4 {
        return 0;
    }

    // Validate ranges
    let mut i: i64 = 0;
    while i < 4 {
        if octets[i as usize] > 255 {
            return 0;
        }
        i = i + 1;
    }

    runtime::pack_ip(octets[0], octets[1], octets[2], octets[3])
}

// Skip to next token (past current word and space)
fn skip_to_next_ip(start: i64) -> i64 {
    let mut pos = start;
    let len = line_len();

    // Skip non-spaces (current token)
    while pos < len && line_get(pos) != 32 && line_get(pos) != 0 {
        pos = pos + 1;
    }

    // Skip spaces
    while pos < len && line_get(pos) == 32 {
        pos = pos + 1;
    }

    pos
}

// Parse number at position
fn parse_number_at(start: i64) -> i64 {
    let mut pos = start;
    let len = line_len();

    // Skip leading spaces
    while pos < len && line_get(pos) == 32 {
        pos = pos + 1;
    }

    let mut num: i64 = 0;
    let mut has_digit: i64 = 0;

    while pos < len {
        let ch = line_get(pos);
        if ch >= 48 && ch <= 57 {
            num = num * 10 + (ch - 48);
            has_digit = 1;
        } else {
            pos = len;  // Exit
        }
        pos = pos + 1;
    }

    if has_digit == 1 { num } else { 0 }
}

// ============================================================================
// HTTP Commands
// ============================================================================

// HTTP module memory addresses (must match http.gl)
const HTTP_TX_BUF: i64 = 0xB40000;
const HTTP_RX_BODY_BUF: i64 = 0xB42000;
const HTTP_STATE: i64 = 0xB52000;
const HTTP_STATE_STATUS: i64 = 8;
const HTTP_STATE_BODY_LEN: i64 = 18;
const HTTP_STATE_ERROR: i64 = 32;

// URL parsing addresses (must match url.gl)
const URL_BUF_ADDR: i64 = 0xB43000;
const URL_HOST_ADDR: i64 = 0xB43110;
const URL_PATH_ADDR: i64 = 0xB43190;
const URL_STATE_ADDR: i64 = 0xB43390;
const URL_STATE_PORT: i64 = 4;
const URL_STATE_HTTPS: i64 = 6;

// Command: http <url> - Perform HTTP GET request
pub fn cmd_http() {
    // Get URL starting at position 5 (after "http ")
    let url_start = 5;
    let url_len = line_len() - url_start;

    if url_len <= 0 {
        print_str(85, 115, 97, 103, 101, 58, 32, 104);  // "Usage: h"
        print_str(116, 116, 112, 32, 60, 117, 114, 108); // "ttp <url"
        print_str(62, 0, 0, 0, 0, 0, 0, 0);              // ">"
        putchar(10);
        print_str(69, 120, 97, 109, 112, 108, 101, 58);  // "Example:"
        putchar(10);
        print_str(32, 32, 104, 116, 116, 112, 32, 104);  // "  http h"
        print_str(116, 116, 112, 58, 47, 47, 101, 120);  // "ttp://ex"
        print_str(97, 109, 112, 108, 101, 46, 99, 111);  // "ample.co"
        print_str(109, 47, 0, 0, 0, 0, 0, 0);            // "m/"
        putchar(10);
        return;
    }

    // Copy URL to buffer
    let mut i: i64 = 0;
    while i < url_len && i < 250 {
        write_byte(URL_BUF_ADDR + i, line_get(url_start + i));
        i = i + 1;
    }
    write_byte(URL_BUF_ADDR + i, 0);

    // Initialize HTTP client
    http_init_state();

    // Parse URL
    print_str(80, 97, 114, 115, 105, 110, 103, 32);  // "Parsing "
    print_str(85, 82, 76, 46, 46, 46, 0, 0);          // "URL..."
    putchar(10);

    let parse_result = http_parse_url(URL_BUF_ADDR);
    if parse_result == 0 {
        print_str(69, 82, 82, 58, 32, 73, 110, 118);  // "ERR: Inv"
        print_str(97, 108, 105, 100, 32, 85, 82, 76);  // "alid URL"
        putchar(10);
        return;
    }

    // Check for HTTPS
    let is_https = read_byte(URL_STATE_ADDR + URL_STATE_HTTPS);
    if is_https == 1 {
        print_str(69, 82, 82, 58, 32, 72, 84, 84);    // "ERR: HTT"
        print_str(80, 83, 32, 110, 111, 116, 32, 115); // "PS not s"
        print_str(117, 112, 112, 111, 114, 116, 101, 100); // "upported"
        putchar(10);
        return;
    }

    // Show parsed info
    print_str(72, 111, 115, 116, 58, 32, 0, 0);  // "Host: "
    http_print_string(URL_HOST_ADDR, 64);
    putchar(10);

    let port = http_read_u16_at(URL_STATE_ADDR + URL_STATE_PORT);
    print_str(80, 111, 114, 116, 58, 32, 0, 0);  // "Port: "
    print_dec(port);
    putchar(10);

    print_str(80, 97, 116, 104, 58, 32, 0, 0);  // "Path: "
    http_print_string(URL_PATH_ADDR, 64);
    putchar(10);

    // Resolve hostname
    print_str(82, 101, 115, 111, 108, 118, 105, 110);  // "Resolvin"
    print_str(103, 32, 68, 78, 83, 46, 46, 46);         // "g DNS..."
    putchar(10);

    // Copy hostname to temp buffer (DISK_BUFFER_ADDR)
    http_copy_string(URL_HOST_ADDR, DISK_BUFFER_ADDR, 128);

    let ip = runtime::net_resolve(DISK_BUFFER_ADDR);
    if ip == 0 {
        print_str(69, 82, 82, 58, 32, 68, 78, 83);  // "ERR: DNS"
        print_str(32, 102, 97, 105, 108, 101, 100, 0); // " failed"
        putchar(10);
        return;
    }

    print_str(73, 80, 58, 32, 0, 0, 0, 0);  // "IP: "
    print_ip(ip);
    putchar(10);

    // Connect
    print_str(67, 111, 110, 110, 101, 99, 116, 105);  // "Connecti"
    print_str(110, 103, 46, 46, 46, 0, 0, 0);          // "ng..."
    putchar(10);

    let sock = runtime::net_socket(runtime::SOCK_STREAM);
    if sock < 0 {
        print_str(69, 82, 82, 58, 32, 83, 111, 99);  // "ERR: Soc"
        print_str(107, 101, 116, 0, 0, 0, 0, 0);      // "ket"
        putchar(10);
        return;
    }

    let connect_result = runtime::net_connect(sock, ip, port);
    if connect_result < 0 {
        print_str(69, 82, 82, 58, 32, 67, 111, 110);  // "ERR: Con"
        print_str(110, 101, 99, 116, 0, 0, 0, 0);      // "nect"
        putchar(10);
        runtime::net_close(sock);
        return;
    }

    print_str(67, 111, 110, 110, 101, 99, 116, 101);  // "Connecte"
    print_str(100, 33, 0, 0, 0, 0, 0, 0);              // "d!"
    putchar(10);

    // Build HTTP request
    print_str(83, 101, 110, 100, 105, 110, 103, 32);  // "Sending "
    print_str(114, 101, 113, 117, 101, 115, 116, 46); // "request."
    print_str(46, 46, 0, 0, 0, 0, 0, 0);               // ".."
    putchar(10);

    let req_len = http_build_get_request(port);

    let sent = runtime::net_send_data(sock, HTTP_TX_BUF, req_len);
    if sent < 0 {
        print_str(69, 82, 82, 58, 32, 83, 101, 110);  // "ERR: Sen"
        print_str(100, 0, 0, 0, 0, 0, 0, 0);           // "d"
        putchar(10);
        runtime::net_close(sock);
        return;
    }

    // Receive response
    print_str(82, 101, 99, 101, 105, 118, 105, 110);  // "Receivin"
    print_str(103, 46, 46, 46, 0, 0, 0, 0);            // "g..."
    putchar(10);

    let mut total_recv: i64 = 0;
    let max_recv: i64 = 4096;  // 4KB buffer
    let mut done: i64 = 0;

    while done == 0 && total_recv < max_recv {
        let recv_len = runtime::net_recv_data(sock, HTTP_RX_BODY_BUF + total_recv, max_recv - total_recv);
        if recv_len > 0 {
            total_recv = total_recv + recv_len;
        } else if recv_len < 0 {
            done = 1;
        } else {
            // Check if we have headers complete (look for \r\n\r\n)
            if http_find_header_end(total_recv) > 0 {
                done = 1;
            }
            runtime::yield_cpu();
        }
    }

    runtime::net_close(sock);

    // Parse and display response
    if total_recv > 0 {
        print_str(82, 101, 99, 101, 105, 118, 101, 100);  // "Received"
        print_str(58, 32, 0, 0, 0, 0, 0, 0);               // ": "
        print_dec(total_recv);
        print_str(32, 98, 121, 116, 101, 115, 0, 0);       // " bytes"
        putchar(10);
        putchar(10);

        // Find status code in first line
        let status = http_parse_status_code();
        print_str(83, 116, 97, 116, 117, 115, 58, 32);  // "Status: "
        print_dec(status);
        putchar(10);
        putchar(10);

        // Find body start and display first part
        let body_start = http_find_header_end(total_recv);
        if body_start > 0 {
            let body_len = total_recv - body_start - 4;
            let display_len = if body_len > 512 { 512 } else { body_len };

            print_str(66, 111, 100, 121, 58, 0, 0, 0);  // "Body:"
            putchar(10);
            print_str(45, 45, 45, 45, 45, 45, 45, 45);  // "--------"
            putchar(10);

            http_display_body(body_start + 4, display_len);

            if body_len > display_len {
                putchar(10);
                print_str(91, 46, 46, 46, 32, 116, 114, 117);  // "[... tru"
                print_str(110, 99, 97, 116, 101, 100, 93, 0);   // "ncated]"
                putchar(10);
            }
        }
    } else {
        print_str(78, 111, 32, 114, 101, 115, 112, 111);  // "No respo"
        print_str(110, 115, 101, 0, 0, 0, 0, 0);           // "nse"
        putchar(10);
    }
}

// Command: wget <url> - Download URL content
pub fn cmd_wget() {
    // Same as http but different name
    cmd_http();
}

// Command: curl <url> - Alias for http
pub fn cmd_curl() {
    cmd_http();
}

// ============================================================================
// HTTP Helper Functions
// ============================================================================

// Initialize HTTP state
fn http_init_state() {
    let mut i: i64 = 0;
    while i < 128 {
        write_byte(HTTP_STATE + i, 0);
        i = i + 1;
    }
}

// Parse URL (simplified - calls url module logic inline)
fn http_parse_url(url_addr: i64) -> i64 {
    // Clear state
    let mut i: i64 = 0;
    while i < 256 {
        write_byte(URL_STATE_ADDR - 0x290 + i, 0);  // Clear all URL buffers
        i = i + 1;
    }

    let mut pos: i64 = 0;
    let mut len: i64 = 0;

    // Get URL length
    while len < 250 && read_byte(url_addr + len) != 0 {
        len = len + 1;
    }

    if len == 0 {
        return 0;
    }

    // Check for http:// or https://
    let c0 = http_to_lower(read_byte(url_addr));
    let c1 = http_to_lower(read_byte(url_addr + 1));
    let c2 = http_to_lower(read_byte(url_addr + 2));
    let c3 = http_to_lower(read_byte(url_addr + 3));

    if c0 != 104 || c1 != 116 || c2 != 116 || c3 != 112 {
        // Not http, try adding default scheme
        return 0;
    }

    let c4 = http_to_lower(read_byte(url_addr + 4));
    let is_https: i64;
    let host_start: i64;

    if c4 == 115 {
        // https
        is_https = 1;
        if read_byte(url_addr + 5) != 58 || read_byte(url_addr + 6) != 47 || read_byte(url_addr + 7) != 47 {
            return 0;
        }
        host_start = 8;
        http_write_u16_at(URL_STATE_ADDR + URL_STATE_PORT, 443);
    } else if c4 == 58 {
        // http
        is_https = 0;
        if read_byte(url_addr + 5) != 47 || read_byte(url_addr + 6) != 47 {
            return 0;
        }
        host_start = 7;
        http_write_u16_at(URL_STATE_ADDR + URL_STATE_PORT, 80);
    } else {
        return 0;
    }

    write_byte(URL_STATE_ADDR + URL_STATE_HTTPS, is_https);

    // Find end of host (first / or : or end)
    let mut host_end = host_start;
    while host_end < len {
        let ch = read_byte(url_addr + host_end);
        if ch == 47 || ch == 58 || ch == 0 {
            break;
        }
        host_end = host_end + 1;
    }

    // Copy host
    let host_len = host_end - host_start;
    i = 0;
    while i < host_len && i < 127 {
        write_byte(URL_HOST_ADDR + i, read_byte(url_addr + host_start + i));
        i = i + 1;
    }
    write_byte(URL_HOST_ADDR + i, 0);

    // Check for port
    if host_end < len && read_byte(url_addr + host_end) == 58 {
        let mut port: i64 = 0;
        let mut port_pos = host_end + 1;
        while port_pos < len {
            let ch = read_byte(url_addr + port_pos);
            if ch >= 48 && ch <= 57 {
                port = port * 10 + (ch - 48);
            } else {
                break;
            }
            port_pos = port_pos + 1;
        }
        if port > 0 && port <= 65535 {
            http_write_u16_at(URL_STATE_ADDR + URL_STATE_PORT, port);
        }
        host_end = port_pos;
    }

    // Copy path (everything after host:port)
    let mut path_pos: i64 = 0;
    if host_end < len && read_byte(url_addr + host_end) == 47 {
        while host_end < len && path_pos < 255 {
            let ch = read_byte(url_addr + host_end);
            if ch == 0 {
                break;
            }
            write_byte(URL_PATH_ADDR + path_pos, ch);
            path_pos = path_pos + 1;
            host_end = host_end + 1;
        }
    }

    // Default path
    if path_pos == 0 {
        write_byte(URL_PATH_ADDR, 47);  // '/'
        path_pos = 1;
    }
    write_byte(URL_PATH_ADDR + path_pos, 0);

    1
}

// Build GET request
fn http_build_get_request(port: i64) -> i64 {
    let buf = HTTP_TX_BUF;
    let mut pos: i64 = 0;

    // "GET "
    write_byte(buf + pos, 71);  pos = pos + 1;
    write_byte(buf + pos, 69);  pos = pos + 1;
    write_byte(buf + pos, 84);  pos = pos + 1;
    write_byte(buf + pos, 32);  pos = pos + 1;

    // Path
    let mut i: i64 = 0;
    while i < 255 {
        let ch = read_byte(URL_PATH_ADDR + i);
        if ch == 0 { break; }
        write_byte(buf + pos, ch);
        pos = pos + 1;
        i = i + 1;
    }

    // " HTTP/1.1\r\n"
    write_byte(buf + pos, 32);  pos = pos + 1;  // space
    write_byte(buf + pos, 72);  pos = pos + 1;  // H
    write_byte(buf + pos, 84);  pos = pos + 1;  // T
    write_byte(buf + pos, 84);  pos = pos + 1;  // T
    write_byte(buf + pos, 80);  pos = pos + 1;  // P
    write_byte(buf + pos, 47);  pos = pos + 1;  // /
    write_byte(buf + pos, 49);  pos = pos + 1;  // 1
    write_byte(buf + pos, 46);  pos = pos + 1;  // .
    write_byte(buf + pos, 49);  pos = pos + 1;  // 1
    write_byte(buf + pos, 13);  pos = pos + 1;  // \r
    write_byte(buf + pos, 10);  pos = pos + 1;  // \n

    // "Host: "
    write_byte(buf + pos, 72);  pos = pos + 1;  // H
    write_byte(buf + pos, 111); pos = pos + 1;  // o
    write_byte(buf + pos, 115); pos = pos + 1;  // s
    write_byte(buf + pos, 116); pos = pos + 1;  // t
    write_byte(buf + pos, 58);  pos = pos + 1;  // :
    write_byte(buf + pos, 32);  pos = pos + 1;  // space

    // Hostname
    i = 0;
    while i < 127 {
        let ch = read_byte(URL_HOST_ADDR + i);
        if ch == 0 { break; }
        write_byte(buf + pos, ch);
        pos = pos + 1;
        i = i + 1;
    }

    // Add port if non-standard
    if port != 80 {
        write_byte(buf + pos, 58);  pos = pos + 1;  // :
        pos = http_write_number(buf, pos, port);
    }

    write_byte(buf + pos, 13);  pos = pos + 1;  // \r
    write_byte(buf + pos, 10);  pos = pos + 1;  // \n

    // "User-Agent: GenesisOS/1.0\r\n"
    write_byte(buf + pos, 85);  pos = pos + 1;  // U
    write_byte(buf + pos, 115); pos = pos + 1;  // s
    write_byte(buf + pos, 101); pos = pos + 1;  // e
    write_byte(buf + pos, 114); pos = pos + 1;  // r
    write_byte(buf + pos, 45);  pos = pos + 1;  // -
    write_byte(buf + pos, 65);  pos = pos + 1;  // A
    write_byte(buf + pos, 103); pos = pos + 1;  // g
    write_byte(buf + pos, 101); pos = pos + 1;  // e
    write_byte(buf + pos, 110); pos = pos + 1;  // n
    write_byte(buf + pos, 116); pos = pos + 1;  // t
    write_byte(buf + pos, 58);  pos = pos + 1;  // :
    write_byte(buf + pos, 32);  pos = pos + 1;  // space
    write_byte(buf + pos, 71);  pos = pos + 1;  // G
    write_byte(buf + pos, 101); pos = pos + 1;  // e
    write_byte(buf + pos, 110); pos = pos + 1;  // n
    write_byte(buf + pos, 101); pos = pos + 1;  // e
    write_byte(buf + pos, 115); pos = pos + 1;  // s
    write_byte(buf + pos, 105); pos = pos + 1;  // i
    write_byte(buf + pos, 115); pos = pos + 1;  // s
    write_byte(buf + pos, 79);  pos = pos + 1;  // O
    write_byte(buf + pos, 83);  pos = pos + 1;  // S
    write_byte(buf + pos, 47);  pos = pos + 1;  // /
    write_byte(buf + pos, 49);  pos = pos + 1;  // 1
    write_byte(buf + pos, 46);  pos = pos + 1;  // .
    write_byte(buf + pos, 48);  pos = pos + 1;  // 0
    write_byte(buf + pos, 13);  pos = pos + 1;  // \r
    write_byte(buf + pos, 10);  pos = pos + 1;  // \n

    // "Accept: */*\r\n"
    write_byte(buf + pos, 65);  pos = pos + 1;  // A
    write_byte(buf + pos, 99);  pos = pos + 1;  // c
    write_byte(buf + pos, 99);  pos = pos + 1;  // c
    write_byte(buf + pos, 101); pos = pos + 1;  // e
    write_byte(buf + pos, 112); pos = pos + 1;  // p
    write_byte(buf + pos, 116); pos = pos + 1;  // t
    write_byte(buf + pos, 58);  pos = pos + 1;  // :
    write_byte(buf + pos, 32);  pos = pos + 1;  // space
    write_byte(buf + pos, 42);  pos = pos + 1;  // *
    write_byte(buf + pos, 47);  pos = pos + 1;  // /
    write_byte(buf + pos, 42);  pos = pos + 1;  // *
    write_byte(buf + pos, 13);  pos = pos + 1;  // \r
    write_byte(buf + pos, 10);  pos = pos + 1;  // \n

    // "Connection: close\r\n"
    write_byte(buf + pos, 67);  pos = pos + 1;  // C
    write_byte(buf + pos, 111); pos = pos + 1;  // o
    write_byte(buf + pos, 110); pos = pos + 1;  // n
    write_byte(buf + pos, 110); pos = pos + 1;  // n
    write_byte(buf + pos, 101); pos = pos + 1;  // e
    write_byte(buf + pos, 99);  pos = pos + 1;  // c
    write_byte(buf + pos, 116); pos = pos + 1;  // t
    write_byte(buf + pos, 105); pos = pos + 1;  // i
    write_byte(buf + pos, 111); pos = pos + 1;  // o
    write_byte(buf + pos, 110); pos = pos + 1;  // n
    write_byte(buf + pos, 58);  pos = pos + 1;  // :
    write_byte(buf + pos, 32);  pos = pos + 1;  // space
    write_byte(buf + pos, 99);  pos = pos + 1;  // c
    write_byte(buf + pos, 108); pos = pos + 1;  // l
    write_byte(buf + pos, 111); pos = pos + 1;  // o
    write_byte(buf + pos, 115); pos = pos + 1;  // s
    write_byte(buf + pos, 101); pos = pos + 1;  // e
    write_byte(buf + pos, 13);  pos = pos + 1;  // \r
    write_byte(buf + pos, 10);  pos = pos + 1;  // \n

    // End headers "\r\n"
    write_byte(buf + pos, 13);  pos = pos + 1;  // \r
    write_byte(buf + pos, 10);  pos = pos + 1;  // \n

    write_byte(buf + pos, 0);  // null terminate

    pos
}

// Find end of HTTP headers (\r\n\r\n)
fn http_find_header_end(len: i64) -> i64 {
    let buf = HTTP_RX_BODY_BUF;
    let mut i: i64 = 0;
    while i < len - 3 {
        if read_byte(buf + i) == 13 &&
           read_byte(buf + i + 1) == 10 &&
           read_byte(buf + i + 2) == 13 &&
           read_byte(buf + i + 3) == 10 {
            return i;
        }
        i = i + 1;
    }
    0
}

// Parse HTTP status code from response
fn http_parse_status_code() -> i64 {
    let buf = HTTP_RX_BODY_BUF;
    // Find first space (after HTTP/1.x)
    let mut i: i64 = 0;
    while i < 20 {
        if read_byte(buf + i) == 32 {
            break;
        }
        i = i + 1;
    }
    i = i + 1;  // Skip space

    // Parse 3-digit status code
    let mut status: i64 = 0;
    let mut digits: i64 = 0;
    while digits < 3 && i < 20 {
        let ch = read_byte(buf + i);
        if ch >= 48 && ch <= 57 {
            status = status * 10 + (ch - 48);
            digits = digits + 1;
        } else {
            break;
        }
        i = i + 1;
    }
    status
}

// Display body content (printable characters only)
fn http_display_body(start: i64, len: i64) {
    let buf = HTTP_RX_BODY_BUF;
    let mut i: i64 = 0;
    while i < len {
        let ch = read_byte(buf + start + i);
        if ch >= 32 && ch < 127 {
            putchar(ch);
        } else if ch == 10 {
            putchar(10);
        } else if ch == 9 {
            putchar(32);  // Tab -> space
        }
        i = i + 1;
    }
}

// Print string from address
fn http_print_string(addr: i64, max_len: i64) {
    let mut i: i64 = 0;
    while i < max_len {
        let ch = read_byte(addr + i);
        if ch == 0 { return; }
        putchar(ch);
        i = i + 1;
    }
}

// Copy string
fn http_copy_string(src: i64, dst: i64, max_len: i64) {
    let mut i: i64 = 0;
    while i < max_len - 1 {
        let ch = read_byte(src + i);
        write_byte(dst + i, ch);
        if ch == 0 { return; }
        i = i + 1;
    }
    write_byte(dst + max_len - 1, 0);
}

// Write decimal number to buffer
fn http_write_number(buf: i64, pos: i64, val: i64) -> i64 {
    if val == 0 {
        write_byte(buf + pos, 48);
        return pos + 1;
    }

    // Count digits
    let mut temp = val;
    let mut digits: i64 = 0;
    while temp > 0 {
        temp = temp / 10;
        digits = digits + 1;
    }

    // Write in reverse
    let mut p = pos + digits - 1;
    temp = val;
    while temp > 0 {
        write_byte(buf + p, 48 + (temp % 10));
        temp = temp / 10;
        p = p - 1;
    }

    pos + digits
}

// To lowercase
fn http_to_lower(ch: i64) -> i64 {
    if ch >= 65 && ch <= 90 {
        return ch + 32;
    }
    ch
}

// Read 16-bit value
fn http_read_u16_at(addr: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "movzwq (%rdi), %rax",
            in("rdi") addr,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// Write 16-bit value
fn http_write_u16_at(addr: i64, val: i64) {
    unsafe {
        asm!(
            "movw %si, (%rdi)",
            in("rdi") addr,
            in("si") val,
            options(nostack, att_syntax)
        );
    }
}
