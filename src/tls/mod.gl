// TLS 1.2 Implementation
// RFC 5246 compliant Transport Layer Security

pub mod record;

use record::{RecordLayer, TlsRecord, encrypt_record, decrypt_record};
use record::{TLS_VERSION_1_2, CONTENT_TYPE_HANDSHAKE, CONTENT_TYPE_CHANGE_CIPHER_SPEC};
use record::{CONTENT_TYPE_APPLICATION_DATA, CONTENT_TYPE_ALERT};

use super::crypto::{sha256, hmac_sha256, hkdf_sha256, random_bytes, Sha256};
use super::crypto::{aes_128_gcm_encrypt, aes_128_gcm_decrypt};

// ============================================================
// TLS Handshake Message Types
// ============================================================

const HANDSHAKE_CLIENT_HELLO: u8 = 1;
const HANDSHAKE_SERVER_HELLO: u8 = 2;
const HANDSHAKE_CERTIFICATE: u8 = 11;
const HANDSHAKE_SERVER_KEY_EXCHANGE: u8 = 12;
const HANDSHAKE_CERTIFICATE_REQUEST: u8 = 13;
const HANDSHAKE_SERVER_HELLO_DONE: u8 = 14;
const HANDSHAKE_CERTIFICATE_VERIFY: u8 = 15;
const HANDSHAKE_CLIENT_KEY_EXCHANGE: u8 = 16;
const HANDSHAKE_FINISHED: u8 = 20;

// ============================================================
// Cipher Suites
// ============================================================

pub const TLS_RSA_WITH_AES_128_GCM_SHA256: u16 = 0x009C;
pub const TLS_RSA_WITH_AES_256_GCM_SHA384: u16 = 0x009D;
pub const TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256: u16 = 0xC02F;
pub const TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384: u16 = 0xC030;

// ============================================================
// TLS Alert Levels and Descriptions
// ============================================================

pub const ALERT_LEVEL_WARNING: u8 = 1;
pub const ALERT_LEVEL_FATAL: u8 = 2;

pub const ALERT_CLOSE_NOTIFY: u8 = 0;
pub const ALERT_UNEXPECTED_MESSAGE: u8 = 10;
pub const ALERT_BAD_RECORD_MAC: u8 = 20;
pub const ALERT_DECRYPTION_FAILED: u8 = 21;
pub const ALERT_RECORD_OVERFLOW: u8 = 22;
pub const ALERT_HANDSHAKE_FAILURE: u8 = 40;
pub const ALERT_BAD_CERTIFICATE: u8 = 42;
pub const ALERT_CERTIFICATE_EXPIRED: u8 = 45;
pub const ALERT_CERTIFICATE_UNKNOWN: u8 = 46;
pub const ALERT_ILLEGAL_PARAMETER: u8 = 47;
pub const ALERT_UNKNOWN_CA: u8 = 48;
pub const ALERT_DECODE_ERROR: u8 = 50;
pub const ALERT_DECRYPT_ERROR: u8 = 51;
pub const ALERT_PROTOCOL_VERSION: u8 = 70;
pub const ALERT_INTERNAL_ERROR: u8 = 80;

// ============================================================
// TLS Connection State
// ============================================================

#[derive(Clone, Copy, PartialEq)]
pub enum TlsState {
    Initial,
    ClientHelloSent,
    ServerHelloReceived,
    CertificateReceived,
    ServerKeyExchangeReceived,
    ServerHelloDoneReceived,
    ClientKeyExchangeSent,
    ChangeCipherSpecSent,
    FinishedSent,
    Connected,
    Closed,
    Error,
}

#[repr(C)]
pub struct TlsConnection {
    state: TlsState,
    record_layer: RecordLayer,

    // Handshake data
    client_random: [u8; 32],
    server_random: [u8; 32],
    session_id: Vec<u8>,
    cipher_suite: u16,

    // Key material
    pre_master_secret: Vec<u8>,
    master_secret: [u8; 48],

    // Handshake hash (for Finished verification)
    handshake_hash: Sha256,

    // Server certificate (DER encoded)
    server_certificate: Vec<u8>,

    // Server name for SNI
    server_name: Vec<u8>,

    // Error description
    last_error: u8,

    // Socket operations (function pointers stored as u64)
    socket_read_fn: u64,
    socket_write_fn: u64,
    socket_data: u64,
}

impl TlsConnection {
    pub fn new(server_name: &[u8]) -> TlsConnection {
        let mut conn = TlsConnection {
            state: TlsState::Initial,
            record_layer: RecordLayer::new(true),
            client_random: [0; 32],
            server_random: [0; 32],
            session_id: Vec::new(),
            cipher_suite: 0,
            pre_master_secret: Vec::new(),
            master_secret: [0; 48],
            handshake_hash: Sha256::new(),
            server_certificate: Vec::new(),
            server_name: Vec::new(),
            last_error: 0,
            socket_read_fn: 0,
            socket_write_fn: 0,
            socket_data: 0,
        };

        // Copy server name
        let mut i: usize = 0;
        while i < server_name.len() {
            conn.server_name.push(server_name[i]);
            i = i + 1;
        }

        // Generate client random
        let rand = random_bytes(32);
        i = 0;
        while i < 32 {
            conn.client_random[i] = rand[i];
            i = i + 1;
        }

        conn
    }

    // Set socket callbacks
    pub fn set_socket_callbacks(
        &mut self,
        read_fn: fn(u64, &mut [u8]) -> i64,
        write_fn: fn(u64, &[u8]) -> i64,
        socket_data: u64,
    ) {
        self.socket_read_fn = read_fn as u64;
        self.socket_write_fn = write_fn as u64;
        self.socket_data = socket_data;
    }

    // Perform TLS handshake
    pub fn handshake(&mut self) -> bool {
        // Send ClientHello
        if !self.send_client_hello() {
            return false;
        }

        // Receive ServerHello, Certificate, ServerKeyExchange, ServerHelloDone
        if !self.receive_server_messages() {
            return false;
        }

        // Send ClientKeyExchange, ChangeCipherSpec, Finished
        if !self.send_client_finish() {
            return false;
        }

        // Receive ChangeCipherSpec, Finished
        if !self.receive_server_finish() {
            return false;
        }

        self.state = TlsState::Connected;
        true
    }

    // Send ClientHello
    fn send_client_hello(&mut self) -> bool {
        let mut hello = Vec::new();

        // Version: TLS 1.2
        hello.push((TLS_VERSION_1_2 >> 8) as u8);
        hello.push(TLS_VERSION_1_2 as u8);

        // Client random
        let mut i: usize = 0;
        while i < 32 {
            hello.push(self.client_random[i]);
            i = i + 1;
        }

        // Session ID (empty)
        hello.push(0);

        // Cipher suites
        let suites = [
            TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
            TLS_RSA_WITH_AES_128_GCM_SHA256,
        ];
        hello.push(0);
        hello.push((suites.len() * 2) as u8);
        i = 0;
        while i < suites.len() {
            hello.push((suites[i] >> 8) as u8);
            hello.push(suites[i] as u8);
            i = i + 1;
        }

        // Compression methods (null only)
        hello.push(1);
        hello.push(0);

        // Extensions
        let mut extensions = Vec::new();

        // SNI extension
        if self.server_name.len() > 0 {
            // Extension type: server_name (0)
            extensions.push(0);
            extensions.push(0);

            let name_len = self.server_name.len();
            let list_len = name_len + 3;
            let ext_len = list_len + 2;

            extensions.push((ext_len >> 8) as u8);
            extensions.push(ext_len as u8);
            extensions.push((list_len >> 8) as u8);
            extensions.push(list_len as u8);
            extensions.push(0);  // Host name type
            extensions.push((name_len >> 8) as u8);
            extensions.push(name_len as u8);

            i = 0;
            while i < name_len {
                extensions.push(self.server_name[i]);
                i = i + 1;
            }
        }

        // Supported versions extension (for compatibility)
        // Signature algorithms extension
        extensions.push(0);
        extensions.push(13);  // signature_algorithms
        extensions.push(0);
        extensions.push(8);   // Length
        extensions.push(0);
        extensions.push(6);   // Algorithms length
        extensions.push(4);   // rsa_pkcs1_sha256
        extensions.push(1);
        extensions.push(5);   // rsa_pkcs1_sha384
        extensions.push(1);
        extensions.push(6);   // rsa_pkcs1_sha512
        extensions.push(1);

        // Add extensions length
        let ext_len = extensions.len();
        hello.push((ext_len >> 8) as u8);
        hello.push(ext_len as u8);
        i = 0;
        while i < extensions.len() {
            hello.push(extensions[i]);
            i = i + 1;
        }

        // Build handshake message
        let msg = self.build_handshake_message(HANDSHAKE_CLIENT_HELLO, &hello);

        // Update handshake hash
        self.handshake_hash.update(&msg);

        // Send as record
        let record = TlsRecord::new(CONTENT_TYPE_HANDSHAKE, msg);
        if !self.send_record(&record) {
            return false;
        }

        self.state = TlsState::ClientHelloSent;
        true
    }

    // Receive server messages (ServerHello, Certificate, etc.)
    fn receive_server_messages(&mut self) -> bool {
        // This is simplified - real implementation would handle each message
        loop {
            let record = match self.receive_record() {
                Some(r) => r,
                None => return false,
            };

            if record.content_type == CONTENT_TYPE_ALERT {
                self.handle_alert(&record.fragment);
                return false;
            }

            if record.content_type != CONTENT_TYPE_HANDSHAKE {
                continue;
            }

            // Update handshake hash
            self.handshake_hash.update(&record.fragment);

            // Parse handshake message
            if record.fragment.len() < 4 {
                return false;
            }

            let msg_type = record.fragment[0];
            let msg_len = ((record.fragment[1] as usize) << 16)
                | ((record.fragment[2] as usize) << 8)
                | (record.fragment[3] as usize);

            match msg_type {
                HANDSHAKE_SERVER_HELLO => {
                    if !self.process_server_hello(&record.fragment[4..]) {
                        return false;
                    }
                    self.state = TlsState::ServerHelloReceived;
                },
                HANDSHAKE_CERTIFICATE => {
                    if !self.process_certificate(&record.fragment[4..]) {
                        return false;
                    }
                    self.state = TlsState::CertificateReceived;
                },
                HANDSHAKE_SERVER_KEY_EXCHANGE => {
                    // For ECDHE suites
                    self.state = TlsState::ServerKeyExchangeReceived;
                },
                HANDSHAKE_SERVER_HELLO_DONE => {
                    self.state = TlsState::ServerHelloDoneReceived;
                    return true;
                },
                _ => {}
            }
        }
    }

    // Process ServerHello
    fn process_server_hello(&mut self, data: &[u8]) -> bool {
        if data.len() < 38 {
            return false;
        }

        // Version
        let version = ((data[0] as u16) << 8) | (data[1] as u16);
        if version != TLS_VERSION_1_2 {
            return false;
        }

        // Server random
        let mut i: usize = 0;
        while i < 32 {
            self.server_random[i] = data[2 + i];
            i = i + 1;
        }

        // Session ID
        let sid_len = data[34] as usize;
        let mut offset = 35 + sid_len;

        // Cipher suite
        if data.len() < offset + 2 {
            return false;
        }
        self.cipher_suite = ((data[offset] as u16) << 8) | (data[offset + 1] as u16);

        true
    }

    // Process Certificate
    fn process_certificate(&mut self, data: &[u8]) -> bool {
        if data.len() < 3 {
            return false;
        }

        let total_len = ((data[0] as usize) << 16) | ((data[1] as usize) << 8) | (data[2] as usize);

        if data.len() < 3 + total_len {
            return false;
        }

        // Get first certificate
        let mut offset = 3;
        if total_len >= 3 {
            let cert_len = ((data[offset] as usize) << 16)
                | ((data[offset + 1] as usize) << 8)
                | (data[offset + 2] as usize);

            offset = offset + 3;

            // Store certificate
            self.server_certificate.clear();
            let mut i: usize = 0;
            while i < cert_len && offset + i < data.len() {
                self.server_certificate.push(data[offset + i]);
                i = i + 1;
            }
        }

        true
    }

    // Send ClientKeyExchange, ChangeCipherSpec, Finished
    fn send_client_finish(&mut self) -> bool {
        // Generate pre-master secret (48 bytes for RSA)
        self.pre_master_secret.clear();
        self.pre_master_secret.push(3);  // TLS version major
        self.pre_master_secret.push(3);  // TLS version minor
        let rand = random_bytes(46);
        let mut i: usize = 0;
        while i < 46 {
            self.pre_master_secret.push(rand[i]);
            i = i + 1;
        }

        // Compute master secret using PRF
        self.compute_master_secret();

        // Derive keys
        self.derive_keys();

        // Send ClientKeyExchange (simplified - would need RSA encryption)
        let mut cke = Vec::new();
        // For RSA: encrypt pre_master_secret with server's public key
        // For now, send length-prefixed pre_master_secret (not secure, just for structure)
        let pms_len = self.pre_master_secret.len();
        cke.push((pms_len >> 8) as u8);
        cke.push(pms_len as u8);
        i = 0;
        while i < pms_len {
            cke.push(self.pre_master_secret[i]);
            i = i + 1;
        }

        let msg = self.build_handshake_message(HANDSHAKE_CLIENT_KEY_EXCHANGE, &cke);
        self.handshake_hash.update(&msg);
        let record = TlsRecord::new(CONTENT_TYPE_HANDSHAKE, msg);
        if !self.send_record(&record) {
            return false;
        }

        self.state = TlsState::ClientKeyExchangeSent;

        // Send ChangeCipherSpec
        let ccs = vec![1u8];
        let ccs_record = TlsRecord::new(CONTENT_TYPE_CHANGE_CIPHER_SPEC, ccs);
        if !self.send_record(&ccs_record) {
            return false;
        }

        // Activate cipher for sending
        self.record_layer.activate_cipher();
        self.state = TlsState::ChangeCipherSpecSent;

        // Send Finished
        let verify_data = self.compute_verify_data(true);
        let finished_msg = self.build_handshake_message(HANDSHAKE_FINISHED, &verify_data);
        self.handshake_hash.update(&finished_msg);

        let finished_record = TlsRecord::new(CONTENT_TYPE_HANDSHAKE, finished_msg);
        let encrypted = encrypt_record(&mut self.record_layer, &finished_record);
        if !self.send_raw(&encrypted) {
            return false;
        }

        self.state = TlsState::FinishedSent;
        true
    }

    // Receive server's ChangeCipherSpec and Finished
    fn receive_server_finish(&mut self) -> bool {
        // Receive ChangeCipherSpec
        let ccs = match self.receive_record() {
            Some(r) => r,
            None => return false,
        };

        if ccs.content_type != CONTENT_TYPE_CHANGE_CIPHER_SPEC {
            return false;
        }

        // Activate cipher for receiving
        // Note: We already activated for sending, this is for receiving
        // In a real implementation, we'd have separate read/write states

        // Receive Finished (encrypted)
        let finished = match self.receive_encrypted_record() {
            Some(r) => r,
            None => return false,
        };

        if finished.content_type != CONTENT_TYPE_HANDSHAKE {
            return false;
        }

        // Verify Finished message
        if finished.fragment.len() < 4 {
            return false;
        }

        let msg_type = finished.fragment[0];
        if msg_type != HANDSHAKE_FINISHED {
            return false;
        }

        // Verify data would be checked here
        true
    }

    // Compute master secret using PRF
    fn compute_master_secret(&mut self) {
        let seed = {
            let mut s = Vec::new();
            // "master secret" label
            let label = b"master secret";
            let mut i: usize = 0;
            while i < label.len() {
                s.push(label[i]);
                i = i + 1;
            }
            // client_random
            i = 0;
            while i < 32 {
                s.push(self.client_random[i]);
                i = i + 1;
            }
            // server_random
            i = 0;
            while i < 32 {
                s.push(self.server_random[i]);
                i = i + 1;
            }
            s
        };

        let ms = prf_sha256(&self.pre_master_secret, &seed, 48);
        let mut i: usize = 0;
        while i < 48 && i < ms.len() {
            self.master_secret[i] = ms[i];
            i = i + 1;
        }
    }

    // Derive encryption keys from master secret
    fn derive_keys(&mut self) {
        let seed = {
            let mut s = Vec::new();
            let label = b"key expansion";
            let mut i: usize = 0;
            while i < label.len() {
                s.push(label[i]);
                i = i + 1;
            }
            i = 0;
            while i < 32 {
                s.push(self.server_random[i]);
                i = i + 1;
            }
            i = 0;
            while i < 32 {
                s.push(self.client_random[i]);
                i = i + 1;
            }
            s
        };

        // For AES-128-GCM: 16 byte key + 4 byte IV (implicit)
        // key_block = PRF(master_secret, "key expansion", server_random + client_random)
        let key_material = prf_sha256(&self.master_secret, &seed, 72);

        // client_write_MAC_key (0 for AEAD)
        // server_write_MAC_key (0 for AEAD)
        // client_write_key (16 bytes)
        // server_write_key (16 bytes)
        // client_write_IV (4 bytes implicit, 8 bytes explicit sent)
        // server_write_IV (4 bytes implicit, 8 bytes explicit sent)

        let mut offset = 0;

        let mut client_key: [u8; 16] = [0; 16];
        let mut server_key: [u8; 16] = [0; 16];
        let mut client_iv: [u8; 4] = [0; 4];
        let mut server_iv: [u8; 4] = [0; 4];

        let mut i: usize = 0;
        while i < 16 {
            client_key[i] = key_material[offset + i];
            i = i + 1;
        }
        offset = offset + 16;

        i = 0;
        while i < 16 {
            server_key[i] = key_material[offset + i];
            i = i + 1;
        }
        offset = offset + 16;

        i = 0;
        while i < 4 {
            client_iv[i] = key_material[offset + i];
            i = i + 1;
        }
        offset = offset + 4;

        i = 0;
        while i < 4 {
            server_iv[i] = key_material[offset + i];
            i = i + 1;
        }

        self.record_layer.set_cipher_keys(
            &[],  // No MAC key for AEAD
            &[],
            &client_key,
            &server_key,
            &client_iv,
            &server_iv,
        );
    }

    // Compute verify_data for Finished message
    fn compute_verify_data(&mut self, is_client: bool) -> Vec<u8> {
        let label = if is_client { b"client finished" } else { b"server finished" };

        // Get handshake hash
        let mut hash_copy = self.handshake_hash.clone();
        let hash = hash_copy.finalize();

        let mut seed = Vec::new();
        let mut i: usize = 0;
        while i < label.len() {
            seed.push(label[i]);
            i = i + 1;
        }
        i = 0;
        while i < 32 {
            seed.push(hash[i]);
            i = i + 1;
        }

        prf_sha256(&self.master_secret, &seed, 12)
    }

    // Build handshake message with header
    fn build_handshake_message(&self, msg_type: u8, content: &[u8]) -> Vec<u8> {
        let mut msg = Vec::new();
        msg.push(msg_type);
        let len = content.len();
        msg.push((len >> 16) as u8);
        msg.push((len >> 8) as u8);
        msg.push(len as u8);

        let mut i: usize = 0;
        while i < content.len() {
            msg.push(content[i]);
            i = i + 1;
        }
        msg
    }

    // Handle alert
    fn handle_alert(&mut self, data: &[u8]) {
        if data.len() >= 2 {
            self.last_error = data[1];
        }
        self.state = TlsState::Error;
    }

    // Send a record
    fn send_record(&mut self, record: &TlsRecord) -> bool {
        let data = record.to_bytes();
        self.send_raw(&data)
    }

    // Send raw data
    fn send_raw(&self, data: &[u8]) -> bool {
        if self.socket_write_fn == 0 {
            return false;
        }

        unsafe {
            let write_fn: fn(u64, &[u8]) -> i64 = core::mem::transmute(self.socket_write_fn);
            write_fn(self.socket_data, data) >= 0
        }
    }

    // Receive a record
    fn receive_record(&mut self) -> Option<TlsRecord> {
        // Read header (5 bytes)
        let mut header: [u8; 5] = [0; 5];
        if !self.recv_exact(&mut header) {
            return None;
        }

        let length = ((header[3] as usize) << 8) | (header[4] as usize);

        // Read fragment
        let mut fragment = Vec::new();
        let mut i: usize = 0;
        while i < length {
            fragment.push(0);
            i = i + 1;
        }
        if !self.recv_exact(&mut fragment) {
            return None;
        }

        Some(TlsRecord {
            content_type: header[0],
            version: ((header[1] as u16) << 8) | (header[2] as u16),
            length: length as u16,
            fragment: fragment,
        })
    }

    // Receive and decrypt a record
    fn receive_encrypted_record(&mut self) -> Option<TlsRecord> {
        let mut header: [u8; 5] = [0; 5];
        if !self.recv_exact(&mut header) {
            return None;
        }

        let length = ((header[3] as usize) << 8) | (header[4] as usize);

        let mut data = Vec::new();
        let mut i: usize = 0;
        while i < 5 {
            data.push(header[i]);
            i = i + 1;
        }
        i = 0;
        while i < length {
            data.push(0);
            i = i + 1;
        }
        if !self.recv_exact(&mut data[5..]) {
            return None;
        }

        decrypt_record(&mut self.record_layer, &data)
    }

    // Receive exact number of bytes
    fn recv_exact(&self, buffer: &mut [u8]) -> bool {
        if self.socket_read_fn == 0 {
            return false;
        }

        unsafe {
            let read_fn: fn(u64, &mut [u8]) -> i64 = core::mem::transmute(self.socket_read_fn);
            let result = read_fn(self.socket_data, buffer);
            result as usize == buffer.len()
        }
    }

    // Send application data
    pub fn write(&mut self, data: &[u8]) -> bool {
        if self.state != TlsState::Connected {
            return false;
        }

        let record = TlsRecord::new(CONTENT_TYPE_APPLICATION_DATA, data.to_vec());
        let encrypted = encrypt_record(&mut self.record_layer, &record);
        self.send_raw(&encrypted)
    }

    // Read application data
    pub fn read(&mut self, buffer: &mut [u8]) -> i64 {
        if self.state != TlsState::Connected {
            return -1;
        }

        match self.receive_encrypted_record() {
            Some(record) => {
                if record.content_type == CONTENT_TYPE_APPLICATION_DATA {
                    let len = if record.fragment.len() < buffer.len() {
                        record.fragment.len()
                    } else {
                        buffer.len()
                    };

                    let mut i: usize = 0;
                    while i < len {
                        buffer[i] = record.fragment[i];
                        i = i + 1;
                    }
                    len as i64
                } else if record.content_type == CONTENT_TYPE_ALERT {
                    self.handle_alert(&record.fragment);
                    -1
                } else {
                    0
                }
            },
            None => -1
        }
    }

    // Close connection
    pub fn close(&mut self) {
        if self.state == TlsState::Connected {
            // Send close_notify alert
            let alert = vec![ALERT_LEVEL_WARNING, ALERT_CLOSE_NOTIFY];
            let record = TlsRecord::new(CONTENT_TYPE_ALERT, alert);
            let encrypted = encrypt_record(&mut self.record_layer, &record);
            let _ = self.send_raw(&encrypted);
        }
        self.state = TlsState::Closed;
    }

    pub fn is_connected(&self) -> bool {
        self.state == TlsState::Connected
    }

    pub fn get_last_error(&self) -> u8 {
        self.last_error
    }
}

// ============================================================
// TLS PRF (Pseudo-Random Function)
// ============================================================

fn prf_sha256(secret: &[u8], seed: &[u8], length: usize) -> Vec<u8> {
    // P_SHA256(secret, seed) = HMAC_SHA256(secret, A(1) + seed) +
    //                          HMAC_SHA256(secret, A(2) + seed) + ...
    // A(0) = seed
    // A(i) = HMAC_SHA256(secret, A(i-1))

    let mut output = Vec::new();
    let mut a = hmac_sha256(secret, seed);

    while output.len() < length {
        // P = HMAC(secret, A + seed)
        let mut input = Vec::new();
        let mut i: usize = 0;
        while i < 32 {
            input.push(a[i]);
            i = i + 1;
        }
        i = 0;
        while i < seed.len() {
            input.push(seed[i]);
            i = i + 1;
        }

        let p = hmac_sha256(secret, &input);
        i = 0;
        while i < 32 && output.len() < length {
            output.push(p[i]);
            i = i + 1;
        }

        // A(i) = HMAC(secret, A(i-1))
        a = hmac_sha256(secret, &a);
    }

    output
}
