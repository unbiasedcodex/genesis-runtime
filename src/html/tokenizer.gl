// HTML5 Tokenizer
// WHATWG HTML5 Parsing Specification compliant tokenizer

// ============================================================
// Token Types
// ============================================================

#[derive(Clone)]
pub struct Attribute {
    pub name: String,
    pub value: String,
}

impl Attribute {
    pub fn new(name: String, value: String) -> Attribute {
        Attribute { name: name, value: value }
    }
}

#[derive(Clone)]
pub enum HtmlToken {
    DOCTYPE {
        name: Option<String>,
        public_id: Option<String>,
        system_id: Option<String>,
        force_quirks: bool,
    },
    StartTag {
        name: String,
        attributes: Vec<Attribute>,
        self_closing: bool,
    },
    EndTag {
        name: String,
    },
    Comment {
        data: String,
    },
    Character {
        data: char,
    },
    EOF,
}

impl HtmlToken {
    pub fn start_tag(name: &str) -> HtmlToken {
        HtmlToken::StartTag {
            name: String::from(name),
            attributes: Vec::new(),
            self_closing: false,
        }
    }

    pub fn end_tag(name: &str) -> HtmlToken {
        HtmlToken::EndTag {
            name: String::from(name),
        }
    }

    pub fn character(c: char) -> HtmlToken {
        HtmlToken::Character { data: c }
    }

    pub fn comment(data: &str) -> HtmlToken {
        HtmlToken::Comment {
            data: String::from(data),
        }
    }
}

// ============================================================
// Tokenizer States
// ============================================================

#[derive(Clone, Copy, PartialEq)]
pub enum TokenizerState {
    Data,
    RCDATA,
    RAWTEXT,
    ScriptData,
    PLAINTEXT,
    TagOpen,
    EndTagOpen,
    TagName,
    RCDATALessThanSign,
    RCDATAEndTagOpen,
    RCDATAEndTagName,
    RAWTEXTLessThanSign,
    RAWTEXTEndTagOpen,
    RAWTEXTEndTagName,
    ScriptDataLessThanSign,
    ScriptDataEndTagOpen,
    ScriptDataEndTagName,
    ScriptDataEscapeStart,
    ScriptDataEscapeStartDash,
    ScriptDataEscaped,
    ScriptDataEscapedDash,
    ScriptDataEscapedDashDash,
    ScriptDataEscapedLessThanSign,
    ScriptDataEscapedEndTagOpen,
    ScriptDataEscapedEndTagName,
    ScriptDataDoubleEscapeStart,
    ScriptDataDoubleEscaped,
    ScriptDataDoubleEscapedDash,
    ScriptDataDoubleEscapedDashDash,
    ScriptDataDoubleEscapedLessThanSign,
    ScriptDataDoubleEscapeEnd,
    BeforeAttributeName,
    AttributeName,
    AfterAttributeName,
    BeforeAttributeValue,
    AttributeValueDoubleQuoted,
    AttributeValueSingleQuoted,
    AttributeValueUnquoted,
    AfterAttributeValueQuoted,
    SelfClosingStartTag,
    BogusComment,
    MarkupDeclarationOpen,
    CommentStart,
    CommentStartDash,
    Comment,
    CommentLessThanSign,
    CommentLessThanSignBang,
    CommentLessThanSignBangDash,
    CommentLessThanSignBangDashDash,
    CommentEndDash,
    CommentEnd,
    CommentEndBang,
    DOCTYPE,
    BeforeDOCTYPEName,
    DOCTYPEName,
    AfterDOCTYPEName,
    AfterDOCTYPEPublicKeyword,
    BeforeDOCTYPEPublicIdentifier,
    DOCTYPEPublicIdentifierDoubleQuoted,
    DOCTYPEPublicIdentifierSingleQuoted,
    AfterDOCTYPEPublicIdentifier,
    BetweenDOCTYPEPublicAndSystemIdentifiers,
    AfterDOCTYPESystemKeyword,
    BeforeDOCTYPESystemIdentifier,
    DOCTYPESystemIdentifierDoubleQuoted,
    DOCTYPESystemIdentifierSingleQuoted,
    AfterDOCTYPESystemIdentifier,
    BogusDOCTYPE,
    CDATASection,
    CDATASectionBracket,
    CDATASectionEnd,
    CharacterReference,
    NamedCharacterReference,
    AmbiguousAmpersand,
    NumericCharacterReference,
    HexadecimalCharacterReferenceStart,
    DecimalCharacterReferenceStart,
    HexadecimalCharacterReference,
    DecimalCharacterReference,
    NumericCharacterReferenceEnd,
}

// ============================================================
// Tokenizer
// ============================================================

pub struct Tokenizer {
    input: Vec<char>,
    pos: usize,
    state: TokenizerState,
    return_state: TokenizerState,

    // Current token being built
    current_tag_name: String,
    current_tag_self_closing: bool,
    current_tag_attributes: Vec<Attribute>,
    current_attribute_name: String,
    current_attribute_value: String,
    current_comment: String,
    current_doctype_name: Option<String>,
    current_doctype_public_id: Option<String>,
    current_doctype_system_id: Option<String>,
    current_doctype_force_quirks: bool,

    // Temporary buffer for character references
    temp_buffer: String,
    character_reference_code: u32,

    // Last emitted start tag (for end tag matching)
    last_start_tag_name: String,

    // Token queue
    token_queue: Vec<HtmlToken>,

    // Is building end tag?
    is_end_tag: bool,
}

impl Tokenizer {
    pub fn new(input: &str) -> Tokenizer {
        let chars: Vec<char> = input.chars().collect();
        Tokenizer {
            input: chars,
            pos: 0,
            state: TokenizerState::Data,
            return_state: TokenizerState::Data,
            current_tag_name: String::new(),
            current_tag_self_closing: false,
            current_tag_attributes: Vec::new(),
            current_attribute_name: String::new(),
            current_attribute_value: String::new(),
            current_comment: String::new(),
            current_doctype_name: None,
            current_doctype_public_id: None,
            current_doctype_system_id: None,
            current_doctype_force_quirks: false,
            temp_buffer: String::new(),
            character_reference_code: 0,
            last_start_tag_name: String::new(),
            token_queue: Vec::new(),
            is_end_tag: false,
        }
    }

    // Consume next character
    fn consume(&mut self) -> Option<char> {
        if self.pos < self.input.len() {
            let c = self.input[self.pos];
            self.pos = self.pos + 1;
            Some(c)
        } else {
            None
        }
    }

    // Peek at next character without consuming
    fn peek(&self) -> Option<char> {
        if self.pos < self.input.len() {
            Some(self.input[self.pos])
        } else {
            None
        }
    }

    // Peek at character at offset
    fn peek_at(&self, offset: usize) -> Option<char> {
        let idx = self.pos + offset;
        if idx < self.input.len() {
            Some(self.input[idx])
        } else {
            None
        }
    }

    // Reconsume current character
    fn reconsume(&mut self) {
        if self.pos > 0 {
            self.pos = self.pos - 1;
        }
    }

    // Check if remaining input matches string (case-insensitive)
    fn matches_ci(&self, s: &str) -> bool {
        let chars: Vec<char> = s.chars().collect();
        let mut i: usize = 0;
        while i < chars.len() {
            match self.peek_at(i) {
                Some(c) => {
                    if c.to_ascii_lowercase() != chars[i].to_ascii_lowercase() {
                        return false;
                    }
                },
                None => return false,
            }
            i = i + 1;
        }
        true
    }

    // Emit a token
    fn emit(&mut self, token: HtmlToken) {
        // Track last start tag name
        match &token {
            HtmlToken::StartTag { name, .. } => {
                self.last_start_tag_name = name.clone();
            },
            _ => {}
        }
        self.token_queue.push(token);
    }

    // Emit current tag
    fn emit_current_tag(&mut self) {
        // Add pending attribute if any
        if !self.current_attribute_name.is_empty() {
            self.current_tag_attributes.push(Attribute::new(
                self.current_attribute_name.clone(),
                self.current_attribute_value.clone(),
            ));
        }

        let token = if self.is_end_tag {
            HtmlToken::EndTag {
                name: self.current_tag_name.clone(),
            }
        } else {
            let name = self.current_tag_name.clone();
            self.last_start_tag_name = name.clone();
            HtmlToken::StartTag {
                name: name,
                attributes: self.current_tag_attributes.clone(),
                self_closing: self.current_tag_self_closing,
            }
        };

        self.token_queue.push(token);
        self.reset_tag_state();
    }

    // Emit current comment
    fn emit_current_comment(&mut self) {
        self.emit(HtmlToken::Comment {
            data: self.current_comment.clone(),
        });
        self.current_comment = String::new();
    }

    // Emit current DOCTYPE
    fn emit_current_doctype(&mut self) {
        self.emit(HtmlToken::DOCTYPE {
            name: self.current_doctype_name.clone(),
            public_id: self.current_doctype_public_id.clone(),
            system_id: self.current_doctype_system_id.clone(),
            force_quirks: self.current_doctype_force_quirks,
        });
        self.reset_doctype_state();
    }

    // Reset tag building state
    fn reset_tag_state(&mut self) {
        self.current_tag_name = String::new();
        self.current_tag_self_closing = false;
        self.current_tag_attributes = Vec::new();
        self.current_attribute_name = String::new();
        self.current_attribute_value = String::new();
        self.is_end_tag = false;
    }

    // Reset DOCTYPE building state
    fn reset_doctype_state(&mut self) {
        self.current_doctype_name = None;
        self.current_doctype_public_id = None;
        self.current_doctype_system_id = None;
        self.current_doctype_force_quirks = false;
    }

    // Start new attribute
    fn new_attribute(&mut self) {
        if !self.current_attribute_name.is_empty() {
            self.current_tag_attributes.push(Attribute::new(
                self.current_attribute_name.clone(),
                self.current_attribute_value.clone(),
            ));
        }
        self.current_attribute_name = String::new();
        self.current_attribute_value = String::new();
    }

    // Check if current end tag is appropriate
    fn is_appropriate_end_tag(&self) -> bool {
        !self.last_start_tag_name.is_empty() &&
        self.current_tag_name == self.last_start_tag_name
    }

    // Get next token
    pub fn next_token(&mut self) -> HtmlToken {
        // Return queued token if available
        if !self.token_queue.is_empty() {
            return self.token_queue.remove(0);
        }

        loop {
            // Check for queued tokens after each state processing
            if !self.token_queue.is_empty() {
                return self.token_queue.remove(0);
            }

            match self.state {
                TokenizerState::Data => {
                    match self.consume() {
                        Some('&') => {
                            self.return_state = TokenizerState::Data;
                            self.state = TokenizerState::CharacterReference;
                        },
                        Some('<') => {
                            self.state = TokenizerState::TagOpen;
                        },
                        Some('\0') => {
                            // Parse error, emit replacement character
                            return HtmlToken::character('\u{FFFD}');
                        },
                        Some(c) => {
                            return HtmlToken::character(c);
                        },
                        None => {
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::TagOpen => {
                    match self.consume() {
                        Some('!') => {
                            self.state = TokenizerState::MarkupDeclarationOpen;
                        },
                        Some('/') => {
                            self.state = TokenizerState::EndTagOpen;
                        },
                        Some(c) if c.is_ascii_alphabetic() => {
                            self.is_end_tag = false;
                            self.current_tag_name = String::new();
                            self.reconsume();
                            self.state = TokenizerState::TagName;
                        },
                        Some('?') => {
                            // Parse error
                            self.current_comment = String::new();
                            self.reconsume();
                            self.state = TokenizerState::BogusComment;
                        },
                        _ => {
                            // Parse error
                            self.reconsume();
                            self.state = TokenizerState::Data;
                            return HtmlToken::character('<');
                        }
                    }
                },

                TokenizerState::EndTagOpen => {
                    match self.consume() {
                        Some(c) if c.is_ascii_alphabetic() => {
                            self.is_end_tag = true;
                            self.current_tag_name = String::new();
                            self.reconsume();
                            self.state = TokenizerState::TagName;
                        },
                        Some('>') => {
                            // Parse error
                            self.state = TokenizerState::Data;
                        },
                        None => {
                            // Parse error
                            self.emit(HtmlToken::character('<'));
                            self.emit(HtmlToken::character('/'));
                            return HtmlToken::EOF;
                        },
                        _ => {
                            // Parse error
                            self.current_comment = String::new();
                            self.reconsume();
                            self.state = TokenizerState::BogusComment;
                        }
                    }
                },

                TokenizerState::TagName => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            self.state = TokenizerState::BeforeAttributeName;
                        },
                        Some('/') => {
                            self.state = TokenizerState::SelfClosingStartTag;
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_tag();
                        },
                        Some(c) if c.is_ascii_uppercase() => {
                            self.current_tag_name.push(c.to_ascii_lowercase());
                        },
                        Some('\0') => {
                            self.current_tag_name.push('\u{FFFD}');
                        },
                        Some(c) => {
                            self.current_tag_name.push(c);
                        },
                        None => {
                            // Parse error
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::BeforeAttributeName => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some('/') | Some('>') | None => {
                            self.reconsume();
                            self.state = TokenizerState::AfterAttributeName;
                        },
                        Some('=') => {
                            // Parse error
                            self.new_attribute();
                            self.current_attribute_name.push('=');
                            self.state = TokenizerState::AttributeName;
                        },
                        _ => {
                            self.new_attribute();
                            self.reconsume();
                            self.state = TokenizerState::AttributeName;
                        }
                    }
                },

                TokenizerState::AttributeName => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') |
                        Some('/') | Some('>') | None => {
                            self.reconsume();
                            self.state = TokenizerState::AfterAttributeName;
                        },
                        Some('=') => {
                            self.state = TokenizerState::BeforeAttributeValue;
                        },
                        Some(c) if c.is_ascii_uppercase() => {
                            self.current_attribute_name.push(c.to_ascii_lowercase());
                        },
                        Some('\0') => {
                            self.current_attribute_name.push('\u{FFFD}');
                        },
                        Some('"') | Some('\'') | Some('<') => {
                            // Parse error
                            self.current_attribute_name.push(self.input[self.pos - 1]);
                        },
                        Some(c) => {
                            self.current_attribute_name.push(c);
                        }
                    }
                },

                TokenizerState::AfterAttributeName => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some('/') => {
                            self.state = TokenizerState::SelfClosingStartTag;
                        },
                        Some('=') => {
                            self.state = TokenizerState::BeforeAttributeValue;
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_tag();
                        },
                        None => {
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.new_attribute();
                            self.reconsume();
                            self.state = TokenizerState::AttributeName;
                        }
                    }
                },

                TokenizerState::BeforeAttributeValue => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some('"') => {
                            self.state = TokenizerState::AttributeValueDoubleQuoted;
                        },
                        Some('\'') => {
                            self.state = TokenizerState::AttributeValueSingleQuoted;
                        },
                        Some('>') => {
                            // Parse error
                            self.state = TokenizerState::Data;
                            self.emit_current_tag();
                        },
                        _ => {
                            self.reconsume();
                            self.state = TokenizerState::AttributeValueUnquoted;
                        }
                    }
                },

                TokenizerState::AttributeValueDoubleQuoted => {
                    match self.consume() {
                        Some('"') => {
                            self.state = TokenizerState::AfterAttributeValueQuoted;
                        },
                        Some('&') => {
                            self.return_state = TokenizerState::AttributeValueDoubleQuoted;
                            self.state = TokenizerState::CharacterReference;
                        },
                        Some('\0') => {
                            self.current_attribute_value.push('\u{FFFD}');
                        },
                        Some(c) => {
                            self.current_attribute_value.push(c);
                        },
                        None => {
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::AttributeValueSingleQuoted => {
                    match self.consume() {
                        Some('\'') => {
                            self.state = TokenizerState::AfterAttributeValueQuoted;
                        },
                        Some('&') => {
                            self.return_state = TokenizerState::AttributeValueSingleQuoted;
                            self.state = TokenizerState::CharacterReference;
                        },
                        Some('\0') => {
                            self.current_attribute_value.push('\u{FFFD}');
                        },
                        Some(c) => {
                            self.current_attribute_value.push(c);
                        },
                        None => {
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::AttributeValueUnquoted => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            self.state = TokenizerState::BeforeAttributeName;
                        },
                        Some('&') => {
                            self.return_state = TokenizerState::AttributeValueUnquoted;
                            self.state = TokenizerState::CharacterReference;
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_tag();
                        },
                        Some('\0') => {
                            self.current_attribute_value.push('\u{FFFD}');
                        },
                        Some('"') | Some('\'') | Some('<') | Some('=') | Some('`') => {
                            // Parse error
                            self.current_attribute_value.push(self.input[self.pos - 1]);
                        },
                        Some(c) => {
                            self.current_attribute_value.push(c);
                        },
                        None => {
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::AfterAttributeValueQuoted => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            self.state = TokenizerState::BeforeAttributeName;
                        },
                        Some('/') => {
                            self.state = TokenizerState::SelfClosingStartTag;
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_tag();
                        },
                        None => {
                            return HtmlToken::EOF;
                        },
                        _ => {
                            // Parse error
                            self.reconsume();
                            self.state = TokenizerState::BeforeAttributeName;
                        }
                    }
                },

                TokenizerState::SelfClosingStartTag => {
                    match self.consume() {
                        Some('>') => {
                            self.current_tag_self_closing = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_tag();
                        },
                        None => {
                            return HtmlToken::EOF;
                        },
                        _ => {
                            // Parse error
                            self.reconsume();
                            self.state = TokenizerState::BeforeAttributeName;
                        }
                    }
                },

                TokenizerState::MarkupDeclarationOpen => {
                    if self.matches_ci("--") {
                        self.pos = self.pos + 2;
                        self.current_comment = String::new();
                        self.state = TokenizerState::CommentStart;
                    } else if self.matches_ci("DOCTYPE") {
                        self.pos = self.pos + 7;
                        self.state = TokenizerState::DOCTYPE;
                    } else if self.matches_ci("[CDATA[") {
                        self.pos = self.pos + 7;
                        // For HTML, treat CDATA as bogus comment
                        self.current_comment = String::from("[CDATA[");
                        self.state = TokenizerState::BogusComment;
                    } else {
                        // Parse error
                        self.current_comment = String::new();
                        self.state = TokenizerState::BogusComment;
                    }
                },

                TokenizerState::CommentStart => {
                    match self.consume() {
                        Some('-') => {
                            self.state = TokenizerState::CommentStartDash;
                        },
                        Some('>') => {
                            // Parse error
                            self.state = TokenizerState::Data;
                            self.emit_current_comment();
                        },
                        _ => {
                            self.reconsume();
                            self.state = TokenizerState::Comment;
                        }
                    }
                },

                TokenizerState::CommentStartDash => {
                    match self.consume() {
                        Some('-') => {
                            self.state = TokenizerState::CommentEnd;
                        },
                        Some('>') => {
                            // Parse error
                            self.state = TokenizerState::Data;
                            self.emit_current_comment();
                        },
                        None => {
                            self.emit_current_comment();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_comment.push('-');
                            self.reconsume();
                            self.state = TokenizerState::Comment;
                        }
                    }
                },

                TokenizerState::Comment => {
                    match self.consume() {
                        Some('<') => {
                            self.current_comment.push('<');
                            self.state = TokenizerState::CommentLessThanSign;
                        },
                        Some('-') => {
                            self.state = TokenizerState::CommentEndDash;
                        },
                        Some('\0') => {
                            self.current_comment.push('\u{FFFD}');
                        },
                        Some(c) => {
                            self.current_comment.push(c);
                        },
                        None => {
                            self.emit_current_comment();
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::CommentLessThanSign => {
                    match self.consume() {
                        Some('!') => {
                            self.current_comment.push('!');
                            self.state = TokenizerState::CommentLessThanSignBang;
                        },
                        Some('<') => {
                            self.current_comment.push('<');
                        },
                        _ => {
                            self.reconsume();
                            self.state = TokenizerState::Comment;
                        }
                    }
                },

                TokenizerState::CommentLessThanSignBang => {
                    match self.consume() {
                        Some('-') => {
                            self.state = TokenizerState::CommentLessThanSignBangDash;
                        },
                        _ => {
                            self.reconsume();
                            self.state = TokenizerState::Comment;
                        }
                    }
                },

                TokenizerState::CommentLessThanSignBangDash => {
                    match self.consume() {
                        Some('-') => {
                            self.state = TokenizerState::CommentLessThanSignBangDashDash;
                        },
                        _ => {
                            self.reconsume();
                            self.state = TokenizerState::CommentEndDash;
                        }
                    }
                },

                TokenizerState::CommentLessThanSignBangDashDash => {
                    match self.consume() {
                        Some('>') | None => {
                            self.reconsume();
                            self.state = TokenizerState::CommentEnd;
                        },
                        _ => {
                            // Parse error
                            self.reconsume();
                            self.state = TokenizerState::CommentEnd;
                        }
                    }
                },

                TokenizerState::CommentEndDash => {
                    match self.consume() {
                        Some('-') => {
                            self.state = TokenizerState::CommentEnd;
                        },
                        None => {
                            self.emit_current_comment();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_comment.push('-');
                            self.reconsume();
                            self.state = TokenizerState::Comment;
                        }
                    }
                },

                TokenizerState::CommentEnd => {
                    match self.consume() {
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_comment();
                        },
                        Some('!') => {
                            self.state = TokenizerState::CommentEndBang;
                        },
                        Some('-') => {
                            self.current_comment.push('-');
                        },
                        None => {
                            self.emit_current_comment();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_comment.push('-');
                            self.current_comment.push('-');
                            self.reconsume();
                            self.state = TokenizerState::Comment;
                        }
                    }
                },

                TokenizerState::CommentEndBang => {
                    match self.consume() {
                        Some('-') => {
                            self.current_comment.push('-');
                            self.current_comment.push('-');
                            self.current_comment.push('!');
                            self.state = TokenizerState::CommentEndDash;
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_comment();
                        },
                        None => {
                            self.emit_current_comment();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_comment.push('-');
                            self.current_comment.push('-');
                            self.current_comment.push('!');
                            self.reconsume();
                            self.state = TokenizerState::Comment;
                        }
                    }
                },

                TokenizerState::DOCTYPE => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            self.state = TokenizerState::BeforeDOCTYPEName;
                        },
                        Some('>') => {
                            self.reconsume();
                            self.state = TokenizerState::BeforeDOCTYPEName;
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            // Parse error
                            self.reconsume();
                            self.state = TokenizerState::BeforeDOCTYPEName;
                        }
                    }
                },

                TokenizerState::BeforeDOCTYPEName => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some(c) if c.is_ascii_uppercase() => {
                            self.current_doctype_name = Some(String::from(
                                c.to_ascii_lowercase().to_string().as_str()
                            ));
                            self.state = TokenizerState::DOCTYPEName;
                        },
                        Some('\0') => {
                            self.current_doctype_name = Some(String::from("\u{FFFD}"));
                            self.state = TokenizerState::DOCTYPEName;
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some(c) => {
                            self.current_doctype_name = Some(c.to_string());
                            self.state = TokenizerState::DOCTYPEName;
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::DOCTYPEName => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            self.state = TokenizerState::AfterDOCTYPEName;
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some(c) if c.is_ascii_uppercase() => {
                            if let Some(ref mut name) = self.current_doctype_name {
                                name.push(c.to_ascii_lowercase());
                            }
                        },
                        Some('\0') => {
                            if let Some(ref mut name) = self.current_doctype_name {
                                name.push('\u{FFFD}');
                            }
                        },
                        Some(c) => {
                            if let Some(ref mut name) = self.current_doctype_name {
                                name.push(c);
                            }
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::AfterDOCTYPEName => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.reconsume();
                            if self.matches_ci("PUBLIC") {
                                self.pos = self.pos + 6;
                                self.state = TokenizerState::AfterDOCTYPEPublicKeyword;
                            } else if self.matches_ci("SYSTEM") {
                                self.pos = self.pos + 6;
                                self.state = TokenizerState::AfterDOCTYPESystemKeyword;
                            } else {
                                self.current_doctype_force_quirks = true;
                                self.reconsume();
                                self.state = TokenizerState::BogusDOCTYPE;
                            }
                        }
                    }
                },

                TokenizerState::AfterDOCTYPEPublicKeyword => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            self.state = TokenizerState::BeforeDOCTYPEPublicIdentifier;
                        },
                        Some('"') => {
                            self.current_doctype_public_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPEPublicIdentifierDoubleQuoted;
                        },
                        Some('\'') => {
                            self.current_doctype_public_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPEPublicIdentifierSingleQuoted;
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_doctype_force_quirks = true;
                            self.reconsume();
                            self.state = TokenizerState::BogusDOCTYPE;
                        }
                    }
                },

                TokenizerState::BeforeDOCTYPEPublicIdentifier => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some('"') => {
                            self.current_doctype_public_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPEPublicIdentifierDoubleQuoted;
                        },
                        Some('\'') => {
                            self.current_doctype_public_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPEPublicIdentifierSingleQuoted;
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_doctype_force_quirks = true;
                            self.reconsume();
                            self.state = TokenizerState::BogusDOCTYPE;
                        }
                    }
                },

                TokenizerState::DOCTYPEPublicIdentifierDoubleQuoted => {
                    match self.consume() {
                        Some('"') => {
                            self.state = TokenizerState::AfterDOCTYPEPublicIdentifier;
                        },
                        Some('\0') => {
                            if let Some(ref mut id) = self.current_doctype_public_id {
                                id.push('\u{FFFD}');
                            }
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some(c) => {
                            if let Some(ref mut id) = self.current_doctype_public_id {
                                id.push(c);
                            }
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::DOCTYPEPublicIdentifierSingleQuoted => {
                    match self.consume() {
                        Some('\'') => {
                            self.state = TokenizerState::AfterDOCTYPEPublicIdentifier;
                        },
                        Some('\0') => {
                            if let Some(ref mut id) = self.current_doctype_public_id {
                                id.push('\u{FFFD}');
                            }
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some(c) => {
                            if let Some(ref mut id) = self.current_doctype_public_id {
                                id.push(c);
                            }
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::AfterDOCTYPEPublicIdentifier => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            self.state = TokenizerState::BetweenDOCTYPEPublicAndSystemIdentifiers;
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some('"') => {
                            self.current_doctype_system_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPESystemIdentifierDoubleQuoted;
                        },
                        Some('\'') => {
                            self.current_doctype_system_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPESystemIdentifierSingleQuoted;
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_doctype_force_quirks = true;
                            self.reconsume();
                            self.state = TokenizerState::BogusDOCTYPE;
                        }
                    }
                },

                TokenizerState::BetweenDOCTYPEPublicAndSystemIdentifiers => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some('"') => {
                            self.current_doctype_system_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPESystemIdentifierDoubleQuoted;
                        },
                        Some('\'') => {
                            self.current_doctype_system_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPESystemIdentifierSingleQuoted;
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_doctype_force_quirks = true;
                            self.reconsume();
                            self.state = TokenizerState::BogusDOCTYPE;
                        }
                    }
                },

                TokenizerState::AfterDOCTYPESystemKeyword => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            self.state = TokenizerState::BeforeDOCTYPESystemIdentifier;
                        },
                        Some('"') => {
                            self.current_doctype_system_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPESystemIdentifierDoubleQuoted;
                        },
                        Some('\'') => {
                            self.current_doctype_system_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPESystemIdentifierSingleQuoted;
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_doctype_force_quirks = true;
                            self.reconsume();
                            self.state = TokenizerState::BogusDOCTYPE;
                        }
                    }
                },

                TokenizerState::BeforeDOCTYPESystemIdentifier => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some('"') => {
                            self.current_doctype_system_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPESystemIdentifierDoubleQuoted;
                        },
                        Some('\'') => {
                            self.current_doctype_system_id = Some(String::new());
                            self.state = TokenizerState::DOCTYPESystemIdentifierSingleQuoted;
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            self.current_doctype_force_quirks = true;
                            self.reconsume();
                            self.state = TokenizerState::BogusDOCTYPE;
                        }
                    }
                },

                TokenizerState::DOCTYPESystemIdentifierDoubleQuoted => {
                    match self.consume() {
                        Some('"') => {
                            self.state = TokenizerState::AfterDOCTYPESystemIdentifier;
                        },
                        Some('\0') => {
                            if let Some(ref mut id) = self.current_doctype_system_id {
                                id.push('\u{FFFD}');
                            }
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some(c) => {
                            if let Some(ref mut id) = self.current_doctype_system_id {
                                id.push(c);
                            }
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::DOCTYPESystemIdentifierSingleQuoted => {
                    match self.consume() {
                        Some('\'') => {
                            self.state = TokenizerState::AfterDOCTYPESystemIdentifier;
                        },
                        Some('\0') => {
                            if let Some(ref mut id) = self.current_doctype_system_id {
                                id.push('\u{FFFD}');
                            }
                        },
                        Some('>') => {
                            self.current_doctype_force_quirks = true;
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some(c) => {
                            if let Some(ref mut id) = self.current_doctype_system_id {
                                id.push(c);
                            }
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::AfterDOCTYPESystemIdentifier => {
                    match self.consume() {
                        Some('\t') | Some('\n') | Some('\x0C') | Some(' ') => {
                            // Ignore
                        },
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        None => {
                            self.current_doctype_force_quirks = true;
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            // Parse error, don't set force quirks
                            self.reconsume();
                            self.state = TokenizerState::BogusDOCTYPE;
                        }
                    }
                },

                TokenizerState::BogusDOCTYPE => {
                    match self.consume() {
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_doctype();
                        },
                        Some('\0') => {
                            // Parse error, ignore
                        },
                        None => {
                            self.emit_current_doctype();
                            return HtmlToken::EOF;
                        },
                        _ => {
                            // Ignore character
                        }
                    }
                },

                TokenizerState::BogusComment => {
                    match self.consume() {
                        Some('>') => {
                            self.state = TokenizerState::Data;
                            self.emit_current_comment();
                        },
                        Some('\0') => {
                            self.current_comment.push('\u{FFFD}');
                        },
                        Some(c) => {
                            self.current_comment.push(c);
                        },
                        None => {
                            self.emit_current_comment();
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::CharacterReference => {
                    self.temp_buffer = String::new();
                    self.temp_buffer.push('&');

                    match self.peek() {
                        Some(c) if c.is_ascii_alphanumeric() => {
                            self.state = TokenizerState::NamedCharacterReference;
                        },
                        Some('#') => {
                            self.temp_buffer.push(self.consume().unwrap());
                            self.state = TokenizerState::NumericCharacterReference;
                        },
                        _ => {
                            self.flush_code_points_consumed_as_character_reference();
                            self.state = self.return_state;
                        }
                    }
                },

                TokenizerState::NamedCharacterReference => {
                    // Simplified: just look for common entities
                    let entity = self.try_consume_named_entity();
                    if let Some(replacement) = entity {
                        self.temp_buffer = String::new();
                        for c in replacement.chars() {
                            self.temp_buffer.push(c);
                        }
                        self.flush_code_points_consumed_as_character_reference();
                        self.state = self.return_state;
                    } else {
                        self.flush_code_points_consumed_as_character_reference();
                        self.state = TokenizerState::AmbiguousAmpersand;
                    }
                },

                TokenizerState::AmbiguousAmpersand => {
                    match self.consume() {
                        Some(c) if c.is_ascii_alphanumeric() => {
                            if self.is_in_attribute() {
                                self.current_attribute_value.push(c);
                            } else {
                                self.emit(HtmlToken::character(c));
                            }
                        },
                        Some(';') => {
                            // Parse error
                            self.reconsume();
                            self.state = self.return_state;
                        },
                        _ => {
                            self.reconsume();
                            self.state = self.return_state;
                        }
                    }
                },

                TokenizerState::NumericCharacterReference => {
                    self.character_reference_code = 0;

                    match self.peek() {
                        Some('x') | Some('X') => {
                            self.temp_buffer.push(self.consume().unwrap());
                            self.state = TokenizerState::HexadecimalCharacterReferenceStart;
                        },
                        _ => {
                            self.state = TokenizerState::DecimalCharacterReferenceStart;
                        }
                    }
                },

                TokenizerState::HexadecimalCharacterReferenceStart => {
                    match self.peek() {
                        Some(c) if c.is_ascii_hexdigit() => {
                            self.state = TokenizerState::HexadecimalCharacterReference;
                        },
                        _ => {
                            // Parse error
                            self.flush_code_points_consumed_as_character_reference();
                            self.state = self.return_state;
                        }
                    }
                },

                TokenizerState::DecimalCharacterReferenceStart => {
                    match self.peek() {
                        Some(c) if c.is_ascii_digit() => {
                            self.state = TokenizerState::DecimalCharacterReference;
                        },
                        _ => {
                            // Parse error
                            self.flush_code_points_consumed_as_character_reference();
                            self.state = self.return_state;
                        }
                    }
                },

                TokenizerState::HexadecimalCharacterReference => {
                    match self.consume() {
                        Some(c) if c.is_ascii_digit() => {
                            self.character_reference_code = self.character_reference_code * 16 +
                                (c as u32 - '0' as u32);
                        },
                        Some(c) if c >= 'A' && c <= 'F' => {
                            self.character_reference_code = self.character_reference_code * 16 +
                                (c as u32 - 'A' as u32 + 10);
                        },
                        Some(c) if c >= 'a' && c <= 'f' => {
                            self.character_reference_code = self.character_reference_code * 16 +
                                (c as u32 - 'a' as u32 + 10);
                        },
                        Some(';') => {
                            self.state = TokenizerState::NumericCharacterReferenceEnd;
                        },
                        _ => {
                            // Parse error
                            self.reconsume();
                            self.state = TokenizerState::NumericCharacterReferenceEnd;
                        }
                    }
                },

                TokenizerState::DecimalCharacterReference => {
                    match self.consume() {
                        Some(c) if c.is_ascii_digit() => {
                            self.character_reference_code = self.character_reference_code * 10 +
                                (c as u32 - '0' as u32);
                        },
                        Some(';') => {
                            self.state = TokenizerState::NumericCharacterReferenceEnd;
                        },
                        _ => {
                            // Parse error
                            self.reconsume();
                            self.state = TokenizerState::NumericCharacterReferenceEnd;
                        }
                    }
                },

                TokenizerState::NumericCharacterReferenceEnd => {
                    let code = self.character_reference_code;
                    let replacement = if code == 0 {
                        '\u{FFFD}'
                    } else if code > 0x10FFFF {
                        '\u{FFFD}'
                    } else if code >= 0xD800 && code <= 0xDFFF {
                        '\u{FFFD}'
                    } else if let Some(c) = char::from_u32(code) {
                        c
                    } else {
                        '\u{FFFD}'
                    };

                    self.temp_buffer = String::new();
                    self.temp_buffer.push(replacement);
                    self.flush_code_points_consumed_as_character_reference();
                    self.state = self.return_state;
                },

                // RCDATA, RAWTEXT, ScriptData states (simplified)
                TokenizerState::RCDATA => {
                    match self.consume() {
                        Some('&') => {
                            self.return_state = TokenizerState::RCDATA;
                            self.state = TokenizerState::CharacterReference;
                        },
                        Some('<') => {
                            self.state = TokenizerState::RCDATALessThanSign;
                        },
                        Some('\0') => {
                            return HtmlToken::character('\u{FFFD}');
                        },
                        Some(c) => {
                            return HtmlToken::character(c);
                        },
                        None => {
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::RAWTEXT => {
                    match self.consume() {
                        Some('<') => {
                            self.state = TokenizerState::RAWTEXTLessThanSign;
                        },
                        Some('\0') => {
                            return HtmlToken::character('\u{FFFD}');
                        },
                        Some(c) => {
                            return HtmlToken::character(c);
                        },
                        None => {
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::ScriptData => {
                    match self.consume() {
                        Some('<') => {
                            self.state = TokenizerState::ScriptDataLessThanSign;
                        },
                        Some('\0') => {
                            return HtmlToken::character('\u{FFFD}');
                        },
                        Some(c) => {
                            return HtmlToken::character(c);
                        },
                        None => {
                            return HtmlToken::EOF;
                        }
                    }
                },

                TokenizerState::PLAINTEXT => {
                    match self.consume() {
                        Some('\0') => {
                            return HtmlToken::character('\u{FFFD}');
                        },
                        Some(c) => {
                            return HtmlToken::character(c);
                        },
                        None => {
                            return HtmlToken::EOF;
                        }
                    }
                },

                // Simplified handlers for other raw text states
                _ => {
                    // For any unhandled states, return to Data state
                    self.state = TokenizerState::Data;
                }
            }
        }
    }

    // Check if currently in attribute value
    fn is_in_attribute(&self) -> bool {
        match self.return_state {
            TokenizerState::AttributeValueDoubleQuoted |
            TokenizerState::AttributeValueSingleQuoted |
            TokenizerState::AttributeValueUnquoted => true,
            _ => false,
        }
    }

    // Flush temp buffer as character reference
    fn flush_code_points_consumed_as_character_reference(&mut self) {
        if self.is_in_attribute() {
            for c in self.temp_buffer.chars() {
                self.current_attribute_value.push(c);
            }
        } else {
            for c in self.temp_buffer.chars() {
                self.emit(HtmlToken::character(c));
            }
        }
        self.temp_buffer = String::new();
    }

    // Try to consume a named character reference
    fn try_consume_named_entity(&mut self) -> Option<&'static str> {
        // Common named entities
        let entities: &[(&str, &str)] = &[
            ("amp;", "&"),
            ("lt;", "<"),
            ("gt;", ">"),
            ("quot;", "\""),
            ("apos;", "'"),
            ("nbsp;", "\u{00A0}"),
            ("copy;", "\u{00A9}"),
            ("reg;", "\u{00AE}"),
            ("mdash;", "\u{2014}"),
            ("ndash;", "\u{2013}"),
            ("hellip;", "\u{2026}"),
            ("trade;", "\u{2122}"),
            ("bull;", "\u{2022}"),
            ("lsquo;", "\u{2018}"),
            ("rsquo;", "\u{2019}"),
            ("ldquo;", "\u{201C}"),
            ("rdquo;", "\u{201D}"),
            ("euro;", "\u{20AC}"),
            ("pound;", "\u{00A3}"),
            ("yen;", "\u{00A5}"),
            ("cent;", "\u{00A2}"),
            ("deg;", "\u{00B0}"),
            ("plusmn;", "\u{00B1}"),
            ("times;", "\u{00D7}"),
            ("divide;", "\u{00F7}"),
            ("frac12;", "\u{00BD}"),
            ("frac14;", "\u{00BC}"),
            ("frac34;", "\u{00BE}"),
        ];

        for (name, replacement) in entities {
            if self.matches_ci(name) {
                self.pos = self.pos + name.len();
                return Some(replacement);
            }
        }

        // Consume alphanumeric characters into temp buffer
        while let Some(c) = self.peek() {
            if c.is_ascii_alphanumeric() {
                self.temp_buffer.push(self.consume().unwrap());
            } else {
                break;
            }
        }

        None
    }

    // Set tokenizer state (for tree builder)
    pub fn set_state(&mut self, state: TokenizerState) {
        self.state = state;
    }

    // Tokenize all and return tokens
    pub fn tokenize_all(&mut self) -> Vec<HtmlToken> {
        let mut tokens = Vec::new();
        loop {
            let token = self.next_token();
            match &token {
                HtmlToken::EOF => {
                    tokens.push(token);
                    break;
                },
                _ => {
                    tokens.push(token);
                }
            }
        }
        tokens
    }
}

// ============================================================
// Helper Functions
// ============================================================

pub fn is_void_element(tag_name: &str) -> bool {
    match tag_name {
        "area" | "base" | "br" | "col" | "embed" | "hr" | "img" |
        "input" | "link" | "meta" | "param" | "source" | "track" | "wbr" => true,
        _ => false,
    }
}

pub fn is_raw_text_element(tag_name: &str) -> bool {
    match tag_name {
        "script" | "style" => true,
        _ => false,
    }
}

pub fn is_escapable_raw_text_element(tag_name: &str) -> bool {
    match tag_name {
        "textarea" | "title" => true,
        _ => false,
    }
}
