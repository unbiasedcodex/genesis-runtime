// ============================================================
// Selector Matching
// ============================================================

use super::html::{Document, Node, NodeType, NodeData};

impl Document {
    // Match a selector against a node
    pub fn selector_matches(&self, node_idx: usize, selector: &Selector) -> bool {
        match selector {
            Selector::Universal => true,

            Selector::Type(tag) => {
                if let Some(node) = self.get_node(node_idx) {
                    node.tag_name() == Some(tag.as_str())
                } else {
                    false
                }
            },

            Selector::Id(id) => {
                if let Some(node) = self.get_node(node_idx) {
                    node.get_attribute("id") == Some(id.as_str())
                } else {
                    false
                }
            },

            Selector::Class(class) => {
                if let Some(node) = self.get_node(node_idx) {
                    if let Some(classes) = node.get_attribute("class") {
                        for c in classes.split_whitespace() {
                            if c == class {
                                return true;
                            }
                        }
                    }
                }
                false
            },

            Selector::Attribute(attr_sel) => {
                self.match_attribute_selector(node_idx, attr_sel)
            },

            Selector::PseudoClass(pseudo) => {
                self.match_pseudo_class(node_idx, pseudo)
            },

            Selector::PseudoElement(_) => {
                // Pseudo-elements match any element (they're applied during rendering)
                true
            },

            Selector::Compound(selectors) => {
                for sel in selectors {
                    if !self.selector_matches(node_idx, sel) {
                        return false;
                    }
                }
                true
            },

            Selector::Descendant(ancestor, descendant) => {
                if !self.selector_matches(node_idx, descendant) {
                    return false;
                }
                // Check ancestors
                let mut current = node_idx;
                while let Some(parent_idx) = self.get_node(current).and_then(|n| n.parent) {
                    if self.selector_matches(parent_idx, ancestor) {
                        return true;
                    }
                    current = parent_idx;
                }
                false
            },

            Selector::Child(parent, child) => {
                if !self.selector_matches(node_idx, child) {
                    return false;
                }
                if let Some(node) = self.get_node(node_idx) {
                    if let Some(parent_idx) = node.parent {
                        return self.selector_matches(parent_idx, parent);
                    }
                }
                false
            },

            Selector::NextSibling(prev, current) => {
                if !self.selector_matches(node_idx, current) {
                    return false;
                }
                if let Some(prev_idx) = self.previous_element_sibling(node_idx) {
                    return self.selector_matches(prev_idx, prev);
                }
                false
            },

            Selector::SubsequentSibling(prev, current) => {
                if !self.selector_matches(node_idx, current) {
                    return false;
                }
                // Check all previous siblings
                let mut sibling = self.previous_element_sibling(node_idx);
                while let Some(idx) = sibling {
                    if self.selector_matches(idx, prev) {
                        return true;
                    }
                    sibling = self.previous_element_sibling(idx);
                }
                false
            },

            Selector::List(selectors) => {
                for sel in selectors {
                    if self.selector_matches(node_idx, sel) {
                        return true;
                    }
                }
                false
            },
        }
    }

    fn match_attribute_selector(&self, node_idx: usize, attr_sel: &AttributeSelector) -> bool {
        let node = match self.get_node(node_idx) {
            Some(n) => n,
            None => return false,
        };

        let attr_value = match node.get_attribute(&attr_sel.name) {
            Some(v) => v,
            None => return attr_sel.matcher.is_none(), // [attr] matches if attr exists
        };

        match &attr_sel.matcher {
            None => true, // [attr] - attribute exists

            Some(AttributeMatcher::Exact(value)) => {
                if attr_sel.case_insensitive {
                    attr_value.to_ascii_lowercase() == value.to_ascii_lowercase()
                } else {
                    attr_value == value
                }
            },

            Some(AttributeMatcher::Includes(value)) => {
                for word in attr_value.split_whitespace() {
                    if attr_sel.case_insensitive {
                        if word.to_ascii_lowercase() == value.to_ascii_lowercase() {
                            return true;
                        }
                    } else if word == value {
                        return true;
                    }
                }
                false
            },

            Some(AttributeMatcher::DashMatch(value)) => {
                if attr_sel.case_insensitive {
                    let lower = attr_value.to_ascii_lowercase();
                    let val_lower = value.to_ascii_lowercase();
                    lower == val_lower || lower.starts_with(&format!("{}-", val_lower))
                } else {
                    attr_value == value || attr_value.starts_with(&format!("{}-", value))
                }
            },

            Some(AttributeMatcher::Prefix(value)) => {
                if attr_sel.case_insensitive {
                    attr_value.to_ascii_lowercase().starts_with(&value.to_ascii_lowercase())
                } else {
                    attr_value.starts_with(value)
                }
            },

            Some(AttributeMatcher::Suffix(value)) => {
                if attr_sel.case_insensitive {
                    attr_value.to_ascii_lowercase().ends_with(&value.to_ascii_lowercase())
                } else {
                    attr_value.ends_with(value)
                }
            },

            Some(AttributeMatcher::Substring(value)) => {
                if attr_sel.case_insensitive {
                    attr_value.to_ascii_lowercase().contains(&value.to_ascii_lowercase())
                } else {
                    attr_value.contains(value)
                }
            },
        }
    }

    fn match_pseudo_class(&self, node_idx: usize, pseudo: &PseudoClass) -> bool {
        match pseudo {
            PseudoClass::Root => {
                // Check if this is the document element
                self.document_element == Some(node_idx)
            },

            PseudoClass::Empty => {
                if let Some(node) = self.get_node(node_idx) {
                    // Empty if no element or text children
                    for &child_idx in &node.children {
                        if let Some(child) = self.get_node(child_idx) {
                            match child.node_type {
                                NodeType::Element => return false,
                                NodeType::Text => {
                                    if let Some(text) = child.text_content() {
                                        if !text.trim().is_empty() {
                                            return false;
                                        }
                                    }
                                },
                                _ => {}
                            }
                        }
                    }
                    true
                } else {
                    false
                }
            },

            PseudoClass::FirstChild => {
                self.get_sibling_index(node_idx) == Some(0)
            },

            PseudoClass::LastChild => {
                if let Some(parent_idx) = self.get_node(node_idx).and_then(|n| n.parent) {
                    let siblings = self.child_elements(parent_idx);
                    siblings.last() == Some(&node_idx)
                } else {
                    false
                }
            },

            PseudoClass::OnlyChild => {
                if let Some(parent_idx) = self.get_node(node_idx).and_then(|n| n.parent) {
                    self.child_element_count(parent_idx) == 1
                } else {
                    false
                }
            },

            PseudoClass::FirstOfType => {
                self.get_type_index(node_idx) == Some(0)
            },

            PseudoClass::LastOfType => {
                if let Some(node) = self.get_node(node_idx) {
                    let tag = node.tag_name()?;
                    let parent_idx = node.parent?;
                    let siblings = self.get_elements_by_tag_name_in_parent(parent_idx, tag);
                    siblings.last() == Some(&node_idx)
                } else {
                    false
                }
            },

            PseudoClass::OnlyOfType => {
                if let Some(node) = self.get_node(node_idx) {
                    let tag = node.tag_name()?;
                    let parent_idx = node.parent?;
                    let siblings = self.get_elements_by_tag_name_in_parent(parent_idx, tag);
                    siblings.len() == 1
                } else {
                    false
                }
            },

            PseudoClass::NthChild(expr) => {
                if let Some(index) = self.get_sibling_index(node_idx) {
                    expr.matches((index + 1) as i32)
                } else {
                    false
                }
            },

            PseudoClass::NthLastChild(expr) => {
                if let Some(parent_idx) = self.get_node(node_idx).and_then(|n| n.parent) {
                    let siblings = self.child_elements(parent_idx);
                    if let Some(pos) = self.index_of(&siblings, node_idx) {
                        let from_end = siblings.len() - pos;
                        return expr.matches(from_end as i32);
                    }
                }
                false
            },

            PseudoClass::NthOfType(expr) => {
                if let Some(index) = self.get_type_index(node_idx) {
                    expr.matches((index + 1) as i32)
                } else {
                    false
                }
            },

            PseudoClass::NthLastOfType(expr) => {
                if let Some(node) = self.get_node(node_idx) {
                    let tag = node.tag_name()?;
                    let parent_idx = node.parent?;
                    let siblings = self.get_elements_by_tag_name_in_parent(parent_idx, tag);
                    if let Some(pos) = self.index_of(&siblings, node_idx) {
                        let from_end = siblings.len() - pos;
                        return expr.matches(from_end as i32);
                    }
                }
                false
            },

            PseudoClass::Not(inner) => {
                !self.selector_matches(node_idx, inner)
            },

            PseudoClass::Is(selectors) | PseudoClass::Where(selectors) => {
                for sel in selectors {
                    if self.selector_matches(node_idx, sel) {
                        return true;
                    }
                }
                false
            },

            PseudoClass::Has(selectors) => {
                // :has() matches if any descendant matches
                for sel in selectors {
                    if self.has_descendant_matching(node_idx, sel) {
                        return true;
                    }
                }
                false
            },

            PseudoClass::Lang(lang) => {
                // Check lang attribute on this element or ancestors
                let mut current = Some(node_idx);
                while let Some(idx) = current {
                    if let Some(node) = self.get_node(idx) {
                        if let Some(node_lang) = node.get_attribute("lang") {
                            return node_lang.to_ascii_lowercase().starts_with(&lang.to_ascii_lowercase());
                        }
                        current = node.parent;
                    } else {
                        break;
                    }
                }
                false
            },

            // Interactive pseudo-classes (always false in static matching)
            PseudoClass::Link |
            PseudoClass::Visited |
            PseudoClass::Hover |
            PseudoClass::Active |
            PseudoClass::Focus |
            PseudoClass::FocusWithin |
            PseudoClass::FocusVisible |
            PseudoClass::Target => false,

            // Form pseudo-classes
            PseudoClass::Enabled => {
                if let Some(node) = self.get_node(node_idx) {
                    let tag = node.tag_name().unwrap_or("");
                    if matches!(tag, "input" | "button" | "select" | "textarea") {
                        return node.get_attribute("disabled").is_none();
                    }
                }
                false
            },

            PseudoClass::Disabled => {
                if let Some(node) = self.get_node(node_idx) {
                    node.get_attribute("disabled").is_some()
                } else {
                    false
                }
            },

            PseudoClass::Checked => {
                if let Some(node) = self.get_node(node_idx) {
                    node.get_attribute("checked").is_some()
                } else {
                    false
                }
            },

            PseudoClass::Required => {
                if let Some(node) = self.get_node(node_idx) {
                    node.get_attribute("required").is_some()
                } else {
                    false
                }
            },

            PseudoClass::Optional => {
                if let Some(node) = self.get_node(node_idx) {
                    node.get_attribute("required").is_none()
                } else {
                    false
                }
            },

            PseudoClass::ReadOnly => {
                if let Some(node) = self.get_node(node_idx) {
                    node.get_attribute("readonly").is_some()
                } else {
                    false
                }
            },

            PseudoClass::ReadWrite => {
                if let Some(node) = self.get_node(node_idx) {
                    node.get_attribute("readonly").is_none()
                } else {
                    false
                }
            },

            _ => false, // Other pseudo-classes not implemented
        }
    }

    // Explicit search: glc's VecIter has no position()
    fn index_of(&self, list: &Vec<usize>, target: usize) -> Option<usize> {
        let mut i = 0;
        while i < list.len() {
            if list[i] == target {
                return Some(i);
            }
            i = i + 1;
        }
        None
    }

    fn get_sibling_index(&self, node_idx: usize) -> Option<usize> {
        let node = self.get_node(node_idx)?;
        let parent_idx = node.parent?;
        let siblings = self.child_elements(parent_idx);
        self.index_of(&siblings, node_idx)
    }

    fn get_type_index(&self, node_idx: usize) -> Option<usize> {
        let node = self.get_node(node_idx)?;
        let tag = node.tag_name()?;
        let parent_idx = node.parent?;
        let same_type = self.get_elements_by_tag_name_in_parent(parent_idx, tag);
        self.index_of(&same_type, node_idx)
    }

    fn get_elements_by_tag_name_in_parent(&self, parent_idx: usize, tag: &str) -> Vec<usize> {
        let mut result = Vec::new();
        if let Some(parent) = self.get_node(parent_idx) {
            for &child_idx in &parent.children {
                if let Some(child) = self.get_node(child_idx) {
                    if child.tag_name() == Some(tag) {
                        result.push(child_idx);
                    }
                }
            }
        }
        result
    }

    fn has_descendant_matching(&self, node_idx: usize, selector: &Selector) -> bool {
        if let Some(node) = self.get_node(node_idx) {
            for &child_idx in &node.children {
                if self.selector_matches(child_idx, selector) {
                    return true;
                }
                if self.has_descendant_matching(child_idx, selector) {
                    return true;
                }
            }
        }
        false
    }

    // Get all matching rules for a node
    pub fn get_matching_rules(&self, node_idx: usize, stylesheet: &Stylesheet) -> Vec<(Specificity, &StyleRule)> {
        let mut matched = Vec::new();

        for rule in stylesheet.get_style_rules() {
            for selector in &rule.selectors {
                if self.selector_matches(node_idx, selector) {
                    matched.push((selector.specificity(), rule));
                    break; // Only need to match one selector per rule
                }
            }
        }

        matched
    }
}

// ============================================================
// Style Computation
// ============================================================

impl Document {
    // Compute style for a node given stylesheets
    pub fn compute_style(&self, node_idx: usize, stylesheets: &[Stylesheet]) -> ComputedStyle {
        let mut resolver = StyleResolver::new();
        let mut matched_rules = Vec::new();
        let mut order = 0;

        for stylesheet in stylesheets {
            let matches = self.get_matching_rules(node_idx, stylesheet);
            for (specificity, rule) in matches {
                matched_rules.push(MatchedRule {
                    specificity,
                    declarations: rule.declarations.clone(),
                    source_order: order,
                });
                order += 1;
            }
        }

        // Add inline styles (highest specificity)
        if let Some(node) = self.get_node(node_idx) {
            if let Some(style_attr) = node.get_attribute("style") {
                let inline_decls = parse_declarations(style_attr);
                matched_rules.push(MatchedRule {
                    specificity: Specificity::inline_style(),
                    declarations: inline_decls,
                    source_order: order,
                });
            }
        }

        resolver.resolve_style(&matched_rules)
    }
}
