}

// ============================================================
// Matched Rule
// ============================================================

#[derive(Clone)]
pub struct MatchedRule {
    pub specificity: Specificity,
    pub declarations: Vec<Declaration>,
    pub source_order: usize,
}

// ============================================================
// Style Resolver
// ============================================================

pub struct StyleResolver {
    stylesheets: Vec<Stylesheet>,
    source_counter: usize,
}

impl StyleResolver {
    pub fn new() -> StyleResolver {
        StyleResolver {
            stylesheets: Vec::new(),
            source_counter: 0,
        }
    }

    pub fn add_stylesheet(&mut self, stylesheet: Stylesheet) {
        self.stylesheets.push(stylesheet);
    }

    // Resolve style for an element (simplified - needs DOM context)
    pub fn resolve_style(&mut self, matched_rules: &[MatchedRule]) -> ComputedStyle {
        let mut style = ComputedStyle::default();

        // Sort rules by specificity and source order
        let mut sorted_rules = matched_rules.to_vec();
        sorted_rules.sort_by(|a, b| {
            match a.specificity.compare(&b.specificity) {
                std::cmp::Ordering::Equal => a.source_order.cmp(&b.source_order),
                other => other,
            }
        });

        // Apply declarations in order (later declarations win)
        for rule in sorted_rules {
            for decl in &rule.declarations {
                self.apply_declaration(&mut style, decl);
            }
        }

        style
    }

    fn apply_declaration(&self, style: &mut ComputedStyle, decl: &Declaration) {
        let value = &decl.value;
        if value.is_empty() {
            return;
        }

        match decl.property.as_str() {
            "display" => {
                if let Some(d) = parse_display(&value[0]) {
                    style.display = d;
                }
            },
            "position" => {
                if let Some(p) = parse_position(&value[0]) {
                    style.position = p;
                }
            },
            "float" => {
                if let Some(f) = parse_float(&value[0]) {
                    style.float = f;
                }
            },
            "clear" => {
                if let Some(c) = parse_clear(&value[0]) {
                    style.clear = c;
                }
            },
            "visibility" => {
                if let Some(v) = parse_visibility(&value[0]) {
                    style.visibility = v;
                }
            },
            "overflow" => {
                if let Some(o) = parse_overflow(&value[0]) {
                    style.overflow = o;
                    style.overflow_x = o;
                    style.overflow_y = o;
                }
            },
            "overflow-x" => {
                if let Some(o) = parse_overflow(&value[0]) {
                    style.overflow_x = o;
                }
            },
            "overflow-y" => {
                if let Some(o) = parse_overflow(&value[0]) {
                    style.overflow_y = o;
                }
            },
            "z-index" => {
                style.z_index = parse_z_index(&value[0]);
            },
            "opacity" => {
                if let CssValue::Number(n) = &value[0] {
                    style.opacity = (*n as f32).max(0.0).min(1.0);
                }
            },
            "width" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.width = d;
                }
            },
            "height" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.height = d;
                }
            },
            "min-width" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.min_width = d;
                }
            },
            "min-height" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.min_height = d;
                }
            },
            "max-width" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.max_width = d;
                }
            },
            "max-height" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.max_height = d;
                }
            },
            "margin" => {
                if let Some((t, r, b, l)) = parse_box_shorthand(value) {
                    style.margin_top = t;
                    style.margin_right = r;
                    style.margin_bottom = b;
                    style.margin_left = l;
                }
            },
            "margin-top" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.margin_top = d;
                }
            },
            "margin-right" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.margin_right = d;
                }
            },
            "margin-bottom" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.margin_bottom = d;
                }
            },
            "margin-left" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.margin_left = d;
                }
            },
            "padding" => {
                if let Some((t, r, b, l)) = parse_box_shorthand(value) {
                    style.padding_top = t;
                    style.padding_right = r;
                    style.padding_bottom = b;
                    style.padding_left = l;
                }
            },
            "padding-top" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.padding_top = d;
                }
            },
            "padding-right" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.padding_right = d;
                }
            },
            "padding-bottom" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.padding_bottom = d;
                }
            },
            "padding-left" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.padding_left = d;
                }
            },
            "border-width" => {
                if let Some(w) = parse_border_width(&value[0]) {
                    style.border_top_width = w;
                    style.border_right_width = w;
                    style.border_bottom_width = w;
                    style.border_left_width = w;
                }
            },
            "border-top-width" => {
                if let Some(w) = parse_border_width(&value[0]) {
                    style.border_top_width = w;
                }
            },
            "border-style" => {
                if let Some(s) = parse_border_style(&value[0]) {
                    style.border_top_style = s;
                    style.border_right_style = s;
                    style.border_bottom_style = s;
                    style.border_left_style = s;
                }
            },
            "border-color" => {
                if let CssValue::Color(c) = &value[0] {
                    style.border_top_color = *c;
                    style.border_right_color = *c;
                    style.border_bottom_color = *c;
                    style.border_left_color = *c;
                }
            },
            "border-radius" => {
                if let Some(r) = parse_length(&value[0]) {
                    style.border_radius_top_left = r;
                    style.border_radius_top_right = r;
                    style.border_radius_bottom_right = r;
                    style.border_radius_bottom_left = r;
                }
            },
            "top" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.top = d;
                }
            },
            "right" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.right = d;
                }
            },
            "bottom" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.bottom = d;
                }
            },
            "left" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.left = d;
                }
            },
            "background-color" => {
                if let CssValue::Color(c) = &value[0] {
                    style.background_color = *c;
                }
            },
            "background-image" => {
                if let CssValue::Url(url) = &value[0] {
                    style.background_image = Some(url.clone());
                } else if matches!(&value[0], CssValue::None) {
                    style.background_image = None;
                }
            },
            "color" => {
                if let CssValue::Color(c) = &value[0] {
                    style.color = *c;
                }
            },
            "font-family" => {
                style.font_family = parse_font_family(value);
            },
            "font-size" => {
                if let Some(s) = parse_font_size(&value[0]) {
                    style.font_size = s;
                }
            },
            "font-weight" => {
                if let Some(w) = parse_font_weight(&value[0]) {
                    style.font_weight = w;
                }
            },
            "font-style" => {
                if let Some(s) = parse_font_style(&value[0]) {
                    style.font_style = s;
                }
            },
            "line-height" => {
                if let Some(lh) = parse_line_height(&value[0]) {
                    style.line_height = lh;
                }
            },
            "text-align" => {
                if let Some(ta) = parse_text_align(&value[0]) {
                    style.text_align = ta;
                }
            },
            "text-decoration" => {
                if let Some(td) = parse_text_decoration(&value[0]) {
                    style.text_decoration = td;
                }
            },
            "text-transform" => {
                if let Some(tt) = parse_text_transform(&value[0]) {
                    style.text_transform = tt;
                }
            },
            "white-space" => {
                if let Some(ws) = parse_white_space(&value[0]) {
                    style.white_space = ws;
                }
            },
            "flex-direction" => {
                if let Some(fd) = parse_flex_direction(&value[0]) {
                    style.flex_direction = fd;
                }
            },
            "flex-wrap" => {
                if let Some(fw) = parse_flex_wrap(&value[0]) {
                    style.flex_wrap = fw;
                }
            },
            "justify-content" => {
                if let Some(jc) = parse_justify_content(&value[0]) {
                    style.justify_content = jc;
                }
            },
            "align-items" => {
                if let Some(ai) = parse_align_items(&value[0]) {
                    style.align_items = ai;
                }
            },
            "flex-grow" => {
                if let CssValue::Number(n) = &value[0] {
                    style.flex_grow = *n;
                }
            },
            "flex-shrink" => {
                if let CssValue::Number(n) = &value[0] {
                    style.flex_shrink = *n;
                }
            },
            "flex-basis" => {
                if let Some(d) = parse_dimension(&value[0]) {
                    style.flex_basis = d;
                }
            },
            "order" => {
                if let CssValue::Number(n) = &value[0] {
                    style.order = *n as i32;
                }
            },
            "cursor" => {
                if let Some(c) = parse_cursor(&value[0]) {
                    style.cursor = c;
                }
            },
            "pointer-events" => {
                if let CssValue::Keyword(k) = &value[0] {
                    style.pointer_events = match k.as_str() {
                        "none" => PointerEvents::None,
                        _ => PointerEvents::Auto,
                    };
                }
            },
            _ => {}
        }
    }
}

// ============================================================
// Value Parsing Helpers
// ============================================================

fn parse_display(value: &CssValue) -> Option<Display> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "none" => Some(Display::None),
            "block" => Some(Display::Block),
            "inline" => Some(Display::Inline),
            "inline-block" => Some(Display::InlineBlock),
            "flex" => Some(Display::Flex),
            "inline-flex" => Some(Display::InlineFlex),
            "grid" => Some(Display::Grid),
            "inline-grid" => Some(Display::InlineGrid),
            "table" => Some(Display::Table),
            "table-row" => Some(Display::TableRow),
            "table-cell" => Some(Display::TableCell),
            "list-item" => Some(Display::ListItem),
            "contents" => Some(Display::Contents),
            _ => None,
        },
        CssValue::None => Some(Display::None),
        _ => None,
    }
}

fn parse_position(value: &CssValue) -> Option<Position> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "static" => Some(Position::Static),
            "relative" => Some(Position::Relative),
            "absolute" => Some(Position::Absolute),
            "fixed" => Some(Position::Fixed),
            "sticky" => Some(Position::Sticky),
            _ => None,
        },
        _ => None,
    }
}

fn parse_float(value: &CssValue) -> Option<Float> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "left" => Some(Float::Left),
            "right" => Some(Float::Right),
            _ => Some(Float::None),
        },
        CssValue::None => Some(Float::None),
        _ => None,
    }
}

fn parse_clear(value: &CssValue) -> Option<Clear> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "left" => Some(Clear::Left),
            "right" => Some(Clear::Right),
            "both" => Some(Clear::Both),
            _ => Some(Clear::None),
        },
        CssValue::None => Some(Clear::None),
        _ => None,
    }
}

fn parse_visibility(value: &CssValue) -> Option<Visibility> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "visible" => Some(Visibility::Visible),
            "hidden" => Some(Visibility::Hidden),
            "collapse" => Some(Visibility::Collapse),
            _ => None,
        },
        _ => None,
    }
}

fn parse_overflow(value: &CssValue) -> Option<Overflow> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "visible" => Some(Overflow::Visible),
            "hidden" => Some(Overflow::Hidden),
            "scroll" => Some(Overflow::Scroll),
            "auto" => Some(Overflow::Auto),
            _ => None,
        },
        _ => None,
    }
}

fn parse_z_index(value: &CssValue) -> ZIndex {
    match value {
        CssValue::Number(n) => ZIndex::Number(*n as i32),
        CssValue::Auto => ZIndex::Auto,
        _ => ZIndex::Auto,
    }
}

fn parse_dimension(value: &CssValue) -> Option<Dimension> {
    match value {
        CssValue::Auto => Some(Dimension::Auto),
        CssValue::Length(n, _) => Some(Dimension::Length(*n)),
        CssValue::Percentage(n) => Some(Dimension::Percentage(*n)),
        CssValue::Number(n) if *n == 0.0 => Some(Dimension::Length(0.0)),
        CssValue::Keyword(k) => match k.as_str() {
            "max-content" => Some(Dimension::MaxContent),
            "min-content" => Some(Dimension::MinContent),
            "fit-content" => Some(Dimension::FitContent),
            _ => None,
        },
        _ => None,
    }
}

fn parse_length(value: &CssValue) -> Option<f64> {
    match value {
        CssValue::Length(n, _) => Some(*n),
        CssValue::Number(n) if *n == 0.0 => Some(0.0),
        _ => None,
    }
}

fn parse_border_width(value: &CssValue) -> Option<f64> {
    match value {
        CssValue::Length(n, _) => Some(*n),
        CssValue::Number(n) if *n == 0.0 => Some(0.0),
        CssValue::Keyword(k) => match k.as_str() {
            "thin" => Some(1.0),
            "medium" => Some(3.0),
            "thick" => Some(5.0),
            _ => None,
        },
        _ => None,
    }
}

fn parse_border_style(value: &CssValue) -> Option<BorderStyle> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "none" => Some(BorderStyle::None),
            "solid" => Some(BorderStyle::Solid),
            "dotted" => Some(BorderStyle::Dotted),
            "dashed" => Some(BorderStyle::Dashed),
            "double" => Some(BorderStyle::Double),
            "groove" => Some(BorderStyle::Groove),
            "ridge" => Some(BorderStyle::Ridge),
            "inset" => Some(BorderStyle::Inset),
            "outset" => Some(BorderStyle::Outset),
            "hidden" => Some(BorderStyle::Hidden),
            _ => None,
        },
        CssValue::None => Some(BorderStyle::None),
        _ => None,
    }
}

fn parse_font_family(values: &[CssValue]) -> Vec<String> {
    let mut families = Vec::new();
    for v in values {
        match v {
            CssValue::String(s) | CssValue::Keyword(s) => {
                families.push(s.clone());
            },
            _ => {}
        }
    }
    if families.is_empty() {
        families.push("sans-serif".to_string());
    }
    families
}

fn parse_font_size(value: &CssValue) -> Option<f64> {
    match value {
        CssValue::Length(n, _) => Some(*n),
        CssValue::Percentage(n) => Some(*n * 16.0 / 100.0), // Relative to 16px default
        CssValue::Keyword(k) => match k.as_str() {
            "xx-small" => Some(9.0),
            "x-small" => Some(10.0),
            "small" => Some(13.0),
            "medium" => Some(16.0),
            "large" => Some(18.0),
            "x-large" => Some(24.0),
            "xx-large" => Some(32.0),
            "smaller" => Some(13.0),
            "larger" => Some(19.0),
            _ => None,
        },
        _ => None,
    }
}

fn parse_font_weight(value: &CssValue) -> Option<FontWeight> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "normal" => Some(FontWeight::Normal),
            "bold" => Some(FontWeight::Bold),
            "bolder" => Some(FontWeight::Bolder),
            "lighter" => Some(FontWeight::Lighter),
            _ => None,
        },
        CssValue::Number(n) => Some(FontWeight::Number(*n as u32)),
        _ => None,
    }
}

fn parse_font_style(value: &CssValue) -> Option<FontStyle> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "normal" => Some(FontStyle::Normal),
            "italic" => Some(FontStyle::Italic),
            "oblique" => Some(FontStyle::Oblique),
            _ => None,
        },
        _ => None,
    }
}

fn parse_line_height(value: &CssValue) -> Option<LineHeight> {
    match value {
        CssValue::Keyword(k) if k == "normal" => Some(LineHeight::Normal),
        CssValue::Number(n) => Some(LineHeight::Number(*n)),
        CssValue::Length(n, _) => Some(LineHeight::Length(*n)),
        CssValue::Percentage(n) => Some(LineHeight::Percentage(*n)),
        _ => None,
    }
}

fn parse_text_align(value: &CssValue) -> Option<TextAlign> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "left" => Some(TextAlign::Left),
            "right" => Some(TextAlign::Right),
            "center" => Some(TextAlign::Center),
            "justify" => Some(TextAlign::Justify),
            "start" => Some(TextAlign::Start),
            "end" => Some(TextAlign::End),
            _ => None,
        },
        _ => None,
    }
}

fn parse_text_decoration(value: &CssValue) -> Option<TextDecoration> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "underline" => Some(TextDecoration::Underline),
            "overline" => Some(TextDecoration::Overline),
            "line-through" => Some(TextDecoration::LineThrough),
            _ => Some(TextDecoration::None),
        },
        CssValue::None => Some(TextDecoration::None),
        _ => None,
    }
}

fn parse_text_transform(value: &CssValue) -> Option<TextTransform> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "capitalize" => Some(TextTransform::Capitalize),
            "uppercase" => Some(TextTransform::Uppercase),
            "lowercase" => Some(TextTransform::Lowercase),
            _ => Some(TextTransform::None),
        },
        CssValue::None => Some(TextTransform::None),
        _ => None,
    }
}

fn parse_white_space(value: &CssValue) -> Option<WhiteSpace> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "normal" => Some(WhiteSpace::Normal),
            "nowrap" => Some(WhiteSpace::Nowrap),
            "pre" => Some(WhiteSpace::Pre),
            "pre-wrap" => Some(WhiteSpace::PreWrap),
            "pre-line" => Some(WhiteSpace::PreLine),
            "break-spaces" => Some(WhiteSpace::BreakSpaces),
            _ => None,
        },
        _ => None,
    }
}

fn parse_flex_direction(value: &CssValue) -> Option<FlexDirection> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "row" => Some(FlexDirection::Row),
            "row-reverse" => Some(FlexDirection::RowReverse),
            "column" => Some(FlexDirection::Column),
            "column-reverse" => Some(FlexDirection::ColumnReverse),
            _ => None,
        },
        _ => None,
    }
}

fn parse_flex_wrap(value: &CssValue) -> Option<FlexWrap> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "nowrap" => Some(FlexWrap::Nowrap),
            "wrap" => Some(FlexWrap::Wrap),
            "wrap-reverse" => Some(FlexWrap::WrapReverse),
            _ => None,
        },
        _ => None,
    }
}

fn parse_justify_content(value: &CssValue) -> Option<JustifyContent> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "flex-start" | "start" => Some(JustifyContent::FlexStart),
            "flex-end" | "end" => Some(JustifyContent::FlexEnd),
            "center" => Some(JustifyContent::Center),
            "space-between" => Some(JustifyContent::SpaceBetween),
            "space-around" => Some(JustifyContent::SpaceAround),
            "space-evenly" => Some(JustifyContent::SpaceEvenly),
            _ => None,
        },
        _ => None,
    }
}

fn parse_align_items(value: &CssValue) -> Option<AlignItems> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "flex-start" | "start" => Some(AlignItems::FlexStart),
            "flex-end" | "end" => Some(AlignItems::FlexEnd),
            "center" => Some(AlignItems::Center),
            "baseline" => Some(AlignItems::Baseline),
            "stretch" => Some(AlignItems::Stretch),
            _ => None,
        },
        _ => None,
    }
}

fn parse_cursor(value: &CssValue) -> Option<Cursor> {
    match value {
        CssValue::Keyword(k) => match k.as_str() {
            "auto" => Some(Cursor::Auto),
            "default" => Some(Cursor::Default),
            "pointer" => Some(Cursor::Pointer),
            "text" => Some(Cursor::Text),
            "move" => Some(Cursor::Move),
            "wait" => Some(Cursor::Wait),
            "help" => Some(Cursor::Help),
            "crosshair" => Some(Cursor::Crosshair),
            "not-allowed" => Some(Cursor::NotAllowed),
            "grab" => Some(Cursor::Grab),
            "grabbing" => Some(Cursor::Grabbing),
            _ => None,
        },
        _ => None,
    }
}

// Returns (top, right, bottom, left); glc has no closure generics, so
// callers assign the four values themselves
fn parse_box_shorthand(values: &[CssValue]) -> Option<(Dimension, Dimension, Dimension, Dimension)> {
    let mut dims: Vec<Dimension> = Vec::new();
    let mut i = 0;
    while i < values.len() {
        if let Some(d) = parse_dimension(&values[i]) {
            dims.push(d);
        }
        i = i + 1;
    }

    match dims.len() {
        1 => Some((dims[0], dims[0], dims[0], dims[0])),
        2 => Some((dims[0], dims[1], dims[0], dims[1])),
        3 => Some((dims[0], dims[1], dims[2], dims[1])),
        4 => Some((dims[0], dims[1], dims[2], dims[3])),
        _ => None,
    }
}
