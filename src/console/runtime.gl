// Genesis Runtime Library for Console Server
// Syscall wrappers for userspace programs

// ============================================================================
// Syscall Numbers (must match kernel)
// ============================================================================

pub const SYS_YIELD: i64 = 0;
pub const SYS_GETPID: i64 = 1;
pub const SYS_PRINT: i64 = 2;
pub const SYS_SEND: i64 = 3;
pub const SYS_RECV: i64 = 4;
pub const SYS_EXIT: i64 = 5;

// Keyboard syscalls
pub const SYS_KB_READ: i64 = 16;
pub const SYS_KB_AVAIL: i64 = 17;

// VGA syscalls (for console server)
pub const SYS_VGA_PUTCHAR: i64 = 36;
pub const SYS_VGA_SETCURSOR: i64 = 37;
pub const SYS_VGA_CLEAR: i64 = 38;
pub const SYS_VGA_SCROLL: i64 = 39;

// ============================================================================
// Low-level Syscall Functions
// ============================================================================

fn syscall0(num: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn syscall1(num: i64, arg1: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn syscall2(num: i64, arg1: i64, arg2: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn syscall3(num: i64, arg1: i64, arg2: i64, arg3: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn syscall4(num: i64, arg1: i64, arg2: i64, arg3: i64, arg4: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") num,
            in("rdi") arg1,
            in("rsi") arg2,
            in("rdx") arg3,
            in("r10") arg4,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// ============================================================================
// Process Management
// ============================================================================

pub fn yield_cpu() {
    syscall0(SYS_YIELD);
}

pub fn getpid() -> i64 {
    syscall0(SYS_GETPID)
}

pub fn exit() {
    syscall0(SYS_EXIT);
}

// ============================================================================
// Serial I/O (for debugging)
// ============================================================================

pub fn print_char(c: i64) {
    unsafe {
        asm!(
            "int $$0x80",
            in("rax") 2,      // SYS_PRINT = 2 (literal constant)
            in("rdi") c,
            lateout("rax") _,
            options(nostack, att_syntax)
        );
    }
}

pub fn print_num(n: i64) {
    if n < 0 {
        print_char(45);
        print_num(0 - n);
        return;
    }
    if n >= 10 {
        print_num(n / 10);
    }
    print_char(48 + (n % 10));
}

pub fn print_str8(s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64) {
    if s0 != 0 { print_char(s0); }
    if s1 != 0 { print_char(s1); }
    if s2 != 0 { print_char(s2); }
    if s3 != 0 { print_char(s3); }
    if s4 != 0 { print_char(s4); }
    if s5 != 0 { print_char(s5); }
    if s6 != 0 { print_char(s6); }
    if s7 != 0 { print_char(s7); }
}

// ============================================================================
// IPC - Inter-Process Communication
// ============================================================================

pub fn send(dest_pid: i64, msg: i64) -> i64 {
    syscall2(SYS_SEND, dest_pid, msg)
}

pub fn recv() -> i64 {
    syscall0(SYS_RECV)
}

// ============================================================================
// Keyboard Access
// ============================================================================

// Read character from keyboard buffer
// Returns: ASCII character, or -1 if buffer empty
pub fn kb_read() -> i64 {
    syscall0(SYS_KB_READ)
}

// Check if keyboard buffer has data
// Returns: 1 if data available, 0 otherwise
pub fn kb_avail() -> i64 {
    syscall0(SYS_KB_AVAIL)
}

// ============================================================================
// VGA Access (Console Server specific)
// ============================================================================

// Write character at position with color
// x: column (0-79), y: row (0-24), ch: ASCII char, color: attribute byte
pub fn vga_putchar(x: i64, y: i64, ch: i64, color: i64) -> i64 {
    syscall4(SYS_VGA_PUTCHAR, x, y, ch, color)
}

// Set hardware cursor position
// x: column (0-79), y: row (0-24)
pub fn vga_setcursor(x: i64, y: i64) -> i64 {
    syscall2(SYS_VGA_SETCURSOR, x, y)
}

// Clear screen region
// y_start: first row, y_end: last row (exclusive), color: fill color
pub fn vga_clear(y_start: i64, y_end: i64, color: i64) -> i64 {
    syscall3(SYS_VGA_CLEAR, y_start, y_end, color)
}

// Scroll screen region up by one line
// y_start: first row, y_end: last row (exclusive), color: fill color for new line
pub fn vga_scroll(y_start: i64, y_end: i64, color: i64) -> i64 {
    syscall3(SYS_VGA_SCROLL, y_start, y_end, color)
}
