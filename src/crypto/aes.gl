    0x60, 0x51, 0x7f, 0xa9, 0x19, 0xb5, 0x4a, 0x0d, 0x2d, 0xe5, 0x7a, 0x9f, 0x93, 0xc9, 0x9c, 0xef,
    0xa0, 0xe0, 0x3b, 0x4d, 0xae, 0x2a, 0xf5, 0xb0, 0xc8, 0xeb, 0xbb, 0x3c, 0x83, 0x53, 0x99, 0x61,
    0x17, 0x2b, 0x04, 0x7e, 0xba, 0x77, 0xd6, 0x26, 0xe1, 0x69, 0x14, 0x63, 0x55, 0x21, 0x0c, 0x7d,
];

// Round constants for key expansion
const RCON: [u8; 11] = [0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36];

// ============================================================
// AES Key Sizes
// ============================================================

pub const AES_128_KEY_SIZE: usize = 16;
pub const AES_192_KEY_SIZE: usize = 24;
pub const AES_256_KEY_SIZE: usize = 32;
pub const AES_BLOCK_SIZE: usize = 16;

// ============================================================
// AES Context
// ============================================================

#[repr(C)]
pub struct AesContext {
    round_keys: [u8; 240],  // Max for AES-256: 15 * 16 = 240 bytes
    num_rounds: usize,
    key_size: usize,
}

impl AesContext {
    pub fn new_128(key: &[u8; 16]) -> AesContext {
        let mut ctx = AesContext {
            round_keys: [0; 240],
            num_rounds: 10,
            key_size: 16,
        };
        key_expansion_128(&mut ctx, key);
        ctx
    }

    pub fn new_192(key: &[u8; 24]) -> AesContext {
        let mut ctx = AesContext {
            round_keys: [0; 240],
            num_rounds: 12,
            key_size: 24,
        };
        key_expansion_192(&mut ctx, key);
        ctx
    }

    pub fn new_256(key: &[u8; 32]) -> AesContext {
        let mut ctx = AesContext {
            round_keys: [0; 240],
            num_rounds: 14,
            key_size: 32,
        };
        key_expansion_256(&mut ctx, key);
        ctx
    }

    // Encrypt a single block
    pub fn encrypt_block(&self, input: &[u8; 16]) -> [u8; 16] {
        let mut state: [u8; 16] = *input;

        // Initial round key addition
        add_round_key(&mut state, &self.round_keys, 0);

        // Main rounds
        let mut round: usize = 1;
        while round < self.num_rounds {
            sub_bytes(&mut state);
            shift_rows(&mut state);
            mix_columns(&mut state);
            add_round_key(&mut state, &self.round_keys, round);
            round = round + 1;
        }

        // Final round (no MixColumns)
        sub_bytes(&mut state);
        shift_rows(&mut state);
        add_round_key(&mut state, &self.round_keys, self.num_rounds);

        state
    }

    // Decrypt a single block
    pub fn decrypt_block(&self, input: &[u8; 16]) -> [u8; 16] {
        let mut state: [u8; 16] = *input;

        // Initial round key addition (with last round key)
        add_round_key(&mut state, &self.round_keys, self.num_rounds);

        // Main rounds (in reverse)
        let mut round = self.num_rounds - 1;
        while round > 0 {
            inv_shift_rows(&mut state);
            inv_sub_bytes(&mut state);
            add_round_key(&mut state, &self.round_keys, round);
            inv_mix_columns(&mut state);
            round = round - 1;
        }

        // Final round
        inv_shift_rows(&mut state);
        inv_sub_bytes(&mut state);
        add_round_key(&mut state, &self.round_keys, 0);

        state
    }
}

// ============================================================
// Key Expansion
// ============================================================

fn key_expansion_128(ctx: &mut AesContext, key: &[u8; 16]) {
    // Copy key to first 16 bytes
    let mut i: usize = 0;
    while i < 16 {
        ctx.round_keys[i] = key[i];
        i = i + 1;
    }

    // Generate remaining round keys
    let mut i: usize = 4;  // word index
    while i < 44 {
        let mut temp: [u8; 4] = [0; 4];
        temp[0] = ctx.round_keys[(i - 1) * 4];
        temp[1] = ctx.round_keys[(i - 1) * 4 + 1];
        temp[2] = ctx.round_keys[(i - 1) * 4 + 2];
        temp[3] = ctx.round_keys[(i - 1) * 4 + 3];

        if i % 4 == 0 {
            // RotWord and SubWord
            let t = temp[0];
            temp[0] = SBOX[temp[1] as usize] ^ RCON[i / 4];
            temp[1] = SBOX[temp[2] as usize];
            temp[2] = SBOX[temp[3] as usize];
            temp[3] = SBOX[t as usize];
        }

        ctx.round_keys[i * 4] = ctx.round_keys[(i - 4) * 4] ^ temp[0];
        ctx.round_keys[i * 4 + 1] = ctx.round_keys[(i - 4) * 4 + 1] ^ temp[1];
        ctx.round_keys[i * 4 + 2] = ctx.round_keys[(i - 4) * 4 + 2] ^ temp[2];
        ctx.round_keys[i * 4 + 3] = ctx.round_keys[(i - 4) * 4 + 3] ^ temp[3];

        i = i + 1;
    }
}

fn key_expansion_192(ctx: &mut AesContext, key: &[u8; 24]) {
    let mut i: usize = 0;
    while i < 24 {
        ctx.round_keys[i] = key[i];
        i = i + 1;
    }

    let mut i: usize = 6;
    while i < 52 {
        let mut temp: [u8; 4] = [0; 4];
        temp[0] = ctx.round_keys[(i - 1) * 4];
        temp[1] = ctx.round_keys[(i - 1) * 4 + 1];
        temp[2] = ctx.round_keys[(i - 1) * 4 + 2];
        temp[3] = ctx.round_keys[(i - 1) * 4 + 3];

        if i % 6 == 0 {
            let t = temp[0];
            temp[0] = SBOX[temp[1] as usize] ^ RCON[i / 6];
            temp[1] = SBOX[temp[2] as usize];
            temp[2] = SBOX[temp[3] as usize];
            temp[3] = SBOX[t as usize];
        }

        ctx.round_keys[i * 4] = ctx.round_keys[(i - 6) * 4] ^ temp[0];
        ctx.round_keys[i * 4 + 1] = ctx.round_keys[(i - 6) * 4 + 1] ^ temp[1];
        ctx.round_keys[i * 4 + 2] = ctx.round_keys[(i - 6) * 4 + 2] ^ temp[2];
        ctx.round_keys[i * 4 + 3] = ctx.round_keys[(i - 6) * 4 + 3] ^ temp[3];

        i = i + 1;
    }
}

fn key_expansion_256(ctx: &mut AesContext, key: &[u8; 32]) {
    let mut i: usize = 0;
    while i < 32 {
        ctx.round_keys[i] = key[i];
        i = i + 1;
    }

    let mut i: usize = 8;
    while i < 60 {
        let mut temp: [u8; 4] = [0; 4];
        temp[0] = ctx.round_keys[(i - 1) * 4];
        temp[1] = ctx.round_keys[(i - 1) * 4 + 1];
        temp[2] = ctx.round_keys[(i - 1) * 4 + 2];
        temp[3] = ctx.round_keys[(i - 1) * 4 + 3];

        if i % 8 == 0 {
            let t = temp[0];
            temp[0] = SBOX[temp[1] as usize] ^ RCON[i / 8];
            temp[1] = SBOX[temp[2] as usize];
            temp[2] = SBOX[temp[3] as usize];
            temp[3] = SBOX[t as usize];
        } else if i % 8 == 4 {
            temp[0] = SBOX[temp[0] as usize];
            temp[1] = SBOX[temp[1] as usize];
            temp[2] = SBOX[temp[2] as usize];
            temp[3] = SBOX[temp[3] as usize];
        }

        ctx.round_keys[i * 4] = ctx.round_keys[(i - 8) * 4] ^ temp[0];
        ctx.round_keys[i * 4 + 1] = ctx.round_keys[(i - 8) * 4 + 1] ^ temp[1];
        ctx.round_keys[i * 4 + 2] = ctx.round_keys[(i - 8) * 4 + 2] ^ temp[2];
        ctx.round_keys[i * 4 + 3] = ctx.round_keys[(i - 8) * 4 + 3] ^ temp[3];

        i = i + 1;
    }
}

// ============================================================
// AES Round Functions
// ============================================================

fn sub_bytes(state: &mut [u8; 16]) {
    let mut i: usize = 0;
    while i < 16 {
        state[i] = SBOX[state[i] as usize];
        i = i + 1;
    }
}

fn inv_sub_bytes(state: &mut [u8; 16]) {
    let mut i: usize = 0;
    while i < 16 {
        state[i] = INV_SBOX[state[i] as usize];
        i = i + 1;
    }
}

fn shift_rows(state: &mut [u8; 16]) {
    // Row 1: shift left by 1
    let temp = state[1];
    state[1] = state[5];
    state[5] = state[9];
    state[9] = state[13];
    state[13] = temp;

    // Row 2: shift left by 2
    let temp = state[2];
    state[2] = state[10];
    state[10] = temp;
    let temp = state[6];
    state[6] = state[14];
    state[14] = temp;

    // Row 3: shift left by 3 (= right by 1)
    let temp = state[15];
    state[15] = state[11];
    state[11] = state[7];
    state[7] = state[3];
    state[3] = temp;
}

fn inv_shift_rows(state: &mut [u8; 16]) {
    // Row 1: shift right by 1
    let temp = state[13];
    state[13] = state[9];
    state[9] = state[5];
    state[5] = state[1];
    state[1] = temp;

    // Row 2: shift right by 2
    let temp = state[2];
    state[2] = state[10];
    state[10] = temp;
    let temp = state[6];
    state[6] = state[14];
    state[14] = temp;

    // Row 3: shift right by 3 (= left by 1)
    let temp = state[3];
    state[3] = state[7];
    state[7] = state[11];
    state[11] = state[15];
    state[15] = temp;
}

fn mix_columns(state: &mut [u8; 16]) {
    let mut i: usize = 0;
    while i < 4 {
        let s0 = state[i * 4];
        let s1 = state[i * 4 + 1];
        let s2 = state[i * 4 + 2];
        let s3 = state[i * 4 + 3];

        state[i * 4] = gf_mul(0x02, s0) ^ gf_mul(0x03, s1) ^ s2 ^ s3;
        state[i * 4 + 1] = s0 ^ gf_mul(0x02, s1) ^ gf_mul(0x03, s2) ^ s3;
        state[i * 4 + 2] = s0 ^ s1 ^ gf_mul(0x02, s2) ^ gf_mul(0x03, s3);
        state[i * 4 + 3] = gf_mul(0x03, s0) ^ s1 ^ s2 ^ gf_mul(0x02, s3);

        i = i + 1;
    }
}

fn inv_mix_columns(state: &mut [u8; 16]) {
    let mut i: usize = 0;
    while i < 4 {
        let s0 = state[i * 4];
        let s1 = state[i * 4 + 1];
        let s2 = state[i * 4 + 2];
        let s3 = state[i * 4 + 3];

        state[i * 4] = gf_mul(0x0e, s0) ^ gf_mul(0x0b, s1) ^ gf_mul(0x0d, s2) ^ gf_mul(0x09, s3);
        state[i * 4 + 1] = gf_mul(0x09, s0) ^ gf_mul(0x0e, s1) ^ gf_mul(0x0b, s2) ^ gf_mul(0x0d, s3);
        state[i * 4 + 2] = gf_mul(0x0d, s0) ^ gf_mul(0x09, s1) ^ gf_mul(0x0e, s2) ^ gf_mul(0x0b, s3);
        state[i * 4 + 3] = gf_mul(0x0b, s0) ^ gf_mul(0x0d, s1) ^ gf_mul(0x09, s2) ^ gf_mul(0x0e, s3);

        i = i + 1;
    }
}

fn add_round_key(state: &mut [u8; 16], round_keys: &[u8; 240], round: usize) {
    let offset = round * 16;
    let mut i: usize = 0;
    while i < 16 {
        state[i] = state[i] ^ round_keys[offset + i];
        i = i + 1;
    }
}

// ============================================================
// Galois Field Multiplication
// ============================================================

fn gf_mul(a: u8, b: u8) -> u8 {
    let mut p: u8 = 0;
    let mut a = a;
    let mut b = b;

    let mut i: usize = 0;
    while i < 8 {
        if (b & 1) != 0 {
            p = p ^ a;
        }
        let hi_bit = a & 0x80;
        a = a << 1;
        if hi_bit != 0 {
            a = a ^ 0x1b;  // Reduction polynomial
        }
        b = b >> 1;
        i = i + 1;
    }

    p
}

// ============================================================
// ECB Mode (for testing - DO NOT USE in production)
// ============================================================

pub fn aes_ecb_encrypt(ctx: &AesContext, plaintext: &[u8]) -> Vec<u8> {
    let mut ciphertext = Vec::new();
    let blocks = (plaintext.len() + 15) / 16;

    let mut i: usize = 0;
    while i < blocks {
        let mut block: [u8; 16] = [0; 16];
        let start = i * 16;
        let end = if start + 16 > plaintext.len() { plaintext.len() } else { start + 16 };

        let mut j: usize = 0;
        while j < end - start {
            block[j] = plaintext[start + j];
            j = j + 1;
        }

        let encrypted = ctx.encrypt_block(&block);

        j = 0;
        while j < 16 {
            ciphertext.push(encrypted[j]);
            j = j + 1;
        }

        i = i + 1;
    }

    ciphertext
}

pub fn aes_ecb_decrypt(ctx: &AesContext, ciphertext: &[u8]) -> Vec<u8> {
    let mut plaintext = Vec::new();
    let blocks = ciphertext.len() / 16;

    let mut i: usize = 0;
    while i < blocks {
        let mut block: [u8; 16] = [0; 16];
        let mut j: usize = 0;
        while j < 16 {
            block[j] = ciphertext[i * 16 + j];
            j = j + 1;
        }

        let decrypted = ctx.decrypt_block(&block);

        j = 0;
        while j < 16 {
            plaintext.push(decrypted[j]);
            j = j + 1;
        }

        i = i + 1;
    }

    plaintext
}

// ============================================================
// CBC Mode
// ============================================================

pub fn aes_cbc_encrypt(ctx: &AesContext, iv: &[u8; 16], plaintext: &[u8]) -> Vec<u8> {
    let mut ciphertext = Vec::new();
    let mut prev_block: [u8; 16] = *iv;
    let blocks = (plaintext.len() + 15) / 16;

    let mut i: usize = 0;
    while i < blocks {
        let mut block: [u8; 16] = [0; 16];
        let start = i * 16;
        let end = if start + 16 > plaintext.len() { plaintext.len() } else { start + 16 };

        // PKCS7 padding in last block
        let pad_byte = (16 - (end - start)) as u8;
        let mut j: usize = 0;
        while j < 16 {
            if j < end - start {
                block[j] = plaintext[start + j];
            } else {
                block[j] = pad_byte;
            }
            j = j + 1;
        }

        // XOR with previous ciphertext block
        j = 0;
        while j < 16 {
            block[j] = block[j] ^ prev_block[j];
            j = j + 1;
        }

        let encrypted = ctx.encrypt_block(&block);
        prev_block = encrypted;

        j = 0;
        while j < 16 {
            ciphertext.push(encrypted[j]);
            j = j + 1;
        }

        i = i + 1;
    }

    ciphertext
}

pub fn aes_cbc_decrypt(ctx: &AesContext, iv: &[u8; 16], ciphertext: &[u8]) -> Vec<u8> {
    let mut plaintext = Vec::new();
    let mut prev_block: [u8; 16] = *iv;
    let blocks = ciphertext.len() / 16;

    let mut i: usize = 0;
    while i < blocks {
        let mut block: [u8; 16] = [0; 16];
        let mut j: usize = 0;
        while j < 16 {
            block[j] = ciphertext[i * 16 + j];
            j = j + 1;
        }

        let decrypted = ctx.decrypt_block(&block);

        // XOR with previous ciphertext block
        j = 0;
        while j < 16 {
            let pt_byte = decrypted[j] ^ prev_block[j];
            plaintext.push(pt_byte);
            j = j + 1;
        }

        prev_block = block;
        i = i + 1;
    }

    // Remove PKCS7 padding
    if plaintext.len() > 0 {
        let pad_len = plaintext[plaintext.len() - 1] as usize;
        if pad_len > 0 && pad_len <= 16 {
            let new_len = plaintext.len() - pad_len;
            plaintext.truncate(new_len);
        }
    }

    plaintext
}

// ============================================================
// CTR Mode
// ============================================================

pub fn aes_ctr_encrypt(ctx: &AesContext, nonce: &[u8; 12], plaintext: &[u8]) -> Vec<u8> {
    let mut ciphertext = Vec::new();
    let mut counter: [u8; 16] = [0; 16];

    // Initialize counter: nonce || 0x00000001
    let mut i: usize = 0;
    while i < 12 {
        counter[i] = nonce[i];
        i = i + 1;
    }
    counter[12] = 0;
    counter[13] = 0;
    counter[14] = 0;
    counter[15] = 1;

    let blocks = (plaintext.len() + 15) / 16;

    let mut block_num: usize = 0;
    while block_num < blocks {
        let keystream = ctx.encrypt_block(&counter);

        let start = block_num * 16;
        let end = if start + 16 > plaintext.len() { plaintext.len() } else { start + 16 };

        let mut j: usize = 0;
        while j < end - start {
            ciphertext.push(plaintext[start + j] ^ keystream[j]);
            j = j + 1;
        }

        // Increment counter (big-endian)
        let mut carry = true;
        let mut i: usize = 15;
        while carry && i >= 12 {
            if counter[i] == 255 {
                counter[i] = 0;
            } else {
                counter[i] = counter[i] + 1;
                carry = false;
            }
            if i == 12 {
                break;
            }
            i = i - 1;
        }

        block_num = block_num + 1;
    }

    ciphertext
}

// CTR decryption is the same as encryption
pub fn aes_ctr_decrypt(ctx: &AesContext, nonce: &[u8; 12], ciphertext: &[u8]) -> Vec<u8> {
    aes_ctr_encrypt(ctx, nonce, ciphertext)
}
