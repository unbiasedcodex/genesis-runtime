// SHA-256 Hash Implementation
// FIPS 180-4 compliant

// ============================================================
// Constants
// ============================================================

// Initial hash values (first 32 bits of fractional parts of square roots of first 8 primes)
const H0: u32 = 0x6a09e667;
const H1: u32 = 0xbb67ae85;
const H2: u32 = 0x3c6ef372;
const H3: u32 = 0xa54ff53a;
const H4: u32 = 0x510e527f;
const H5: u32 = 0x9b05688c;
const H6: u32 = 0x1f83d9ab;
const H7: u32 = 0x5be0cd19;

// Round constants (first 32 bits of fractional parts of cube roots of first 64 primes)
const K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

// ============================================================
// SHA-256 State
// ============================================================

#[repr(C)]
pub struct Sha256 {
    state: [u32; 8],      // Current hash state
    buffer: [u8; 64],     // Input buffer (512 bits)
    buffer_len: usize,    // Bytes in buffer
    total_len: u64,       // Total message length in bytes
}

impl Sha256 {
    pub fn new() -> Sha256 {
        Sha256 {
            state: [H0, H1, H2, H3, H4, H5, H6, H7],
            buffer: [0; 64],
            buffer_len: 0,
            total_len: 0,
        }
    }

    // Update hash with data
    pub fn update(&mut self, data: &[u8]) {
        let mut offset: usize = 0;
        self.total_len = self.total_len + data.len() as u64;

        // Fill buffer if partial
        if self.buffer_len > 0 {
            let need = 64 - self.buffer_len;
            let take = if data.len() < need { data.len() } else { need };

            let mut i: usize = 0;
            while i < take {
                self.buffer[self.buffer_len + i] = data[i];
                i = i + 1;
            }
            self.buffer_len = self.buffer_len + take;
            offset = take;

            if self.buffer_len == 64 {
                self.process_block();
                self.buffer_len = 0;
            }
        }

        // Process full blocks
        while offset + 64 <= data.len() {
            let mut i: usize = 0;
            while i < 64 {
                self.buffer[i] = data[offset + i];
                i = i + 1;
            }
            self.process_block();
            offset = offset + 64;
        }

        // Save remaining bytes
        let remaining = data.len() - offset;
        if remaining > 0 {
            let mut i: usize = 0;
            while i < remaining {
                self.buffer[i] = data[offset + i];
                i = i + 1;
            }
            self.buffer_len = remaining;
        }
    }

    // Finalize and return hash
    pub fn finalize(&mut self) -> [u8; 32] {
        // Pad message
        let bit_len = self.total_len * 8;

        // Append '1' bit
        self.buffer[self.buffer_len] = 0x80;
        self.buffer_len = self.buffer_len + 1;

        // If not enough room for length, process block and start new one
        if self.buffer_len > 56 {
            while self.buffer_len < 64 {
                self.buffer[self.buffer_len] = 0;
                self.buffer_len = self.buffer_len + 1;
            }
            self.process_block();
            self.buffer_len = 0;
        }

        // Pad with zeros
        while self.buffer_len < 56 {
            self.buffer[self.buffer_len] = 0;
            self.buffer_len = self.buffer_len + 1;
        }

        // Append length in bits (big-endian)
        self.buffer[56] = (bit_len >> 56) as u8;
        self.buffer[57] = (bit_len >> 48) as u8;
        self.buffer[58] = (bit_len >> 40) as u8;
        self.buffer[59] = (bit_len >> 32) as u8;
        self.buffer[60] = (bit_len >> 24) as u8;
        self.buffer[61] = (bit_len >> 16) as u8;
        self.buffer[62] = (bit_len >> 8) as u8;
        self.buffer[63] = bit_len as u8;

        self.process_block();

        // Convert state to bytes (big-endian)
        let mut hash: [u8; 32] = [0; 32];
        let mut i: usize = 0;
        while i < 8 {
            let s = self.state[i];
            hash[i * 4] = (s >> 24) as u8;
            hash[i * 4 + 1] = (s >> 16) as u8;
            hash[i * 4 + 2] = (s >> 8) as u8;
            hash[i * 4 + 3] = s as u8;
            i = i + 1;
        }

        hash
    }

    // Process a 512-bit block
    fn process_block(&mut self) {
        // Prepare message schedule
        let mut w: [u32; 64] = [0; 64];

        // First 16 words from input (big-endian)
        let mut i: usize = 0;
        while i < 16 {
            w[i] = ((self.buffer[i * 4] as u32) << 24)
                | ((self.buffer[i * 4 + 1] as u32) << 16)
                | ((self.buffer[i * 4 + 2] as u32) << 8)
                | (self.buffer[i * 4 + 3] as u32);
            i = i + 1;
        }

        // Extend to 64 words
        while i < 64 {
            let s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
            let s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
            i = i + 1;
        }

        // Initialize working variables
        let mut a = self.state[0];
        let mut b = self.state[1];
        let mut c = self.state[2];
        let mut d = self.state[3];
        let mut e = self.state[4];
        let mut f = self.state[5];
        let mut g = self.state[6];
        let mut h = self.state[7];

        // Main loop
        i = 0;
        while i < 64 {
            let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
            let ch = (e & f) ^ ((!e) & g);
            let temp1 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(K[i]).wrapping_add(w[i]);
            let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = s0.wrapping_add(maj);

            h = g;
            g = f;
            f = e;
            e = d.wrapping_add(temp1);
            d = c;
            c = b;
            b = a;
            a = temp1.wrapping_add(temp2);

            i = i + 1;
        }

        // Add to state
        self.state[0] = self.state[0].wrapping_add(a);
        self.state[1] = self.state[1].wrapping_add(b);
        self.state[2] = self.state[2].wrapping_add(c);
        self.state[3] = self.state[3].wrapping_add(d);
        self.state[4] = self.state[4].wrapping_add(e);
        self.state[5] = self.state[5].wrapping_add(f);
        self.state[6] = self.state[6].wrapping_add(g);
        self.state[7] = self.state[7].wrapping_add(h);
    }
}

// ============================================================
// Convenience Functions
// ============================================================

// Compute SHA-256 hash of data
pub fn sha256(data: &[u8]) -> [u8; 32] {
    let mut hasher = Sha256::new();
    hasher.update(data);
    hasher.finalize()
}

// Compute SHA-256 hash and return as hex string
pub fn sha256_hex(data: &[u8]) -> [u8; 64] {
    let hash = sha256(data);
    let mut hex: [u8; 64] = [0; 64];

    const HEX_CHARS: [u8; 16] = [
        b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7',
        b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
    ];

    let mut i: usize = 0;
    while i < 32 {
        hex[i * 2] = HEX_CHARS[(hash[i] >> 4) as usize];
        hex[i * 2 + 1] = HEX_CHARS[(hash[i] & 0x0F) as usize];
        i = i + 1;
    }

    hex
}

// ============================================================
// Helper Functions
// ============================================================

fn rotr32(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

// ============================================================
// SHA-384/SHA-512 (Optional Extension)
// ============================================================

// SHA-512 initial hash values
const H512_0: u64 = 0x6a09e667f3bcc908;
const H512_1: u64 = 0xbb67ae8584caa73b;
const H512_2: u64 = 0x3c6ef372fe94f82b;
const H512_3: u64 = 0xa54ff53a5f1d36f1;
const H512_4: u64 = 0x510e527fade682d1;
const H512_5: u64 = 0x9b05688c2b3e6c1f;
const H512_6: u64 = 0x1f83d9abfb41bd6b;
const H512_7: u64 = 0x5be0cd19137e2179;

// SHA-384 initial hash values
const H384_0: u64 = 0xcbbb9d5dc1059ed8;
const H384_1: u64 = 0x629a292a367cd507;
const H384_2: u64 = 0x9159015a3070dd17;
const H384_3: u64 = 0x152fecd8f70e5939;
const H384_4: u64 = 0x67332667ffc00b31;
const H384_5: u64 = 0x8eb44a8768581511;
const H384_6: u64 = 0xdb0c2e0d64f98fa7;
const H384_7: u64 = 0x47b5481dbefa4fa4;

// SHA-512 round constants
const K512: [u64; 80] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
];

#[repr(C)]
pub struct Sha512 {
    state: [u64; 8],
    buffer: [u8; 128],
    buffer_len: usize,
    total_len: u128,
    is_384: bool,
}

impl Sha512 {
    pub fn new() -> Sha512 {
        Sha512 {
            state: [H512_0, H512_1, H512_2, H512_3, H512_4, H512_5, H512_6, H512_7],
            buffer: [0; 128],
            buffer_len: 0,
            total_len: 0,
            is_384: false,
        }
    }

    pub fn new_384() -> Sha512 {
        Sha512 {
            state: [H384_0, H384_1, H384_2, H384_3, H384_4, H384_5, H384_6, H384_7],
            buffer: [0; 128],
            buffer_len: 0,
            total_len: 0,
            is_384: true,
        }
    }

    pub fn update(&mut self, data: &[u8]) {
        let mut offset: usize = 0;
        self.total_len = self.total_len + data.len() as u128;

        if self.buffer_len > 0 {
            let need = 128 - self.buffer_len;
            let take = if data.len() < need { data.len() } else { need };

            let mut i: usize = 0;
            while i < take {
                self.buffer[self.buffer_len + i] = data[i];
                i = i + 1;
            }
            self.buffer_len = self.buffer_len + take;
            offset = take;

            if self.buffer_len == 128 {
                self.process_block();
                self.buffer_len = 0;
            }
        }

        while offset + 128 <= data.len() {
            let mut i: usize = 0;
            while i < 128 {
                self.buffer[i] = data[offset + i];
                i = i + 1;
            }
            self.process_block();
            offset = offset + 128;
        }

        let remaining = data.len() - offset;
        if remaining > 0 {
            let mut i: usize = 0;
            while i < remaining {
                self.buffer[i] = data[offset + i];
                i = i + 1;
            }
            self.buffer_len = remaining;
        }
    }

    pub fn finalize(&mut self) -> [u8; 64] {
        let bit_len = self.total_len * 8;

        self.buffer[self.buffer_len] = 0x80;
        self.buffer_len = self.buffer_len + 1;

        if self.buffer_len > 112 {
            while self.buffer_len < 128 {
                self.buffer[self.buffer_len] = 0;
                self.buffer_len = self.buffer_len + 1;
            }
            self.process_block();
            self.buffer_len = 0;
        }

        while self.buffer_len < 112 {
            self.buffer[self.buffer_len] = 0;
            self.buffer_len = self.buffer_len + 1;
        }

        // Append 128-bit length
        let mut i: usize = 0;
        while i < 16 {
            self.buffer[112 + i] = (bit_len >> (120 - i * 8)) as u8;
            i = i + 1;
        }

        self.process_block();

        let mut hash: [u8; 64] = [0; 64];
        let output_len = if self.is_384 { 6 } else { 8 };

        i = 0;
        while i < output_len {
            let s = self.state[i];
            hash[i * 8] = (s >> 56) as u8;
            hash[i * 8 + 1] = (s >> 48) as u8;
            hash[i * 8 + 2] = (s >> 40) as u8;
            hash[i * 8 + 3] = (s >> 32) as u8;
            hash[i * 8 + 4] = (s >> 24) as u8;
            hash[i * 8 + 5] = (s >> 16) as u8;
            hash[i * 8 + 6] = (s >> 8) as u8;
            hash[i * 8 + 7] = s as u8;
            i = i + 1;
        }

        hash
    }

    fn process_block(&mut self) {
        let mut w: [u64; 80] = [0; 80];

        let mut i: usize = 0;
        while i < 16 {
            w[i] = ((self.buffer[i * 8] as u64) << 56)
                | ((self.buffer[i * 8 + 1] as u64) << 48)
                | ((self.buffer[i * 8 + 2] as u64) << 40)
                | ((self.buffer[i * 8 + 3] as u64) << 32)
                | ((self.buffer[i * 8 + 4] as u64) << 24)
                | ((self.buffer[i * 8 + 5] as u64) << 16)
                | ((self.buffer[i * 8 + 6] as u64) << 8)
                | (self.buffer[i * 8 + 7] as u64);
            i = i + 1;
        }

        while i < 80 {
            let s0 = rotr64(w[i - 15], 1) ^ rotr64(w[i - 15], 8) ^ (w[i - 15] >> 7);
            let s1 = rotr64(w[i - 2], 19) ^ rotr64(w[i - 2], 61) ^ (w[i - 2] >> 6);
            w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
            i = i + 1;
        }

        let mut a = self.state[0];
        let mut b = self.state[1];
        let mut c = self.state[2];
        let mut d = self.state[3];
        let mut e = self.state[4];
        let mut f = self.state[5];
        let mut g = self.state[6];
        let mut h = self.state[7];

        i = 0;
        while i < 80 {
            let s1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
            let ch = (e & f) ^ ((!e) & g);
            let temp1 = h.wrapping_add(s1).wrapping_add(ch).wrapping_add(K512[i]).wrapping_add(w[i]);
            let s0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = s0.wrapping_add(maj);

            h = g;
            g = f;
            f = e;
            e = d.wrapping_add(temp1);
            d = c;
            c = b;
            b = a;
            a = temp1.wrapping_add(temp2);

            i = i + 1;
        }

        self.state[0] = self.state[0].wrapping_add(a);
        self.state[1] = self.state[1].wrapping_add(b);
        self.state[2] = self.state[2].wrapping_add(c);
        self.state[3] = self.state[3].wrapping_add(d);
        self.state[4] = self.state[4].wrapping_add(e);
        self.state[5] = self.state[5].wrapping_add(f);
        self.state[6] = self.state[6].wrapping_add(g);
        self.state[7] = self.state[7].wrapping_add(h);
    }
}

fn rotr64(x: u64, n: u32) -> u64 {
    (x >> n) | (x << (64 - n))
}

pub fn sha512(data: &[u8]) -> [u8; 64] {
    let mut hasher = Sha512::new();
    hasher.update(data);
    hasher.finalize()
}

pub fn sha384(data: &[u8]) -> [u8; 48] {
    let mut hasher = Sha512::new_384();
    hasher.update(data);
    let full = hasher.finalize();

    let mut result: [u8; 48] = [0; 48];
    let mut i: usize = 0;
    while i < 48 {
        result[i] = full[i];
        i = i + 1;
    }
    result
}
