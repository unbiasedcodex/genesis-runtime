// Print "[init] Restarting service X (attempt N)"
fn print_restart_msg(idx: i64, attempt: i64) {
    print_init_prefix();
    runtime::print_char(82);  // R
    runtime::print_char(101); // e
    runtime::print_char(115); // s
    runtime::print_char(116); // t
    runtime::print_char(97);  // a
    runtime::print_char(114); // r
    runtime::print_char(116); // t
    runtime::print_char(105); // i
    runtime::print_char(110); // n
    runtime::print_char(103); // g
    runtime::print_char(32);  // space
    runtime::print_char(115); // s
    runtime::print_char(101); // e
    runtime::print_char(114); // r
    runtime::print_char(118); // v
    runtime::print_char(105); // i
    runtime::print_char(99);  // c
    runtime::print_char(101); // e
    runtime::print_char(32);  // space
    runtime::print_num(idx);
    runtime::print_char(32);  // space
    runtime::print_char(40);  // (
    runtime::print_char(97);  // a
    runtime::print_char(116); // t
    runtime::print_char(116); // t
    runtime::print_char(101); // e
    runtime::print_char(109); // m
    runtime::print_char(112); // p
    runtime::print_char(116); // t
    runtime::print_char(32);  // space
    runtime::print_num(attempt);
    runtime::print_char(41);  // )
    newline();
}

// Print "[init] Service X failed permanently"
fn print_failed_msg(idx: i64) {
    print_init_prefix();
    runtime::print_char(83);  // S
    runtime::print_char(101); // e
    runtime::print_char(114); // r
    runtime::print_char(118); // v
    runtime::print_char(105); // i
    runtime::print_char(99);  // c
    runtime::print_char(101); // e
    runtime::print_char(32);  // space
    runtime::print_num(idx);
    runtime::print_char(32);  // space
    runtime::print_char(102); // f
    runtime::print_char(97);  // a
    runtime::print_char(105); // i
    runtime::print_char(108); // l
    runtime::print_char(101); // e
    runtime::print_char(100); // d
    runtime::print_char(32);  // space
