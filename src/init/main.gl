    runtime::print_char(108); // l
    runtime::print_char(121); // y
    newline();
}

// ============================================================================
// Main Entry Point
// ============================================================================

fn main() {
    print_banner();

    let my_pid = runtime::getpid();
    print_started_msg();
    runtime::print_num(my_pid);
    newline();

    init_service_table();
    print_table_init();

    print_loop_msg();

    let mut health_check_counter: i64 = 0;

    loop {
        let sender = runtime::recv(MSG_BUFFER);
        if sender > 0 {
            process_message(sender);
        }

        let child = runtime::wait();
        if child > 0 {
            handle_child_exit(child);
        }

        // Periodic health check: reset restart counters for stable services
        health_check_counter = health_check_counter + 1;
        if health_check_counter >= 100 {
            health_check_counter = 0;
            let mut i: i64 = 0;
            while i < MAX_SERVICES {
                reset_restart_count(i);
                i = i + 1;
            }
        }

        runtime::yield_cpu();
    }
}
