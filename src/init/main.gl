    runtime::print_char(73);  // I
    runtime::print_char(110); // n
    runtime::print_char(105); // i
    runtime::print_char(116); // t
    runtime::print_char(32);  // space
    runtime::print_char(83);  // S
    runtime::print_char(121); // y
    runtime::print_char(115); // s
    runtime::print_char(116); // t
    runtime::print_char(101); // e
    runtime::print_char(109); // m
    newline();
    // "  Version 0.1.0"
    runtime::print_char(32);
    runtime::print_char(32);
    runtime::print_char(86);  // V
    runtime::print_char(101); // e
    runtime::print_char(114); // r
    runtime::print_char(115); // s
    runtime::print_char(105); // i
    runtime::print_char(111); // o
    runtime::print_char(110); // n
    runtime::print_char(32);  // space
    runtime::print_char(48);  // 0
    runtime::print_char(46);  // .
    runtime::print_char(49);  // 1
    runtime::print_char(46);  // .
    runtime::print_char(48);  // 0
    newline();
    print_line();
    newline();
}

