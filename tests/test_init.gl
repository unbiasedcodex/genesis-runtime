// Test Summary
// ============================================================================

fn print_summary() {
    runtime::print_char(10);  // newline
    runtime::print_char(61);  // =
    runtime::print_char(61);
    runtime::print_char(61);
    runtime::print_char(32);  // space
    runtime::print_char(82);  // R
    runtime::print_char(101); // e
    runtime::print_char(115); // s
    runtime::print_char(117); // u
    runtime::print_char(108); // l
    runtime::print_char(116); // t
    runtime::print_char(115); // s
    runtime::print_char(32);  // space
    runtime::print_char(61);
    runtime::print_char(61);
    runtime::print_char(61);
    runtime::print_char(10);  // newline

    runtime::print_char(80);  // P
    runtime::print_char(97);  // a
    runtime::print_char(115); // s
    runtime::print_char(115); // s
    runtime::print_char(101); // e
    runtime::print_char(100); // d
    runtime::print_char(58);  // :
    runtime::print_char(32);  // space
    runtime::print_num(runtime::read_u64(TEST_PASS_COUNT));
    runtime::print_char(10);  // newline

    runtime::print_char(70);  // F
    runtime::print_char(97);  // a
    runtime::print_char(105); // i
    runtime::print_char(108); // l
    runtime::print_char(101); // e
    runtime::print_char(100); // d
    runtime::print_char(58);  // :
    runtime::print_char(32);  // space
    runtime::print_num(runtime::read_u64(TEST_FAIL_COUNT));
    runtime::print_char(10);  // newline
}

// ============================================================================
// Main Entry Point
// ============================================================================

fn main() {
    // Initialize test counters
    runtime::write_u64(TEST_PASS_COUNT, 0);
    runtime::write_u64(TEST_FAIL_COUNT, 0);

    // Print header
    runtime::print_char(10);
    runtime::print_char(71);  // G
    runtime::print_char(101); // e
    runtime::print_char(110); // n
    runtime::print_char(101); // e
    runtime::print_char(115); // s
    runtime::print_char(105); // i
    runtime::print_char(115); // s
    runtime::print_char(32);  // space
    runtime::print_char(73);  // I
    runtime::print_char(110); // n
    runtime::print_char(105); // i
    runtime::print_char(116); // t
    runtime::print_char(32);  // space
    runtime::print_char(84);  // T
    runtime::print_char(101); // e
    runtime::print_char(115); // s
    runtime::print_char(116); // t
    runtime::print_char(115); // s
    runtime::print_char(10);  // newline
    runtime::print_char(10);

    // Setup test strings
    setup_test_strings();

    // Run tests
    test_init_table();
    test_find_free_slot();
    test_find_by_pid();
    test_state_transitions();
    test_critical_flag();
    test_restart_count();
    test_max_services();

    // Print summary
    print_summary();

    runtime::exit();
}
