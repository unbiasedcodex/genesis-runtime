    // "max_services"
    runtime::write_byte(STR_MAX_SERVICES, 109);      // m
    runtime::write_byte(STR_MAX_SERVICES + 1, 97);   // a
    runtime::write_byte(STR_MAX_SERVICES + 2, 120);  // x
    runtime::write_byte(STR_MAX_SERVICES + 3, 95);   // _
    runtime::write_byte(STR_MAX_SERVICES + 4, 115);  // s
    runtime::write_byte(STR_MAX_SERVICES + 5, 101);  // e
    runtime::write_byte(STR_MAX_SERVICES + 6, 114);  // r
