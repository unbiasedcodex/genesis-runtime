// Test 1: Service table initialization
fn test_init_table() {
    print_test_name(STR_INIT_TABLE);

    init_test_table();

    // All services should be stopped with PID 0
    let mut passed: i64 = 1;
    let mut i: i64 = 0;
    while i < MAX_SERVICES {
        if test_get_state(i) != SVC_STATE_STOPPED {
            passed = 0;
        }
        if test_get_pid(i) != 0 {
            passed = 0;
        }
        i = i + 1;
    }

    if passed == 1 {
        print_pass();
    } else {
        print_fail();
    }
}

// Test 2: Find free slot
fn test_find_free_slot() {
    print_test_name(STR_FIND_SLOT);

    init_test_table();

    // Should find slot 0
    let slot1 = find_free_test_slot();

    // Mark slot 0 as used
    test_set_pid(0, 100);
    test_set_state(0, SVC_STATE_RUNNING);

    // Should find slot 1
    let slot2 = find_free_test_slot();

    if slot1 == 0 {
        if slot2 == 1 {
            print_pass();
            return;
        }
    }
    print_fail();
}

// Test 3: Find service by PID
fn test_find_by_pid() {
    print_test_name(STR_FIND_PID);

    init_test_table();

    // Add services with different PIDs
    test_set_pid(2, 200);
    test_set_pid(5, 500);
    test_set_pid(10, 1000);

    let idx1 = find_test_service_by_pid(200);
    let idx2 = find_test_service_by_pid(500);
    let idx3 = find_test_service_by_pid(1000);
    let idx4 = find_test_service_by_pid(999);  // Not found

    if idx1 == 2 {
        if idx2 == 5 {
            if idx3 == 10 {
                if idx4 == (0 - 1) {
                    print_pass();
                    return;
                }
            }
        }
    }
    print_fail();
}

// Test 4: State transitions
fn test_state_transitions() {
    print_test_name(STR_STATE_TRANS);

    init_test_table();

    // Test state transition: STOPPED -> STARTING -> RUNNING
    test_set_state(0, SVC_STATE_STOPPED);
    let s1 = test_get_state(0);

    test_set_state(0, SVC_STATE_STARTING);
    let s2 = test_get_state(0);

    test_set_state(0, SVC_STATE_RUNNING);
    let s3 = test_get_state(0);

    test_set_state(0, SVC_STATE_FAILED);
    let s4 = test_get_state(0);

    if s1 == SVC_STATE_STOPPED {
        if s2 == SVC_STATE_STARTING {
            if s3 == SVC_STATE_RUNNING {
                if s4 == SVC_STATE_FAILED {
                    print_pass();
                    return;
                }
            }
        }
    }
    print_fail();
}

// Bitwise helper functions
fn bit_and(a: i64, b: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "andq %rsi, %rax",
            in("rax") a,
            in("rsi") b,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

fn bit_or(a: i64, b: i64) -> i64 {
    let mut result: i64 = 0;
    unsafe {
        asm!(
            "orq %rsi, %rax",
            in("rax") a,
            in("rsi") b,
            lateout("rax") result,
            options(nostack, att_syntax)
        );
    }
    result
}

// Test 5: Critical flag handling
fn test_critical_flag() {
    print_test_name(STR_CRITICAL_FLAG);

    init_test_table();

    test_set_flags(0, SVC_FLAG_CRITICAL);
    test_set_flags(1, SVC_FLAG_AUTOSTART);
    test_set_flags(2, bit_or(SVC_FLAG_CRITICAL, SVC_FLAG_AUTOSTART));

    let f0 = test_get_flags(0);
    let f1 = test_get_flags(1);
    let f2 = test_get_flags(2);

    let is_critical_0 = bit_and(f0, SVC_FLAG_CRITICAL);
    let is_critical_1 = bit_and(f1, SVC_FLAG_CRITICAL);
    let is_critical_2 = bit_and(f2, SVC_FLAG_CRITICAL);

    if is_critical_0 != 0 {
        if is_critical_1 == 0 {
            if is_critical_2 != 0 {
                print_pass();
                return;
            }
        }
    }
    print_fail();
}

// Test 6: Restart count tracking
fn test_restart_count() {
    print_test_name(STR_RESTART_COUNT);

    init_test_table();

    test_set_restart_count(0, 0);
    let c1 = test_get_restart_count(0);

    test_set_restart_count(0, 3);
    let c2 = test_get_restart_count(0);

    test_set_restart_count(0, 5);
    let c3 = test_get_restart_count(0);

    if c1 == 0 {
        if c2 == 3 {
            if c3 == 5 {
                print_pass();
                return;
            }
        }
    }
    print_fail();
}

// Test 7: Max services boundary
fn test_max_services() {
    print_test_name(STR_MAX_SERVICES);

    init_test_table();

    // Fill all slots
    let mut i: i64 = 0;
    while i < MAX_SERVICES {
        test_set_pid(i, 100 + i);
        test_set_state(i, SVC_STATE_RUNNING);
        i = i + 1;
    }

    // Should return -1 (no free slots)
    let slot = find_free_test_slot();

    if slot == (0 - 1) {
        print_pass();
    } else {
        print_fail();
    }
}

